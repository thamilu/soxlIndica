alertcondition(buySignal and not inLong[1], title="🟢 BUY Signal",
     message="🟢 BUY — {{ticker}} @ {{close}}")
alertcondition(sellSignal and not inShort[1], title="🔴 SELL Short Signal",
     message="🔴 SELL SHORT — {{ticker}} @ {{close}}")
alertcondition(longFullExit or shortFullExit, title="⚡ Trade Exit",
     message="⚡ EXIT — {{ticker}} @ {{close}}")
alertcondition(bullSweep, title="⚡ Bull Sweep",
     message="⚡ Bullish Liquidity Sweep — {{ticker}} @ {{close}}")
alertcondition(bullBOS, title="📈 Bull BOS",
     message="📈 Bullish BOS — {{ticker}} @ {{close}}")
alertcondition(bullCHoCH, title="🔄 Bull CHoCH",
     message="🔄 Change of Character (Bull) — {{ticker}} @ {{close}}")
alertcondition(bearSweep, title="⚡ Bear Sweep",
     message="⚡ Bearish Liquidity Sweep — {{ticker}} @ {{close}}")
alertcondition(bearBOS, title="📉 Bear BOS",
     message="📉 Bearish BOS — {{ticker}} @ {{close}}")
