// ─── Indicators ───
grp3 = "③ Indicators"
i_emaFast   = input.int(9,   "EMA Fast",         group=grp3)
i_emaMid    = input.int(21,  "EMA Mid",          group=grp3)
i_emaSlow   = input.int(50,  "EMA Slow",         group=grp3)
i_ema200    = input.int(200, "EMA 200",          group=grp3)
i_rsiLen    = input.int(14,  "RSI Length",       group=grp3)
i_adxLen    = input.int(14,  "ADX Length",       group=grp3)
i_volLen    = input.int(20,  "Volume MA Length", group=grp3)
i_vpBins    = input.int(20,  "VP Bins",          group=grp3, minval=10, maxval=50)
i_leverage  = input.float(3.0, "Asset Leverage Factor", group=grp3, tooltip="Set to 3.0 for SOXL/TQQQ, 1.0 for SPY/NVDA, and -3.0 for inverse ETFs.")
i_expenseRatio = input.float(0.88, "Annual Expense Ratio %", group=grp3, minval=0.0, step=0.01, tooltip="Fund's net annual expense ratio (SOXL is approximately 0.88% as of this writing — verify against Direxion's current fact sheet, expense ratios change). Set to 0.0 for unleveraged/non-fee-bearing instruments. Applied as a constant daily drag alongside the volatility-decay term.")
i_macroWeight = input.float(10.0, "Macro Regime Weight %", group=grp3, minval=0.0, maxval=50.0, step=1.0, tooltip="Weight of Yield and DXY trends in the forecast blend.")
i_sigmoidK  = input.float(4.0, "Sigmoid Steepness (k)", group=grp3, minval=1.0, maxval=10.0, step=0.5, tooltip="Steepness of the probability calibration S-curve.")

// ─── Economic Events & Earnings ───
grpEvents = "⏰ Event Calendar & Earnings"
i_eventFOMC     = input.bool(false, "FOMC Decision Day", group=grpEvents, tooltip="Widens confidence bands and reduces model conviction for interest rate decision volatility.")
i_eventCPI      = input.bool(false, "CPI / PPI Release Day", group=grpEvents, tooltip="Widens confidence bands for inflation data release volatility.")
i_eventEarnings = input.bool(false, "Major Earnings Day (NVDA/AVGO)", group=grpEvents, tooltip="Widens sector confidence bands to reflect semiconductor earnings risk.")
// P1: NYSE/Nasdaq full-closure holidays. Pine has no built-in exchange holiday calendar, and unlike an
// economic-event calendar (FOMC/CPI dates, which need a live external data feed this script has no access
// to), a holiday list is a small, fixed, annually-known set of dates — genuinely maintainable as a manual
// input, unlike fabricating live event data. No spaces around the commas. Only covers TODAY (timenow) for
// the dashboard's live session/CLOSED display — it does not retroactively reshape ORB/volume-profile/session
// math for past bars (SOXL's own data feed simply has no bars on an actual holiday, so that's moot), and it
// does NOT make forward multi-day date-rolling (e.g. "next session opens Tuesday") holiday-aware — that
// would need holiday-aware day-counting threaded through f_getSessDateStr's date arithmetic too, a larger,
// separate change not made here. Defaults are 2026 US market holidays; verify against the current NYSE
// calendar and update annually.
i_holidayDates = input.string("2026-01-01,2026-01-19,2026-02-16,2026-04-03,2026-05-25,2026-06-19,2026-07-03,2026-09-07,2026-11-26,2026-12-25", "NYSE Holidays (YYYY-MM-DD, no spaces)", group=grpEvents, tooltip="Full-closure NYSE/Nasdaq holidays, comma-separated YYYY-MM-DD, no spaces. Update annually.")

// ─── Smart Money Concepts ───
grp5 = "④ Smart Money Concepts"
i_obMax  = input.int(6, "Max Order Blocks", group=grp5, minval=2, maxval=15)
i_fvgMax = input.int(6, "Max FVGs",         group=grp5, minval=2, maxval=15)

// ─── Kill Zones & Opening Range ───
grp6 = "⑤ Kill Zones & Opening Range"
i_useKZ   = input.bool(true, "Restrict to Kill Zones", group=grp6)
i_kzNY    = input.session("0930-1100:1234567", "NY Open KZ",      group=grp6)
i_kzPM    = input.session("1400-1600:1234567", "NY PM Power Hour", group=grp6)
i_showORB = input.bool(true, "Show Opening Range (ORB)", group=grp6, tooltip="Plots the 15m or 30m Market Opening Min/Max range levels.")
i_orbLen  = input.string("15m", "Opening Range Duration", group=grp6, options=["15m", "30m"], tooltip="Select 15m (9:30-9:45 AM ET) or 30m (9:30-10:00 AM ET) opening window.")

// ─── Risk & Exits ───
grp7 = "⑥ Risk & Exits"
i_atrLen     = input.int(14, "ATR Length",          group=grp7)
i_acctSize   = input.float(10000.0, "Account ($)",  group=grp7, step=500)
i_riskPct    = input.float(1.0, "Risk %",           group=grp7, step=0.1, minval=0.1, maxval=10.0)
i_tp1R       = input.float(1.5, "TP1 R-Multiple (50%)", group=grp7, step=0.1)
i_tp2R       = input.float(3.0, "TP2 R-Multiple (30%)", group=grp7, step=0.1)
i_tp3R       = input.float(5.0, "TP3 R-Multiple (20%)", group=grp7, step=0.1)
i_trailMult  = input.float(1.5, "Trail ATR Mult",       group=grp7, step=0.1)
i_targetVol  = input.float(12.0, "Annualized Vol Target %", group=grp7, step=0.5, tooltip="Constant annual volatility target for sizing positions.")
i_kellyFract = input.float(0.25, "Kelly Fraction", group=grp7, step=0.05, tooltip="Fractional Kelly sizing coefficient.")
i_kellyMinTrades = input.int(30, "Kelly Full-Confidence Trade Count", group=grp7, minval=5, tooltip="Kelly is highly sensitive to estimation error from small samples. Below this many recorded trades, sizing blends toward the volatility-target size instead of trusting Kelly's win-rate/win-loss-ratio estimate at full strength; at/above it, Kelly gets full weight.")
// P1: was default 150.0 with no maxval, but posSize is separately hard-clamped to floor(simEquity/close) —
// literal cash-on-hand share count — a few lines after this setting is applied, so nothing above 100% was
// ever actually reachable; the 150% default just misrepresented what the sizing engine would really do.
// Capped at 100 here so the input can only ever TIGHTEN exposure below full cash notional, never imply
// margin/leverage beyond it — matching the deliberate choice to keep position sizing cash-secured (100%
// notional of a 3x product already means 300% underlying exposure; no margin on top of that).
i_maxGrossExposurePct = input.float(100.0, "Max Gross Exposure %", group=grp7, minval=10.0, maxval=100.0, step=10.0, tooltip="Cap on position notional as a % of account equity (cash-secured — sizing can never exceed 100% regardless of this setting, since a separate hard clamp limits shares to what current equity can actually buy). Lower this below 100 to intentionally under-invest; it cannot be raised above 100 to add margin/leverage beyond SOXL's own built-in 3x.")
i_dailyLossLim = input.float(2.0, "Daily Loss Limit %", group=grp7, step=0.1, tooltip="Daily drawdown cap. Stops new trades if exceeded.")
i_slippageBps = input.float(5.0, "Slippage per side (BPS)", group=grp7, minval=0.0, step=0.5, tooltip="Execution slippage in basis points per side (5 bps = 0.05% of price).")
i_commissionPerShare = input.float(0.005, "Commission per share ($)", group=grp7, minval=0.0, step=0.001, tooltip="Broker commission per share ($0.005 is standard for interactive brokers).")
i_allowShort = input.bool(false, "Allow Shorts", group=grp7,
     tooltip="Auto-enabled for futures/crypto/forex. Keep OFF for leveraged ETFs like SOXL/TQQQ.")
i_maxHoldBars = input.int(0, "Max Holding Period (bars, 0=off)", group=grp7, minval=0,
     tooltip="Forces a trade closed after this many bars regardless of SL/TP/CHoCH — a real, capital-at-risk trade shouldn't be able to stay open indefinitely just because price never reaches either exit level. 0 disables this cap. Timeframe-relative — 100 on a 5m chart is ~8.3 hours, on a 1H chart is over 4 trading days; size it to how long you actually intend to hold.")
i_maxConsecLosses = input.int(0, "Max Consecutive Losses (0=off)", group=grp7, minval=0,
     tooltip="Pauses new entries for i_lossCooldownBars once this many losing trades in a row have closed — a losing streak often means current conditions don't match what the model was validated on. 0 disables this circuit breaker.")
i_lossCooldownBars = input.int(20, "Loss Streak Cooldown (bars)", group=grp7, minval=1,
     tooltip="How many bars new entries stay paused after i_maxConsecLosses trips. Only relevant if i_maxConsecLosses > 0.")

// ─── Session Alignment (Forecast-Layer Confirmation) ───
grpAlign = "🎯 Session Alignment"
i_useSessionAlign = input.bool(false, "Use Session Alignment Confirmation", group=grpAlign,
     tooltip="When ON, requires the Current-Regular and Next-Regular session forecasts to agree on direction (beyond an ATR-scaled noise floor) before allowing a BUY/SELL signal — an ADDITIONAL confirmation gate layered on top of the existing trade-eligibility engine (trend/score/R:R/timing/execution quality), never a replacement for it. If the two Regular-session forecasts disagree (one bullish, one bearish), new entries pause regardless of what the eligibility engine says. Defaults OFF so existing signal behavior is completely unchanged unless explicitly enabled and tested independently.")


// ════════════════════════════════════════════════════════════════════════
// §2  UTILITY FUNCTIONS & DISPLAY FLAGS
// ════════════════════════════════════════════════════════════════════════

bool confirmed = barstate.isconfirmed

// ─── Instrument Auto-Detection ───
bool isFutures = syminfo.type == "futures"
bool isCrypto  = syminfo.type == "crypto"
bool isForex   = syminfo.type == "forex"
bool canShort  = i_allowShort or isFutures or isCrypto or isForex

// ─── Display Mode Flags ───
bool isBeginner     = i_displayMode == "Beginner"
bool isExpert       = i_displayMode == "Expert"

bool showEmas    = isExpert and i_chartMode == "Research"
bool showVwap    = i_chartMode != "Minimal"
bool showProfile = isExpert and i_chartMode == "Research"
bool showPrevDay = not isBeginner and i_chartMode == "Research"
bool showEquil   = isExpert and i_chartMode == "Research"

// P1: shared mobile-safe table column width/alignment for the §12 dashboard. Declared globally (not
// locally inside the dashboard block) so the two dashboard-row helper functions declared before §12
// (f_renderForecastRow, f_renderSessionOutlookRows) can reference the exact same values as the main
// dashboard body — Pine requires globals to be declared before any function that reads them, and both
// helpers sit earlier in the file than §12 itself. table.cell's width is 0-100 (percent of the chart
// pane, NOT a 0-1 fraction — see §12's table-build comment for the concrete bug that came from getting
// this scale wrong), and its default text_halign is CENTER, which clips overflowing text from BOTH ends
// once a cell's content exceeds its column width (confirmed live on the TradingView mobile app, which —
// unlike desktop web — does not wrap long cell text). On Mobile View, every dashboard cell is capped to a
// two-column split and forced left-aligned, so an oversized string only ever clips its tail, never its
// start. Desktop (i_mobileView off) keeps the original auto-width/center-aligned behavior untouched.
// P1 (2026-08-14): col1 was widened from 64 to 97 and col0 narrowed from 34 to 2 — real-device testing
// showed that once mobile's cell text was made desktop-length (full detail, not the old abbreviated
// mobile-only strings), the label column (col0) got pushed off the LEFT edge of the screen entirely on a
// real phone, and the longest rows even clipped the START of col1's own text. That's a stronger failure
// mode than the tail-only clipping this comment used to describe — the whole ROW, not just one cell,
// exceeded the visible width once content got long enough. f_dashCell (below) now merges label+value into
// ONE cell (col1) for mobile instead of two columns — the label is the first characters of that cell's
// text, so it survives even when the row's tail still gets clipped — and col0 shrinks to a near-zero
// sliver (kept, not removed, so its bgcolor still paints correctly) since it no longer holds any text.
float  g_dashColW1  = i_mobileView ? 2.0 : 0.0
float  g_dashColW2  = i_mobileView ? 97.0 : 0.0
string g_dashHalign = i_mobileView ? text.align_left : text.align_center

// ─── Mobile-Safe Row Helper ───
// Desktop keeps the original two-column [label | value] layout unchanged. On mobile, this merges label
// and value into col1 alone ("Label: value") — see the g_dashColW1/2 comment above for why. bgcolor and
// text_size are shared between both cells at every real call site in this file, so this takes one of each
// rather than a col0/col1 pair.
f_dashCell(table tbl, int row, string label, string value, color labelClr, color valueClr, color bg, string sz) =>
    if i_mobileView
        table.cell(tbl, 0, row, "", bgcolor=bg, text_size=sz, width=g_dashColW1, text_halign=g_dashHalign)
        table.cell(tbl, 1, row, label + ": " + value, text_color=valueClr, bgcolor=bg, text_size=sz, width=g_dashColW2, text_halign=g_dashHalign)
    else
        table.cell(tbl, 0, row, label, text_color=labelClr, bgcolor=bg, text_size=sz, width=g_dashColW1, text_halign=g_dashHalign)
        table.cell(tbl, 1, row, value, text_color=valueClr, bgcolor=bg, text_size=sz, width=g_dashColW2, text_halign=g_dashHalign)

// --- Constants ---
const int C_PERCENTILE_LEN = 500
// Shared 5%-per-bar EWMA learning rate for the adaptive evidence factor trackers (L_index/L_basket/L_qqq/
// L_macro/L_mom) and the directional/next-day rolling hit-rate trackers — same decay speed by design.
const float C_EWMA_A     = 0.05
// Shared asymmetric skew coefficient for the model volatility bands (Pre/Reg/Post/Ovn/NextDay bounds).
// P1-21: NOT a formal statistical confidence interval — see the bounds computation sites for why.
const float C_SKEW_COEF  = 0.35

// --- Dynamic Percentile Helper ---
f_percentileThresh(float s, float p, float fallback) =>
    nz(ta.percentile_nearest_rank(s, C_PERCENTILE_LEN, p), fallback)

// --- Dynamic Percentile Grading Thresholds (declared globally) ---
var float compP90       = 90.0
var float compP75       = 75.0
var float compP60       = 60.0
var float compP45       = 45.0

// ─── Grade from Score ───
// P0: parameterized on the percentile thresholds themselves (rather than hardcoding compP90/75/60/45)
// so this one function also serves bearConf's grading (bearP90/75/60/45) — replaces the separate,
// structurally-identical f_gradeBear that only differed in which threshold variables it read.
f_grade(float sc, float p90, float p75, float p60, float p45) =>
    sc >= p90 ? "A+" : sc >= p75 ? "A" : sc >= p60 ? "B" : sc >= p45 ? "C" : "—"

// P0: f_gradeOb/f_gradeFvg/f_gradeClr (OB/FVG letter grading) removed — they were computed (bull OB detect's
// `gr`, bull FVG detect's `fGr`) and immediately discarded, never read again, and f_gradeClr had no call
// site at all. obP90/obP75/obP60/obP45/fvgP90/fvgP75/fvgP60/fvgP45 (the percentile thresholds that only fed
// these grades) and globalObScore/globalFvgScore (the scores that only fed those percentiles) are removed
// with them — none had any other consumer. The OB/FVG score actually used for signal/dashboard purposes is
// f_obScore (unrelated, still very much alive — feeds obScores/nearBullOB/bestOBscore).

// P2-4: maps a grade string to its empirical-tracking bucket index (0=A+, 1=A, 2=B, 3=C); -1 for "—"/unknown.
f_gradeIdx(string g) =>
    g == "A+" ? 0 : g == "A" ? 1 : g == "B" ? 2 : g == "C" ? 3 : -1


// ─── Rolling Performance Feedback Loop Arrays (Expectancy Weights) ───
var array<float> histTrendVal = array.new<float>(i_rollWin, 0.5)
var array<float> histLiqVal   = array.new<float>(i_rollWin, 0.5)
var array<float> histMomVal   = array.new<float>(i_rollWin, 0.5)
var array<float> histRsVal    = array.new<float>(i_rollWin, 0.5)
var array<float> histVolVal   = array.new<float>(i_rollWin, 0.5)
var array<float> histOutcome  = array.new<float>(i_rollWin, 0.0) // R-multiple outcomes
var array<float> histProb     = array.new<float>(i_rollWin, 50.0) // Entry calibrated probabilities
var array<int>   histBars     = array.new<int>(i_rollWin, 0)     // bar_index for signal aging
var array<int>   histBarsHeld = array.new<int>(i_rollWin, 0)     // bars held for THIS trade (not lifetime total)
var int histIdx = 0
var float liveAvgRR = 0.0  // Updated after trade exits, read by Kelly sizing
var float openTradeProb = 50.0 // Calibrated probability stored at trade entry

// Performance tracking
var int   totalTrades   = 0, var int   wins      = 0, var int losses = 0
var float grossWin      = 0.0, var float grossLoss = 0.0
// P0: consecutiveLosses/lossCooldownUntilBar back a circuit breaker — see their update site (right after
// wins/losses tally in §10's Exit block) and the buySignal/sellSignal read site for the full mechanism.
var int   consecutiveLosses    = 0
var int   lossCooldownUntilBar = na
var float rollPF        = 0.0
var float rollExpectancy = 0.0, var float rollSharpe = 0.0, var float rollSortino = 0.0, var float rollBrier = 0.25, var float rollProbMAE = 0.0
var int   tp1Hits       = 0, var int   tp2Hits     = 0, var int tp3Hits = 0
// P1-29: rollSharpe/rollSortino/rollCalmar (declared with rollCalmar further below) are R-MULTIPLE-based
// proxies (f_calcRollingSharpe/Sortino/Calmar operate on histOutcome, a series of R-multiples per trade),
// NOT standard institutional statistics — a real Sharpe/Sortino needs a properly time-indexed portfolio
// return series (not one point per trade regardless of how long each was held), and a real Calmar needs
// CAGR / max drawdown in $ terms, not cumulative-R / max-drawdown-in-R. If these are ever surfaced on the
// dashboard, label them "R-Sharpe" / "R-Sortino" / "R-Calmar Proxy" — never the unqualified standard names.
// Currently NOT displayed anywhere in the dashboard, so no user-facing mislabeling exists today; this note
// exists so that stays true if someone adds a row for them later.
// eodMAE/eodWinRate/eodCount/eodBrier are OUT-OF-SAMPLE RETURN-FORECAST calibration metrics (next-day
// forecast vs realized next-day close), fully separate from rollBrier/rollWinRate above (which score TRADE
// entry/exit outcomes) — declared here, this early, purely so f_calcConf (§9b) can reference eodBrier/
// eodCount without a forward-reference error; they're actually UPDATED much later, in the EOD validation
// block right after the sequential session forecast chain, where regSessJustClosed/frozenNextDay live.
var float eodMAE = na
var float eodWinRate = 50.0
var float eodCount = 0.0
// P0-4: shortHorizonBrier/shortBrierCount are a SECOND, genuinely separate calibration history — built
// from the bar-time-anchored 1-bar-ahead forecast (spx_30m_bar), not a copy of eodBrier — so f_calcConf
// (§9b) can interpolate between a real short-horizon calibration score and the real next-day one instead
// of reusing eodBrier for every horizon from 30m to next-day alike. Declared here for the same
// forward-reference reason as eodBrier; actually updated in §9 right after directionalWinRate.
var float shortHorizonBrier = 0.25
var float shortBrierCount = 0.0
var float eodBrier = 0.25
// P0: online Platt (logistic) calibration parameters — a,b in P_calibrated = sigmoid(a*x + b), where x is
// the raw (pre-calibration) model score. Fit via online gradient descent at two genuinely out-of-sample
// resolution points in §9/§9b (the 1-bar-ahead check and the next-day check), not a batch fit — see
// f_retToProb's comment for why this exists and how it's used. Declared here for the same forward-reference
// reason as eodBrier; actually updated at the two resolution sites.
var float plattA = 1.0
var float plattB = 0.0
var float plattN = 0.0
// P0: EWMA-tracked average DAILY tracking residual (actual SOXL daily return minus what the mechanical 3x
// model — i_leverage*indexDailyRetRaw net of expense drag — would have predicted for that same day), so the
// synthetic-NAV validator (§9) becomes an input to the forecast, not diagnostic-only. Declared here for the
// same forward-reference reason as eodBrier/plattA (expectedSOXLReturn, which consumes this, is defined
// earlier in the file than the synthetic-NAV block where this is actually updated); see that block for the
// update logic and expectedSOXLReturn for how it's consumed.
var float avgDailyTrackingResidual = 0.0
var float trackingResidualN = 0.0

// ─── Fix 7: Separate Empirical Calibration Bins for Long vs Short Trades ───
var array<float> calBinWinsLong   = array.new<float>(5, 0.0)
var array<float> calBinTotalLong  = array.new<float>(5, 0.0)
var array<float> calBinEmpPLong   = array.new<float>(5, 50.0)

var array<float> calBinWinsShort  = array.new<float>(5, 0.0)
var array<float> calBinTotalShort = array.new<float>(5, 0.0)
var array<float> calBinEmpPShort  = array.new<float>(5, 50.0)

// P0: the old 5-bucket Laplace-smoothed return-forecast calibration tables (calBinRetWinsLong/TotalLong/
// EmpPLong/WinsShort/TotalShort/EmpPShort) were removed here — f_retToProb/f_retProbEmpWeight now calibrate
// via the online Platt fit (plattA/plattB/plattN, declared near eodBrier above) instead of a bucket lookup.
// See f_retToProb's comment for why, and the two resolution sites (§9's shortHorizonBrier update and §9b's
// regSessJustClosed block) for where plattA/plattB actually get their online gradient-descent updates.

// P2-4/P1: Empirical validation BY SETUP GRADE (A+/A/B/C), indexed via f_gradeIdx — see the update site in
// §10 (right after the "Record data into rolling walk-forward feedback arrays" block) for why this replaced
// the old probability-bucket-indexed calBinEmpP/calBinTotal that the SCORE dashboard row was mismatching
// against setupGrade. Index 0=A+, 1=A, 2=B, 3=C.
var array<float> calGradeTotal = array.new<float>(4, 0.0)
var array<float> calGradeWins  = array.new<float>(4, 0.0)
var array<float> calGradeSumR  = array.new<float>(4, 0.0)
var array<float> calGradeSumRSq = array.new<float>(4, 0.0)
var array<float> calGradeEmpP  = array.new<float>(4, 50.0)
var array<float> calGradeExpR  = array.new<float>(4, 0.0)

// Issue 11: Degenerate weight flag (displayed in dashboard)
var bool weightDegen = false

f_calcExpectancyWeight(array<float> scoreArr, array<float> outcomeArr, array<int> barArr, float baseW, int winLen, int totalTrades, int ringIdx) =>
    int activeLen = math.min(totalTrades, winLen)
    // Walk-forward lag — exclude the N_lag most recent trades chronologically to prevent in-sample overfitting
    int N_lag = math.max(5, winLen / 4)
    int safeLen = activeLen - N_lag
    if safeLen < 5
        baseW
    else
        float sumScore = 0.0
        float sumOutcome = 0.0
        float sumProduct = 0.0
        float sumAgeWeight = 0.0
        for k = 0 to safeLen - 1
            int idx = (ringIdx - activeLen + k + winLen) % winLen
            float sc = array.get(scoreArr, idx) / 100.0
            float ot = array.get(outcomeArr, idx)
            int   bg = array.get(barArr, idx)
            float age = bar_index - bg
            float _tfMinutes = timeframe.isminutes ? timeframe.multiplier : (timeframe.isdaily ? 390.0 : (timeframe.isweekly ? 1950.0 : 7800.0))
            float _barsPerDay = 390.0 / math.max(1.0, _tfMinutes)
            float _decayHorizon = math.max(100.0, _barsPerDay * 10.0)
            float ageWeight = math.max(0.1, 1.0 - age / _decayHorizon)
            sumScore     += sc * ageWeight
            sumOutcome   += ot * ageWeight
            sumProduct   += sc * ot * ageWeight
            sumAgeWeight += ageWeight
        float avgScore   = sumScore / sumAgeWeight
        float avgOutcome = sumOutcome / sumAgeWeight
        float cov = (sumProduct / sumAgeWeight) - (avgScore * avgOutcome)
        float rawW = baseW + cov * 5.0
        math.max(0.1, math.min(baseW * 2.5, rawW))

// Shared annualization factor for Sharpe/Sortino (previously duplicated verbatim in both functions).
// Averages bars-held over the SAME windowed slice (histBarsHeld[0..activeLen-1]) the return numerator
// is computed from — previously this divided LIFETIME totalBarsHeld/totalTrades, which drifts out of
// sync with a windowed Sharpe/Sortino if the average holding period has changed since trade #1
// (e.g. the strategy used to swing multi-day and now scalps intraday).
f_annualizationFactor(array<int> barsHeldArr, int winLen, int totalTrades) =>
    int activeLen = math.min(totalTrades, winLen)
    float _tfMins = timeframe.isminutes ? timeframe.multiplier : (timeframe.isdaily ? 390.0 : (timeframe.isweekly ? 1950.0 : 7800.0))
    float _barsPerDay = 390.0 / math.max(1.0, _tfMins)
    float sumBarsHeld = 0.0
    if activeLen > 0
        for i = 0 to activeLen - 1
            sumBarsHeld += array.get(barsHeldArr, i)
    float _avgBarsPerTrade = (activeLen > 0 and sumBarsHeld > 0) ? (sumBarsHeld / activeLen) : _barsPerDay
    float _daysPerTrade = math.max(0.1, _avgBarsPerTrade / _barsPerDay)
    float _tradesPerYear = 252.0 / _daysPerTrade
    math.sqrt(math.max(1.0, _tradesPerYear))

f_calcRollingSharpe(array<float> outcomeArr, array<int> barsHeldArr, int winLen, int totalTrades) =>
    int activeLen = math.min(totalTrades, winLen)
    if activeLen <= 1
        0.0
    else
        float sum = 0.0
        for i = 0 to activeLen - 1
            sum += array.get(outcomeArr, i)
        float avg = sum / activeLen
        float varSum = 0.0
        for i = 0 to activeLen - 1
            varSum += math.pow(array.get(outcomeArr, i) - avg, 2)
        float stdev = math.sqrt(varSum / (activeLen - 1))
        float annFactor = f_annualizationFactor(barsHeldArr, winLen, totalTrades)
        float sharpeRaw = stdev > 0 ? (avg / stdev) * annFactor : 0.0
        float cap = math.sqrt(activeLen) * 2.0
        math.max(-cap, math.min(cap, sharpeRaw))

// ─── Rolling Downside Sortino Ratio (Information Ratio relative to downside risk) ───
f_calcRollingSortino(array<float> outcomeArr, array<int> barsHeldArr, int winLen, int totalTrades) =>
    int activeLen = math.min(totalTrades, winLen)
    if activeLen <= 1
        0.0
    else
        float sum = 0.0
        float downsideVarSum = 0.0
        int downsideCount = 0
        for i = 0 to activeLen - 1
            float ot = array.get(outcomeArr, i)
            sum += ot
            if ot < 0.0
                downsideVarSum += math.pow(ot, 2)
                downsideCount += 1
        float avg = sum / activeLen
        float downsideDev = downsideCount > 1 ? math.sqrt(downsideVarSum / (downsideCount - 1)) : (downsideCount == 1 ? math.abs(sum) : 0.0)
        float annFactor = f_annualizationFactor(barsHeldArr, winLen, totalTrades)
        float sortinoRaw = downsideDev > 0 ? (avg / downsideDev) * annFactor : (avg > 0 ? math.sqrt(activeLen) : 0.0)
        float cap = math.sqrt(activeLen) * 2.5
        math.max(-cap, math.min(cap, sortinoRaw))

// ─── Rolling Probability Calibration Metrics (Brier Score & Mean Absolute Error) ───
f_calcRollingCalibration(array<float> outcomeArr, array<float> probArr, int winLen, int totalTrades) =>
    int activeLen = math.min(totalTrades, winLen)
    if activeLen == 0
        [0.25, 0.0]
    else
        float sumBrier = 0.0
        float sumMae   = 0.0
        for i = 0 to activeLen - 1
            float p = array.get(probArr, i) / 100.0
            float outcomeVal = array.get(outcomeArr, i)
            // Fix #8: Clean binary outcome (1.0 for win, 0.0 for loss/scratch)
            float o = outcomeVal > 0.0 ? 1.0 : 0.0
            sumBrier += math.pow(p - o, 2)
            sumMae   += math.abs(p - o)
        [sumBrier / activeLen, sumMae / activeLen]

f_calcRollingMetrics(array<float> outcomeArr, int winLen, int totalTrades) =>
    int activeLen = math.min(totalTrades, winLen)
    if activeLen == 0
        [0.0, 0.0, 0.0]
    else
        float sumWins = 0.0
        float sumLosses = 0.0
        float winCount = 0.0
        for i = 0 to activeLen - 1
            float ot = array.get(outcomeArr, i)
            if ot > 0.0
                sumWins += ot
                winCount += 1.0
            else if ot < 0.0
                sumLosses += math.abs(ot)
        float mWinRate = winCount / activeLen * 100.0
        float mPF = sumLosses > 0.0 ? sumWins / sumLosses : (sumWins > 0 ? 100.0 : 0.0)
        float mExpectancy = (sumWins - sumLosses) / activeLen
        [mWinRate, mPF, mExpectancy]

// ─── Dashboard Position Resolver ───
f_dashPos(string p) =>
    switch p
        "Top Left"      => position.top_left
        "Top Center"    => position.top_center
        "Top Right"     => position.top_right
        "Middle Left"   => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right"  => position.middle_right
        "Bottom Left"   => position.bottom_left
        "Bottom Center" => position.bottom_center
        "Bottom Right"  => position.bottom_right
        => position.top_right

// ─── Logistic Sigmoid Probability Calibration (Non-Circular & Input Guarded) ───
// Fixed bug: both real call sites pass (scoreA - scoreB) / 50.0 where scoreA/scoreB are 0-100 scores, so
// `bias` is ALWAYS an already-scaled symmetric quantity in roughly [-2, +2] — never a raw 0-100 percentage.
// The old "auto-normalize" branch treated any |bias|>1.5 as if it were a 0-100 value needing (x-50)/50
// conversion, which INVERTS the sign for real inputs in that range (e.g. bias=+1.8 -> (1.8-50)/50=-0.964,
// flipping a strongly bullish score gap into a strongly bearish calibrated probability) — happening only
// at the largest, highest-conviction score differentials (|sComposite-bearConf|>75), the exact opposite of
// where a calibration bug should be tolerated. Input domain is now fixed at "already-scaled, clamp to
// [-1,+1]" — no silent reinterpretation as a percentage, matching the only inputs this function ever gets.
f_sigmoid(float bias, float k) =>
    float rawB  = nz(bias, 0.0)
    float sBias = math.max(-1.0, math.min(1.0, rawB))
    float sK    = nz(k, 4.0)
    float calK  = sK
    if totalTrades >= 20
        float brierDev = math.max(-0.2, math.min(0.2, 0.20 - nz(rollBrier, 0.25)))
        calK := sK * math.max(0.5, 1.0 + brierDev * 2.0)
    float raw = 100.0 / (1.0 + math.exp(-calK * sBias))
    float res = math.max(5.0, math.min(95.0, raw))
    nz(res, 50.0)


// ─── Hyperbolic Tangent Helper Function ───
f_tanh(float x) =>
    float clampedX = math.max(-10.0, math.min(10.0, x))
    float e2x = math.exp(2.0 * clampedX)
    (e2x - 1.0) / (e2x + 1.0)

// ─── Raw (Pre-Calibration) Model Score ───
// Extracted out of f_retToProb so the online Platt-fit resolution sites (§9/§9b) call the EXACT same
// formula instead of a hand-copied duplicate that could drift out of sync — same principle as
// f_retProbEmpWeight previously mirroring f_retToProb's bin math, generalized into a shared function.
// priceOverride lets a caller reconstruct a PAST forecast's raw score using the price level at forecast
// time (e.g. frozenOrigin) instead of today's live close.
f_rawProb(float expRet, float atrVal, float caWinRate, float priceOverride) =>
    float refPrice    = na(priceOverride) ? close : priceOverride
    float volScale    = (refPrice > 0 and atrVal > 0) ? math.max(0.3, (atrVal / refPrice) * 100.0 * 0.75) : 1.5
    float zScore      = nz(expRet, 0.0) / volScale
    float scaled      = f_tanh(zScore)
    float accMult     = math.max(0.60, math.min(1.40, caWinRate / 50.0))
    float rawProb     = 50.0 + scaled * 40.0 * accMult
    math.max(10.0, math.min(90.0, rawProb))

// ─── Return-to-Probability Conversion (Online Logistic/Platt Calibration) ───
// P0: previously blended the raw tanh score toward a 5-bucket Laplace-smoothed empirical win rate — a
// discontinuous, coarse-resolution shrinkage estimator, and institutionally still just "the model's
// transformed estimate, partially corrected," not a real calibration pipeline. This now blends toward
// plattA/plattB instead: a genuine logistic (Platt) calibration fit via online gradient descent at TWO
// out-of-sample resolution points (the 1-bar-ahead check feeding shortHorizonBrier, and the next-day check
// feeding eodBrier — see those sites for the actual SGD update step), giving "raw model score -> real
// out-of-sample outcomes -> fitted empirical calibration -> calibrated P" instead of a lookup table. This
// is logistic, not isotonic, calibration specifically — isotonic regression needs an offline batch fit
// Pine's bar-by-bar execution model has no mechanism for; Platt scaling (a 2-parameter logistic regression)
// is the calibration method that's actually implementable as a continuously-updating online fit here. Not
// yet horizon-specific (one shared (a,b) fit from both resolution streams pooled, not separate short/long
// parameters) — a natural next refinement mirroring the shortHorizonBrier/eodBrier split, not implemented
// here to keep this change bounded.
f_retToProb(float expRet, float atrVal, float caWinRate = 50.0, float priceOverride = na) =>
    float clampedProb = f_rawProb(expRet, atrVal, caWinRate, priceOverride)
    float plattX      = (clampedProb - 50.0) / 50.0
    float plattProb   = 100.0 / (1.0 + math.exp(-(plattA * plattX + plattB)))
    // Shrinkage gate — same N=40 threshold precedent as the bucket method it replaced (P0-3), but now
    // gated on plattN (total resolved forecasts feeding the SHARED fit), not a thin per-bucket count, so
    // early on (before (a,b) have seen enough out-of-sample outcomes to mean anything) this returns exactly
    // the raw tanh estimate, not an undertrained curve.
    float plattBlend  = math.min(1.0, plattN / 40.0)
    plattBlend * plattProb + (1.0 - plattBlend) * clampedProb

// ─── Return-Probability Empirical Weight (Calibration Transparency) ───
// Mirrors f_retToProb's own plattBlend math exactly, to report HOW MUCH of the probability it returns is
// backed by the fitted Platt calibration (plattBlend) vs. still the raw tanh-transform prior (1-plattBlend)
// — without changing f_retToProb's single-value signature used at every call site. A fresh model reports 0%
// (pure prior); it only rises as plattN accumulates real, out-of-sample forecast-vs-outcome resolutions.
// P0: dropped expRet/atrVal/caWinRate/priceOverride — this only ever depended on plattN (the SAME shared
// calibration sample count for every horizon, since plattA/plattB/plattN are pooled — see f_retToProb's own
// comment on that), so every call site passed per-horizon arguments the body never actually read.
f_retProbEmpWeight() =>
    [math.min(1.0, plattN / 40.0), plattN]

// ─── Tail-Risk Probability: P(return exceeds an arbitrary threshold) ───
// Same vol-scaled tanh transform as f_retToProb, z-scored against (expected return - threshold) instead of
// zero, so direction and tail-risk probabilities share one distributional assumption. thresholdPct > 0 asks
// "P(return > threshold)"; < 0 asks "P(return < threshold)".
f_probExceed(float expRet, float atrVal, float thresholdPct) =>
    float volScale = (close > 0 and atrVal > 0) ? math.max(0.3, (atrVal / close) * 100.0 * 0.75) : 1.5
    float z        = (nz(expRet, 0.0) - thresholdPct) / volScale
    float scaled   = f_tanh(z)
    math.max(1.0, math.min(99.0, 50.0 + scaled * 49.0))

// ─── Dynamic US Daylight Saving Time (DST) Helper (Fix #19) ───
f_isUsDst(int ts) =>
    int m = month(ts, "UTC")
    int d = dayofmonth(ts, "UTC")
    bool isDst = false
    if m > 3 and m < 11
        isDst := true
    else if m == 3
        int secondSun = 14 - (dayofweek(timestamp("UTC", year(ts, "UTC"), 3, 14, 0, 0), "UTC") - 1)
        isDst := d > secondSun or (d == secondSun and hour(ts, "UTC") >= 7)
    else if m == 11
        int firstSun = 7 - (dayofweek(timestamp("UTC", year(ts, "UTC"), 11, 7, 0, 0), "UTC") - 1)
        isDst := d < firstSun or (d == firstSun and hour(ts, "UTC") < 6)
    isDst

// ─── US Market Session Detection (IST-Based + DST Aware) ───
f_getSessionIST(int ts) =>
    bool isDst = f_isUsDst(ts)
    int shiftMins = isDst ? 0 : 60 // 1 hour shift during US Winter EST
    int h = hour(ts, "Asia/Kolkata")
    int m = minute(ts, "Asia/Kolkata")
    int mins = h * 60 + m
    int dow = dayofweek(ts, "Asia/Kolkata")
    int mktOpen  = 1140 + shiftMins
    int preOpen  = 810  + shiftMins
    int ovnOpen  = 330  + shiftMins
    int postOpen = 90   + shiftMins
    string sess = "OVERNIGHT"
    if mins >= mktOpen
        sess := "MARKET"
    else if mins >= preOpen
        sess := "PRE-MKT"
    else if mins >= ovnOpen
        sess := "OVERNIGHT"
    else if mins >= postOpen
        sess := "POST-MKT"
    else
        sess := "MARKET"
    // Weekend: Sat after post-mkt close → Mon overnight open
    if dow == dayofweek.sunday
        sess := "CLOSED"
    else if dow == dayofweek.saturday and mins >= ovnOpen
        sess := "CLOSED"
    else if dow == dayofweek.monday and mins < ovnOpen
        sess := "CLOSED"
    sess

// ─── Holiday Calendar (P1) ───
// Exchange-local (America/New_York) calendar date string, for matching against i_holidayDates — NYSE
// holidays are defined in ET, not IST, so the comparison has to happen in the exchange's own timezone.
f_exchDateStr(int ts) =>
    int y = year(ts, "America/New_York")
    int m = month(ts, "America/New_York")
    int d = dayofmonth(ts, "America/New_York")
    string mPad = m < 10 ? "0" : ""
    string dPad = d < 10 ? "0" : ""
    str.tostring(y) + "-" + mPad + str.tostring(m) + "-" + dPad + str.tostring(d)

// Straight substring match against a comma-separated date list — no str.trim in Pine v6, so this expects
// the list to have no spaces around commas (documented on the i_holidayDates input itself).
f_isDateListed(string dateStr, string list) =>
    array<string> parts = str.split(list, ",")
    bool found = false
    if array.size(parts) > 0
        for i = 0 to array.size(parts) - 1
            if array.get(parts, i) == dateStr
                found := true
    found

f_sessClr(string s) =>
    switch s
        "MARKET"    => #00E676
        "PRE-MKT"   => #FFD600
        "POST-MKT"  => #42A5F5
        "OVERNIGHT" => #AB47BC
        "CLOSED"    => #FF1744
        => #616161

f_sessIcon(string s) =>
    switch s
        "MARKET"    => "🟢"
        "PRE-MKT"   => "🟡"
        "POST-MKT"  => "🔵"
        "OVERNIGHT" => "🌙"
        "CLOSED"    => "🔴"
        => "⚫"

// ─── 12-Hour Time Formatter (IST) ───
f_fmt12h(int ts) =>
    int h24 = hour(ts, "Asia/Kolkata")
    int m   = minute(ts, "Asia/Kolkata")
    string ampm = h24 >= 12 ? "PM" : "AM"
    int h12 = h24 == 0 ? 12 : h24 > 12 ? h24 - 12 : h24
    string mPad = m < 10 ? "0" : ""
    str.tostring(h12) + ":" + mPad + str.tostring(m) + " " + ampm

// ─── Human Readable Date Formatter (IST) ───
f_fmtDateStr(int ts) =>
    int d = dayofmonth(ts, "Asia/Kolkata")
    int m = month(ts, "Asia/Kolkata")
    string mStr = m == 1 ? "Jan" : m == 2 ? "Feb" : m == 3 ? "Mar" : m == 4 ? "Apr" : m == 5 ? "May" : m == 6 ? "Jun" : m == 7 ? "Jul" : m == 8 ? "Aug" : m == 9 ? "Sep" : m == 10 ? "Oct" : m == 11 ? "Nov" : "Dec"
    int dow = dayofweek(ts, "Asia/Kolkata")
    string dowStr = dow == 1 ? "Sun" : dow == 2 ? "Mon" : dow == 3 ? "Tue" : dow == 4 ? "Wed" : dow == 5 ? "Thu" : dow == 6 ? "Fri" : "Sat"
    dowStr + " " + mStr + " " + str.tostring(d)

// ─── Session-Aware Dynamic Date Resolver (IST) ───
// Calculates the exact calendar date string for any session relative to current IST time
f_getSessDateStr(string sessType) =>
    int tsNow = timenow
    int h = hour(tsNow, "Asia/Kolkata")
    int m = minute(tsNow, "Asia/Kolkata")
    int mins = h * 60 + m
    int dow = dayofweek(tsNow, "Asia/Kolkata")
    int oneDayMs = 86400000
    int targetTs = tsNow

    if sessType == "OVERNIGHT"
        // Overnight session: 5:30 AM IST (mins = 330) to 1:30 PM IST (mins = 810)
        // If mins < 810 (before 1:30 PM IST), overnight session is today's active/upcoming overnight (target tsNow)
        // If mins >= 810 (past 1:30 PM IST), overnight for today is completed; target tomorrow morning's overnight
        if mins >= 810 or dow == 7 or dow == 1
            int days = (dow == 6 ? 3 : dow == 7 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    else if sessType == "PRE-MKT"
        // Pre-Market session: 1:30 PM IST (mins = 810) to 7:00 PM IST (mins = 1140)
        // If mins < 1140 (before 7:00 PM IST), pre-market is today's session (target tsNow)
        // If mins >= 1140 (past 7:00 PM IST), pre-market for today is finished; target next trading day
        if mins >= 1140 or dow == 7 or dow == 1
            int days = (dow == 6 ? 3 : dow == 7 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    else if sessType == "PRE-MKT-NEXT"
        // Always the NEXT trading day's pre-market — used when we're currently inside today's own
        // pre-market and the display needs to skip past it to the following one, unlike "PRE-MKT" above
        // which returns TODAY while today's pre-market is still live.
        int days = (dow == 6 ? 3 : dow == 7 ? 2 : 1)
        targetTs := tsNow + days * oneDayMs

    else if sessType == "OVERNIGHT-NEXT"
        // Always the NEXT trading day's overnight session — same rationale as PRE-MKT-NEXT/POST-MKT-NEXT,
        // for when we're currently inside today's own overnight session and need to skip past it to the
        // following one instead of showing "OVERNIGHT" above (which returns TODAY while it's still live).
        int days = (dow == 6 ? 3 : dow == 7 ? 2 : 1)
        targetTs := tsNow + days * oneDayMs

    else if sessType == "REG-MKT"
        // Regular Market session open: 7:00 PM IST (mins = 1140)
        if mins >= 1140 or dow == 7 or dow == 1
            int days = (dow == 6 ? 3 : dow == 7 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    else if sessType == "POST-MKT"
        // Post-Market session: 1:30 AM IST (mins = 90) to 5:30 AM IST (mins = 330)
        // If mins < 330 (before 5:30 AM IST), post-market is active/finishing early morning today (target tsNow)
        // If mins >= 330 (after 5:30 AM IST), next post-market is late tonight / early tomorrow morning
        if mins >= 330
            int days = (dow == 6 ? 1 : dow == 7 ? 3 : dow == 1 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    else if sessType == "POST-MKT-NEXT"
        // Always the NEXT trading day's post-market — same rationale as PRE-MKT-NEXT, for when we're
        // currently inside today's own post-market and need to skip past it to the following one.
        int days = (dow == 6 ? 1 : dow == 7 ? 3 : dow == 1 ? 2 : 1)
        targetTs := tsNow + days * oneDayMs

    else if sessType == "TODAY-EOD"
        // Today's regular market session close (closes at 1:30 AM IST next calendar morning)
        if mins >= 90
            int days = (dow == 6 ? 1 : dow == 7 ? 3 : dow == 1 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    else if sessType == "NXT-DAY"
        // Dated by session OPEN (matching every other row), not close — identical to TODAY-EOD's date,
        // since the next Reg session opens later on that same calendar date EOD's close lands on.
        if mins >= 90
            int days = (dow == 6 ? 1 : dow == 7 ? 3 : dow == 1 ? 2 : 1)
            targetTs := tsNow + days * oneDayMs
        else
            targetTs := tsNow

    f_fmtDateStr(targetTs)




f_tfLabel() =>
    string result = timeframe.period
    if timeframe.isseconds
        result := str.tostring(timeframe.multiplier) + "s"
    else if timeframe.isminutes
        result := (timeframe.multiplier % 60 == 0 ? str.tostring(timeframe.multiplier / 60) + "H" : str.tostring(timeframe.multiplier) + "m")
    else if timeframe.isdaily
        result := (timeframe.multiplier == 1 ? "D" : str.tostring(timeframe.multiplier) + "D")
    else if timeframe.isweekly
        result := (timeframe.multiplier == 1 ? "W" : str.tostring(timeframe.multiplier) + "W")
    else if timeframe.ismonthly
        result := (timeframe.multiplier == 1 ? "M" : str.tostring(timeframe.multiplier) + "M")
    result



// ════════════════════════════════════════════════════════════════════════
// §3  ADAPTIVE ENGINE — Rolling Percentile Thresholds
// ════════════════════════════════════════════════════════════════════════
// The grading percentiles below (atrP90, adxP70, rvolP80, bodyP85...) are computed dynamically. Session
// thresholds, event multipliers, and blend coefficients elsewhere in the script are hand-set hyperparameters,
// not learned — see §9b's threshMkt/Pre/Post/Ovn and the basket/blend weights in §4/§9 for the fixed ones.

float atr      = ta.atr(i_atrLen)
float atrP90   = ta.percentile_nearest_rank(atr, 50, 90)
float atrP20   = ta.percentile_nearest_rank(atr, 50, 20)

float rsi      = ta.rsi(close, i_rsiLen)
float rsiCenter = nz(ta.sma(rsi, 100), 50.0)

[diPlus, diMinus, adxVal] = ta.dmi(i_adxLen, i_adxLen)
float adxP70   = ta.percentile_nearest_rank(adxVal, 100, 70)
bool  adxStrong = adxVal >= adxP70

float volMA    = ta.sma(volume, i_volLen)
float rvol     = volMA > 0 ? volume / volMA : 1.0
float rvolP80  = ta.percentile_nearest_rank(rvol, 50, 80)
bool  volSurge = rvol >= rvolP80

float bodySize = math.abs(close - open)
float bodyP85  = ta.percentile_nearest_rank(bodySize, 50, 85)
bool  bigMove  = bodySize > bodyP85

float mfi      = ta.mfi(hlc3, 14)
float mfiCenter = nz(ta.sma(mfi, 100), 50.0)


// ════════════════════════════════════════════════════════════════════════
// §4  CORE INDICATORS & MULTI-TIMEFRAME CALLS
// ════════════════════════════════════════════════════════════════════════

// ─── EMAs ───
float emaF   = ta.ema(close, i_emaFast)
float emaM   = ta.ema(close, i_emaMid)
float emaS   = ta.ema(close, i_emaSlow)
float ema200 = ta.ema(close, i_ema200)

bool bullStack = emaF > emaM and emaM > emaS
bool bearStack = emaF < emaM and emaM < emaS

// ─── Session VWAP ───
bool isFirstBar = isCrypto ? (ta.change(time("D")) != 0) : session.isfirstbar_regular
[vwapVal, vwapUp1, vwapDn1] = ta.vwap(hlc3, isFirstBar, 1.0)
bool isNewDay = ta.change(time("D")) != 0
string _curSessVP = f_getSessionIST(time)
bool _isUsMkt = _curSessVP == "MARKET"

// ─── Previous Day & ADR (Non-Repainting) ───
[prevDayH, prevDayL, prevDayC, adr14] = request.security(
     syminfo.tickerid, "1D",
     [high[1], low[1], close[1], ta.sma(high[1] - low[1], 14)],
     gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ─── Day Session High / Low ───
var float dayHi = na
var float dayLo = na
if isFirstBar
    dayHi := high
    dayLo := low
if session.ismarket
    dayHi := math.max(nz(dayHi, high), high)
    dayLo := math.min(nz(dayLo, low),  low)

float adrConsumedPct = (not na(adr14) and adr14 > 0 and not na(dayHi) and not na(dayLo)) ? (dayHi - dayLo) / adr14 * 100.0 : 0.0
bool adrOK = adrConsumedPct <= 80.0

// Multi-Timeframe (Non-Repainting) — validated so requested HTFs are >= chart timeframe; ternary stays
// 'simple string' (request.security requires it) since input.timeframe()/timeframe.in_seconds() both qualify.
string validHtf1 = timeframe.in_seconds(i_htf1) >= timeframe.in_seconds() ? i_htf1 : timeframe.period
string validHtf2 = timeframe.in_seconds(i_htf2) >= timeframe.in_seconds() ? i_htf2 : timeframe.period
string validHtf3 = timeframe.in_seconds(i_htf3) >= timeframe.in_seconds() ? i_htf3 : timeframe.period

// P0-2: [1] inside the request.security() expression means "one bar back IN THE HTF's OWN CONTEXT" — i.e.
// the previous COMPLETED 1D/4H/1H bar, never the current still-forming one. lookahead_off alone already
// guarantees no repainting on confirmed historical bars, but it does NOT freeze the live/right-most bar:
// while a 5m bar is forming, the daily/4H/1H candle it sits inside is still developing too, so htf1Close
// (and htf1Bull/T_1D derived from it) could change value several times before that HTF candle actually
// closes. That's not look-ahead (nothing from the future leaks in), but it's not "confirmed" either — a
// live trader watching multiple timeframes sees the same thing, yet institutional convention is to gate
// signals on the LAST CLOSED higher-timeframe bar, not the one still printing. The [1] offset here forces
// exactly that: every htf1/2/3 value used for htf1Bull/T_1D etc. is always the prior COMPLETED HTF bar's
// value, deliberately trading a bit of responsiveness (it won't react to today's still-forming daily trend)
// for stability (it can't flip mid-candle on data that isn't final yet).
[htf1Close, htf1Ema, htf1Atr] = request.security(syminfo.tickerid, validHtf1,
     [close[1], ta.ema(close, 50)[1], ta.atr(14)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htf2Close, htf2Ema, htf2Atr] = request.security(syminfo.tickerid, validHtf2,
     [close[1], ta.ema(close, 50)[1], ta.atr(14)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[htf3Close, htf3Ema, htf3Atr] = request.security(syminfo.tickerid, validHtf3,
     [close[1], ta.ema(close, 50)[1], ta.atr(14)[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

bool htf1Bull = htf1Close > htf1Ema
bool htf2Bull = htf2Close > htf2Ema
bool htf3Bull = htf3Close > htf3Ema
bool htf1Bear = htf1Close < htf1Ema
bool htf2Bear = htf2Close < htf2Ema
bool htf3Bear = htf3Close < htf3Ema

// ─── Index Breadth Confluence & Primary Benchmark Index (Non-Repainting) ───
// Fix #15: Use exchange-qualified tickers TVC:VIX, TVC:US10Y, TVC:DXY for reliable data resolution
spyClose   = request.security("SPY", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
qqqClose   = request.security("QQQ", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
smhClose   = request.security("SMH", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
vixClose   = request.security("TVC:VIX", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// Primary Benchmark Index (ICE:ICESEMIT/INDEX:ICESEMIT) — ICE supports intraday, INDEX is daily-only on
// TradingView, so this requests intraday for ICE feeds and 1D for INDEX feeds, falling back to 1D and SMH.
bool isDailyOnlyIndex = str.contains(i_symIndex, "INDEX:")
string indexTf = isDailyOnlyIndex ? "1D" : timeframe.period

// isDailyOnlyIndex forces indexTf to "1D" above, so fetching "1D" again here would be a second,
// fully redundant request.security() call to the identical symbol+timeframe on every bar — cut it.
indexCloseIntraday = request.security(i_symIndex, indexTf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
indexCloseDaily    = isDailyOnlyIndex ? indexCloseIntraday : request.security(i_symIndex, "1D", close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

indexClose = not na(indexCloseIntraday) ? indexCloseIntraday : indexCloseDaily

// P0-6: full-trading-day underlying benchmark return, non-repainting — close[1] vs close[2] evaluated
// INSIDE the "1D" request.security context (the same [1]-inside-request.security idiom used for the HTF
// bias inputs above) gives the return of the LAST FULLY COMPLETED daily bar over the one before it, never
// today's still-forming session. Feeds the synthetic daily-reset NAV validator in §9.
indexDailyRetRaw = request.security(i_symIndex, "1D", (close[1] - close[2]) / close[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

// P0: SOXL's OWN full-trading-day return (same non-repainting close[1]-vs-close[2]-in-"1D"-context idiom as
// indexDailyRetRaw above), for the tracking-residual learner in §9 — the actual realized SOXL return of the
// day that just completed, to compare against what the mechanical 3x model would have predicted for that
// same day.
soxlDailyRetRaw = request.security(syminfo.tickerid, "1D", (close[1] - close[2]) / close[2], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

// ─── Macro Drivers: Treasury Yield & Dollar Index (Semiconductor Regime) ───
us10yClose = request.security("TVC:US10Y", timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
dxyClose   = request.security("TVC:DXY",   timeframe.period, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

spyEma   = ta.ema(spyClose, 50)
qqqEma   = ta.ema(qqqClose, 50)
smhEma   = ta.ema(smhClose, 50)
vixEma   = ta.ema(vixClose, 50)
indexEma = ta.ema(indexClose, 50)
us10yEma = ta.ema(us10yClose, 50)
dxyEma   = ta.ema(dxyClose, 50)

// Standardized neutral NA fallbacks to prevent phantom bearish/bullish bias during data loss
bool spyBull   = not na(spyClose) and not na(spyEma) ? spyClose > spyEma : false
bool qqqBull   = not na(qqqClose) and not na(qqqEma) ? qqqClose > qqqEma : false
bool smhBull   = not na(smhClose) and not na(smhEma) ? smhClose > smhEma : false
bool indexBull = not na(indexClose) and not na(indexEma) ? indexClose > indexEma : smhBull
bool vixBear   = not na(vixClose) and not na(vixEma) ? vixClose < vixEma : false
bool yieldBull = not na(us10yClose) and not na(us10yEma) ? us10yClose < us10yEma : false
bool dxyBull   = not na(dxyClose)   and not na(dxyEma)   ? dxyClose   < dxyEma   : false

// Benchmark & Sector Index Returns (Priority 1: ICESEMIT 45% Weight with 4-tier availability fallback: ICESEMIT -> SMH -> QQQ -> SPY)
float indexRetRaw = not na(indexClose) and not na(indexClose[1]) and indexClose[1] > 0 ? (indexClose - indexClose[1]) / indexClose[1] : na
float smhRetRaw   = not na(smhClose) and not na(smhClose[1]) and smhClose[1] > 0 ? (smhClose - smhClose[1]) / smhClose[1] : na
float qqqRetRaw   = not na(qqqClose) and not na(qqqClose[1]) and qqqClose[1] > 0 ? (qqqClose - qqqClose[1]) / qqqClose[1] : na
float spyRetRaw   = not na(spyClose) and not na(spyClose[1]) and spyClose[1] > 0 ? (spyClose - spyClose[1]) / spyClose[1] : 0.0

float indexReturn = not na(indexRetRaw) ? indexRetRaw : (not na(smhRetRaw) ? smhRetRaw : (not na(qqqRetRaw) ? qqqRetRaw : spyRetRaw))

var bool bf3Bull = false  // Slot 3 constituent factor bullish status

// ─── Basket Constituent Returns & Relative Strength Factor Loading (Priority 2: 25% Weight) ───
// Combines constituent trend momentum (20-EMA distance in ATR units) modulated by damped single-day relative performance vs benchmark.
f_basketData(string sym) =>
    [c, c1, e, a] = request.security(sym, timeframe.period,
         [close, close[1], ta.ema(close, 20), ta.atr(14)],
         gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)
    float ret = (not na(c) and not na(c1) and c1 > 0) ? (c - c1) / c1 : 0.0
    float benchmarkRet = not na(indexReturn) ? indexReturn : 0.0
    float relPerf = ret - benchmarkRet
    // Fix #1: Relative performance dampening (relPerf * 2.0 bounded to [-0.20, 0.20]) to prevent single-day return noise from distorting EMA trend Z-score
    float relMult = 1.0 + math.max(-0.20, math.min(0.20, relPerf * 2.0))
    float trendZ  = (not na(c) and not na(e) and not na(a) and a > 0) ? ((c - e) / (a * 2.0)) : 0.0
    float factor  = trendZ * relMult
    [ret, factor]

[r1, bf1]   = f_basketData(i_sym1)
[r2, bf2]   = f_basketData(i_sym2)
[r3, bf3]   = f_basketData(i_sym3)
[r4, bf4]   = f_basketData(i_sym4)
[r5, bf5]   = f_basketData(i_sym5)
[r6, bf6]   = f_basketData(i_sym6)
[r7, bf7]   = f_basketData(i_sym7)
[r8, bf8]   = f_basketData(i_sym8)
[r9, bf9]   = f_basketData(i_sym9)
[r10, bf10] = f_basketData(i_sym10)

// ─── Priority 6: Dynamic ETF Constituent Weight Drift Engine ───
// Models intra-quarter price performance drift of SOXL constituents using EMA smoothing for recency weighting
float retCum1  = ta.ema(r1, 20)
float retCum2  = ta.ema(r2, 20)
float retCum3  = ta.ema(r3, 20)
float retCum4  = ta.ema(r4, 20)
float retCum5  = ta.ema(r5, 20)
float retCum6  = ta.ema(r6, 20)
float retCum7  = ta.ema(r7, 20)
float retCum8  = ta.ema(r8, 20)
float retCum9  = ta.ema(r9, 20)
float retCum10 = ta.ema(r10, 20)

// Bound individual dynamic constituent weights (0.5x to 2.0x base weight) prior to normalization
float w1_dyn  = math.max(i_w1  * 0.5, math.min(i_w1  * 2.0, i_w1  * (1.0 + retCum1)  * (1.0 + 0.5 * math.abs(bf1))))
float w2_dyn  = math.max(i_w2  * 0.5, math.min(i_w2  * 2.0, i_w2  * (1.0 + retCum2)  * (1.0 + 0.5 * math.abs(bf2))))
float w3_dyn  = math.max(i_w3  * 0.5, math.min(i_w3  * 2.0, i_w3  * (1.0 + retCum3)  * (1.0 + 0.5 * math.abs(bf3))))
float w4_dyn  = math.max(i_w4  * 0.5, math.min(i_w4  * 2.0, i_w4  * (1.0 + retCum4)  * (1.0 + 0.5 * math.abs(bf4))))
float w5_dyn  = math.max(i_w5  * 0.5, math.min(i_w5  * 2.0, i_w5  * (1.0 + retCum5)  * (1.0 + 0.5 * math.abs(bf5))))
float w6_dyn  = math.max(i_w6  * 0.5, math.min(i_w6  * 2.0, i_w6  * (1.0 + retCum6)  * (1.0 + 0.5 * math.abs(bf6))))
float w7_dyn  = math.max(i_w7  * 0.5, math.min(i_w7  * 2.0, i_w7  * (1.0 + retCum7)  * (1.0 + 0.5 * math.abs(bf7))))
float w8_dyn  = math.max(i_w8  * 0.5, math.min(i_w8  * 2.0, i_w8  * (1.0 + retCum8)  * (1.0 + 0.5 * math.abs(bf8))))
float w9_dyn  = math.max(i_w9  * 0.5, math.min(i_w9  * 2.0, i_w9  * (1.0 + retCum9)  * (1.0 + 0.5 * math.abs(bf9))))
float w10_dyn = math.max(i_w10 * 0.5, math.min(i_w10 * 2.0, i_w10 * (1.0 + retCum10) * (1.0 + 0.5 * math.abs(bf10))))
float totalWBasket = w1_dyn + w2_dyn + w3_dyn + w4_dyn + w5_dyn + w6_dyn + w7_dyn + w8_dyn + w9_dyn + w10_dyn

// Normalized Constituent Weights (prevents single-stock dominance after large moves). Fallback constants
// only trigger if totalWBasket <= 0 (practically unreachable); re-derived from the fact sheet above,
// normalized to 1.0, matching the current slot order (1=MU..10=TSM).
float w1_norm  = totalWBasket > 0 ? w1_dyn  / totalWBasket : 0.1385
float w2_norm  = totalWBasket > 0 ? w2_dyn  / totalWBasket : 0.1312
float w3_norm  = totalWBasket > 0 ? w3_dyn  / totalWBasket : 0.1105
float w4_norm  = totalWBasket > 0 ? w4_dyn  / totalWBasket : 0.1027
float w5_norm  = totalWBasket > 0 ? w5_dyn  / totalWBasket : 0.0985
float w6_norm  = totalWBasket > 0 ? w6_dyn  / totalWBasket : 0.0937
float w7_norm  = totalWBasket > 0 ? w7_dyn  / totalWBasket : 0.0915
float w8_norm  = totalWBasket > 0 ? w8_dyn  / totalWBasket : 0.0847
float w9_norm  = totalWBasket > 0 ? w9_dyn  / totalWBasket : 0.0794
float w10_norm = totalWBasket > 0 ? w10_dyn / totalWBasket : 0.0692

float basketFactorSum = 0.0
float basketPctSum    = 50.0
float basketRetSum    = 0.0

if i_useBasket and totalWBasket > 0
    basketFactorSum := w1_norm*bf1 + w2_norm*bf2 + w3_norm*bf3 + w4_norm*bf4 + w5_norm*bf5 + w6_norm*bf6 + w7_norm*bf7 + w8_norm*bf8 + w9_norm*bf9 + w10_norm*bf10
    basketFactorSum := math.max(-1.0, math.min(1.0, basketFactorSum))
    basketPctSum    := (basketFactorSum + 1.0) * 50.0
    basketRetSum    := w1_norm*r1 + w2_norm*r2 + w3_norm*r3 + w4_norm*r4 + w5_norm*r5 + w6_norm*r6 + w7_norm*r7 + w8_norm*r8 + w9_norm*r9 + w10_norm*r10
else
    basketFactorSum := 0.0
    basketPctSum    := 50.0
    basketRetSum    := 0.0

float basketPct = basketPctSum

// P1-11: basketPct/basketRetSum/basketFactorSum above are a TACTICAL RELATIVE-STRENGTH exposure — w*_dyn
// deliberately up-weights constituents that have been outperforming (retCum) and have strong momentum
// (|bf|), so this basket answers "what does a momentum-tilted version of the top holdings imply," NOT
// "what does SOXL's actual current holdings-weighted basket imply." Those are different models and were
// previously conflated under one set of variables with no static counterpart to compare against. The
// script's actual PRIMARY benchmark for "what does the real underlying index/ETF say" was always the
// separately-fetched indexReturn/indexClose (ICESEMIT, or SMH/QQQ/SPY fallback) computed above in §4 — this
// basket has never been a replacement for that. basketStatic* below adds the missing counterpart: the SAME
// top-10 holdings, weighted by their DECLARED i_w1..i_w10 percentages only, un-tilted by any return/momentum
// factor — a genuine "ActualIndexExposure" (well, actual-declared-weight exposure) proxy to compare the
// tactical view against. Computed but not yet wired into any downstream signal — nothing about the existing
// model's behavior changes; it's exposed for anyone who wants the untitled baseline as a cross-check.
float totalWStatic = i_w1 + i_w2 + i_w3 + i_w4 + i_w5 + i_w6 + i_w7 + i_w8 + i_w9 + i_w10
float w1_static  = totalWStatic > 0 ? i_w1  / totalWStatic : 0.1385
float w2_static  = totalWStatic > 0 ? i_w2  / totalWStatic : 0.1312
float w3_static  = totalWStatic > 0 ? i_w3  / totalWStatic : 0.1105
float w4_static  = totalWStatic > 0 ? i_w4  / totalWStatic : 0.1027
float w5_static  = totalWStatic > 0 ? i_w5  / totalWStatic : 0.0985
float w6_static  = totalWStatic > 0 ? i_w6  / totalWStatic : 0.0937
float w7_static  = totalWStatic > 0 ? i_w7  / totalWStatic : 0.0915
float w8_static  = totalWStatic > 0 ? i_w8  / totalWStatic : 0.0847
float w9_static  = totalWStatic > 0 ? i_w9  / totalWStatic : 0.0794
float w10_static = totalWStatic > 0 ? i_w10 / totalWStatic : 0.0692

float basketStaticFactorSum = 0.0
float basketStaticRetSum    = 0.0
if i_useBasket and totalWStatic > 0
    basketStaticFactorSum := math.max(-1.0, math.min(1.0, w1_static*bf1 + w2_static*bf2 + w3_static*bf3 + w4_static*bf4 + w5_static*bf5 + w6_static*bf6 + w7_static*bf7 + w8_static*bf8 + w9_static*bf9 + w10_static*bf10))
    basketStaticRetSum    := w1_static*r1 + w2_static*r2 + w3_static*r3 + w4_static*r4 + w5_static*r5 + w6_static*r6 + w7_static*r7 + w8_static*r8 + w9_static*r9 + w10_static*r10
float basketStaticPct = (basketStaticFactorSum + 1.0) * 50.0

// Derive slot 3 constituent factor bullish status (Issue #2: Renamed from nvdaBull to generic bf3Bull)
bf3Bull := bf3 > 0

// Orthogonalized Market Breadth (Fix #11: 3-Group Weighted Voting: 40% Benchmark/Indices, 30% Full Sector Basket, 30% Macro)
float indexGroupScore = ((spyBull?1:0) + (qqqBull?1:0) + (indexBull?1:0)) / 3.0
float assetGroupScore = basketPct / 100.0
float macroGroupScore = ((vixBear?1:0) + (yieldBull?1:0) + (dxyBull?1:0)) / 3.0

float mktBreadthPct = (indexGroupScore * 0.40 + assetGroupScore * 0.30 + macroGroupScore * 0.30) * 100.0

// Macro Regime Bias (feeds into forecast engine — incorporates Yield/DXY/VIX regime)
float macroBias = ((yieldBull ? 0.33 : -0.33) + (dxyBull ? 0.33 : -0.33) + (vixBear ? 0.34 : -0.34))
float dADX = not na(adxVal) ? adxVal : 20.0
// Macro weight provides directional guidance during low ADX chop/consolidation, while technical trends dominate high ADX expansion
float dynMacroWeight = (1.0 - math.min(0.6, dADX / 50.0)) * (i_macroWeight / 100.0)
float macroAdj = macroBias * math.max(0.01, math.min(0.50, dynMacroWeight))

// ════════════════════════════════════════════════════════════════════════
// §5  MARKET REGIME ENGINE
// ════════════════════════════════════════════════════════════════════════

// Bollinger Bandwidth for compression detection
float bbDev   = ta.stdev(close, 20) * 2.0
float bbWidth = close > 0 ? bbDev / close * 100.0 : 0.0
float bbP20   = ta.percentile_nearest_rank(bbWidth, 50, 20)

bool isExpansion   = atr > atrP90 and volSurge
bool isCompression = atr < atrP20 and bbWidth <= bbP20
bool isTrending    = adxStrong and (bullStack or bearStack) and not isExpansion
bool isRanging     = not isTrending and not isExpansion and not isCompression

bool isMarkup      = isTrending and bullStack
bool isMarkdown    = isTrending and bearStack
bool isVolExp      = isExpansion
bool isVolContr    = isCompression
bool isPullback    = isTrending and (bullStack ? close < emaF : close > emaF)
bool isAccumDist   = isRanging and adxStrong

var string regime = "Mean Reversion"

// ════════════════════════════════════════════════════════════════════════
// §6  MARKET STRUCTURE ENGINE
// ════════════════════════════════════════════════════════════════════════

// ─── External (Major) Swing Points ───
// ta.pivothigh/low return on the CONFIRMATION bar (after right-side lookback); called unconditionally for
// state consistency, but only assigned on confirmed bars to prevent intra-bar repainting.
float swingHighRaw = ta.pivothigh(high, i_swingLen, i_swingLen)
float swingLowRaw  = ta.pivotlow(low,   i_swingLen, i_swingLen)
float swingHigh    = confirmed ? swingHighRaw : na
float swingLow      = confirmed ? swingLowRaw : na

var float lastSH = na, var float lastSL = na
var float prevSH = na, var float prevSL = na

if not na(swingHigh)
    prevSH := lastSH
    lastSH := swingHigh
if not na(swingLow)
    prevSL := lastSL
    lastSL := swingLow

// ─── Internal (Minor) Swing Points ───
// Increased from lookback 3 to i_swingLen (min 5) for institutional confirmation
int intSwingLB = math.max(5, i_swingLen)
float intSwingHRaw = ta.pivothigh(high, intSwingLB, intSwingLB)
float intSwingLRaw = ta.pivotlow(low,   intSwingLB, intSwingLB)
float intSwingH    = confirmed ? intSwingHRaw : na
float intSwingL    = confirmed ? intSwingLRaw : na
var float lastIntSH = na, var float lastIntSL = na
if not na(intSwingH)
    lastIntSH := intSwingH
if not na(intSwingL)
    lastIntSL := intSwingL

// ─── BOS / CHoCH Detection ───
var int msState     = 0
var int prevMsState = 0

bool bullBOS = confirmed and not na(lastSH) and close > lastSH and close[1] <= lastSH
bool bearBOS = confirmed and not na(lastSL) and close < lastSL and close[1] >= lastSL

// Minor BOS (internal structure)
bool minorBullBOS = confirmed and not na(lastIntSH) and close > lastIntSH and close[1] <= lastIntSH
bool minorBearBOS = confirmed and not na(lastIntSL) and close < lastIntSL and close[1] >= lastIntSL

if bullBOS
    prevMsState := msState
    msState     := 1
if bearBOS
    prevMsState := msState
    msState     := -1

bool bullCHoCH = bullBOS and prevMsState == -1
bool bearCHoCH = bearBOS and prevMsState ==  1

// ─── Equilibrium & Adaptive Premium / Discount ───
float equilibrium = not na(lastSH) and not na(lastSL) ? (lastSH + lastSL) / 2.0 : close
float swingRange  = not na(lastSH) and not na(lastSL) ? (lastSH - lastSL) : 0.0
float priceDepth  = swingRange > 0 ? (close - lastSL) / swingRange * 100.0 : 50.0

// Adaptive depth thresholds (volatility-scaled)
float atrPct         = close > 0 ? atr / close * 100.0 : 1.0
float discountThresh = math.max(25.0, 50.0 - atrPct * 5.0)
float premiumThresh  = math.min(75.0, 50.0 + atrPct * 5.0)

bool inDiscount     = priceDepth < 50.0
bool inDeepDiscount = priceDepth <= discountThresh
bool inPremium      = priceDepth > 50.0
bool inDeepPremium  = priceDepth >= premiumThresh

// ─── Liquidity Sweeps ───
bool bullSweep = confirmed and not na(lastSL) and low < lastSL and close > lastSL
bool bearSweep = confirmed and not na(lastSH) and high > lastSH and close < lastSH

float sweepStr   = bullSweep ? rvol : bearSweep ? rvol : 0.0
bool  strongSweep = sweepStr >= rvolP80

// ─── Effective Trend State (Responsive Multi-Factor) ───
// Layer 1: external BOS (highest conviction). Layer 2: internal structure + confluence (early detection).
// Layer 3: momentum exhaustion, run as a POST-PROCESS override so same-bar structural events can't block it.
var int effectiveTrend = 0

// ── Layers 1 & 2: Structural triggers ──
if bullBOS
    effectiveTrend := 1
else if bearBOS
    effectiveTrend := -1
else
    // Layer 2: Internal BOS with confluence = early trend flip (requires at least one supportive HTF)
    bool etBullConf = minorBullBOS and (htf1Bull or htf2Bull or htf3Bull) and (bullStack or volSurge or close > emaM)
    bool etBullSwp  = bullSweep and strongSweep and close > emaF and (htf1Bull or htf2Bull or htf3Bull)
    bool etBearConf = minorBearBOS and (htf1Bear or htf2Bear or htf3Bear) and (bearStack or volSurge or close < emaM)
    bool etBearSwp  = bearSweep and strongSweep and close < emaF and (htf1Bear or htf2Bear or htf3Bear)
    if etBullConf or etBullSwp
        effectiveTrend := 1
    else if etBearConf or etBearSwp
        effectiveTrend := -1

// ── Layer 3: Momentum exhaustion (post-process override, gated by confirmed bar) ──
// Overrides structural trend on bar close when price has clearly reversed vs key EMAs with momentum
// confirming, preventing intrabar repainting.
float emaFChange = ta.change(emaF)

bool bullMomLost = effectiveTrend == 1 and (htf1Bear and htf2Bear) and (
     (close < emaF and close < emaM and close[1] < emaM and rsi < 45.0) or
     (close < emaS) or
     (close < emaF and emaFChange < 0.0) or
     (emaF < emaS)
     )

bool bearMomLost = effectiveTrend == -1 and (htf1Bull and htf2Bull) and (
     (close > emaF and close > emaM and close[1] > emaM and rsi > 55.0) or
     (close > emaS) or
     (close > emaF and emaFChange > 0.0) or
     (emaF > emaS)
     )

if confirmed
    if bullMomLost
        effectiveTrend := -1
    else if bearMomLost
        effectiveTrend := 1

// ── Fix 5: Faster Structural Trend Recovery (gated by confirmed bar) ──
bool bearRecovery = effectiveTrend == -1 and close > emaF and rsi > 55.0 and rvol > 1.5 and close > close[1]
bool bullRecovery = effectiveTrend == 1 and close < emaF and rsi < 45.0 and rvol > 1.5 and close < close[1]
if confirmed
    if bearRecovery
        effectiveTrend := 0
    else if bullRecovery
        effectiveTrend := 0


// ════════════════════════════════════════════════════════════════════════
// §7  SMART MONEY CONCEPTS — OB & FVG WITH MULTI-FACTOR GRADING
// ════════════════════════════════════════════════════════════════════════

// ─── Order Block Arrays (parallel tracking) ───
// P0: the box-typed obArr/fvgArr/bearObArr/bearFvgArr (below and further down) were removed — box drawing
// is permanently disabled (dashboard-only mode, per the comments at each push site), so every box ever
// pushed into them was `na`; box.delete() on an always-na value is a guaranteed no-op, and array.size()
// on a box array that's only ever modified in lockstep with a real parallel array (obTops etc.) returns
// the exact same count that array already provides. They existed purely to track a size and issue no-op
// deletes — every size/shift/remove call below now uses one of the real parallel arrays directly instead.
var array<float> obScores = array.new<float>()
var array<int>   obBars   = array.new<int>()
var array<float> obTops   = array.new<float>()
var array<float> obBots   = array.new<float>()

// OB Scoring: Freshness(25) + Volume(20) + Location(20) + FVG(15) + Trend(10) + Recency(10)
f_obScore(float obRvol, bool isDisc, bool hasFvg, bool trendOK, int age) =>
    float s = 0.0
    s += math.max(0.0, 25.0 - age * 0.5)                            // Freshness decays
    s += obRvol >= nz(rvolP80, 1.5) ? 20.0 : obRvol >= 1.0 ? 12.0 : 5.0  // Volume
    s += isDisc ? 20.0 : 10.0                                        // Location
    s += hasFvg ? 15.0 : 0.0                                         // Imbalance
    s += trendOK ? 10.0 : 0.0                                        // Trend
    s += math.max(0.0, 10.0 - age * 0.2)                             // Recency
    s

// Detect bullish OB (Validated using liquidity sweep + FVG imbalance + volume absorption)
bool sweepLow = low[1] < math.min(low[2], low[3])
bool hasImbalance = (low > high[2]) or (low[1] > high[3])
// Practical OB Detection: balance imbalance/sweep with volume/expansion
bool bullOBdetect = confirmed and close > open and close[1] < open[1] and (hasImbalance or sweepLow) and (bigMove or volSurge)

if bullOBdetect
    bool nearFVG  = low > high[2]
    float sc      = f_obScore(rvol, inDiscount, nearFVG, effectiveTrend == 1, 0)
    array.push(obScores, sc)
    array.push(obBars, bar_index)
    array.push(obTops, math.max(open[1], close[1]))
    array.push(obBots, math.min(open[1], close[1]))

// Cleanup oldest OBs
while array.size(obTops) > i_obMax
    array.shift(obScores)
    array.shift(obBars)
    array.shift(obTops)
    array.shift(obBots)

// Track OB freshness, mitigation counts, and clean up violated OBs
int obCount = array.size(obTops)
if obCount > 0 and confirmed
    for i = obCount - 1 to 0  // Pine v6 auto-detects reverse direction when from > to
        float t = array.get(obTops, i)
        float b = array.get(obBots, i)
        if close < b
            array.remove(obScores, i)
            array.remove(obBars, i)
            array.remove(obTops, i)
            array.remove(obBots, i)
        else if low <= t and high >= b
            // Fix #6: Update score using actual OB age
            int obAge = bar_index - array.get(obBars, i)
            array.set(obScores, i, f_obScore(rvol, inDiscount, true, effectiveTrend == 1, obAge) * 0.5)

obCount := array.size(obTops)
bool  nearBullOB  = false
float bestOBscore = 0.0
if obCount > 0
    for i = 0 to obCount - 1
        float t = array.get(obTops, i)
        float b = array.get(obBots, i)
        float s = array.get(obScores, i)
        if close >= b - atr * 0.3 and close <= t + atr * 0.3
            nearBullOB  := true
            bestOBscore := math.max(bestOBscore, s)

// ─── FVG Arrays ───
var array<float> fvgTops = array.new<float>()
var array<float> fvgBots = array.new<float>()

bool bullFVG = confirmed and low > high[2] and close[1] > open[1]
if bullFVG
    array.push(fvgTops, low)
    array.push(fvgBots, high[2])

while array.size(fvgTops) > i_fvgMax
    array.shift(fvgTops)
    array.shift(fvgBots)

// Is price near an active FVG?
bool nearBullFVG = false
int  fvgCount    = array.size(fvgTops)
if fvgCount > 0
    for i = 0 to fvgCount - 1
        float ft = array.get(fvgTops, i)
        float fb = array.get(fvgBots, i)
        if close >= fb - atr * 0.2 and close <= ft + atr * 0.2
            nearBullFVG := true
            break

// ─── Bearish Order Block & FVG Detection (Short-side Liquidity Parity) ───
bool sweepHigh = high[1] > math.max(high[2], high[3])
bool hasBearImbalance = (high < low[2]) or (high[1] < low[3])
bool bearOBdetect = confirmed and close < open and close[1] > open[1] and (hasBearImbalance or sweepHigh) and (bigMove or volSurge)

var array<float> bearObTops = array.new<float>()
var array<float> bearObBots = array.new<float>()

if bearOBdetect
    array.push(bearObTops, math.max(open[1], close[1]))
    array.push(bearObBots, math.min(open[1], close[1]))

while array.size(bearObTops) > i_obMax
    array.shift(bearObTops)
    array.shift(bearObBots)

// Track Bearish OB freshness and clean up violated Bearish OBs (when close > top)
int bearObCount = array.size(bearObTops)
if bearObCount > 0 and confirmed
    for i = bearObCount - 1 to 0  // Pine v6 auto-detects reverse direction when from > to
        float t = array.get(bearObTops, i)
        if close > t
            array.remove(bearObTops, i)
            array.remove(bearObBots, i)

bool nearBearOB = false
bearObCount := array.size(bearObTops)
if bearObCount > 0
    for i = 0 to bearObCount - 1
        float t = array.get(bearObTops, i)
        float b = array.get(bearObBots, i)
        if close >= b - atr * 0.3 and close <= t + atr * 0.3
            nearBearOB := true

var array<float> bearFvgTops = array.new<float>()
var array<float> bearFvgBots = array.new<float>()

bool bearFVG = confirmed and high < low[2] and close[1] < open[1]
if bearFVG
    array.push(bearFvgTops, low[2])
    array.push(bearFvgBots, high)

while array.size(bearFvgTops) > i_fvgMax
    array.shift(bearFvgTops)
    array.shift(bearFvgBots)

bool nearBearFVG = false
int bearFvgCount = array.size(bearFvgTops)
if bearFvgCount > 0
    for i = 0 to bearFvgCount - 1
        float ft = array.get(bearFvgTops, i)
        float fb = array.get(bearFvgBots, i)
        if close >= fb - atr * 0.2 and close <= ft + atr * 0.2
            nearBearFVG := true
            break


// ════════════════════════════════════════════════════════════════════════
// §8  VOLUME PROFILE & KILL ZONES
// ════════════════════════════════════════════════════════════════════════

var float vpPOC = na, var float vpVAH = na, var float vpVAL = na
var array<float> binVol = array.new<float>(50, 0.0)

// P0: sessProfileLo/Hi/BinStep are a FIXED per-session price grid, established ONCE at session start
// (isFirstBar/isNewDay) — replacing the old approach, which recomputed binStep = (dayHi-dayLo)/i_vpBins
// from the STILL-GROWING dayHi/dayLo on every single bar (dayHi/dayLo only ever widen through the session
// — see their update rule in §4). That meant bin index N represented a narrower price range early in the
// session (small binStep) than it represented later (large binStep) — volume accumulated into binVol[N]
// on bar 1 under one coordinate system got silently summed with volume accumulated into that SAME index
// on bar 50 under a completely different, wider coordinate system, corrupting POC/VAH/VAL (which feed
// structural SL/target selection in §10, not just the on-chart plot). Fixing the grid once at session open
// — sized off adr14 (prior 14-day average daily range) with headroom, falling back to atr before adr14 is
// available — keeps every bar's volume mapped into the SAME coordinate system all session. If the
// session's actual range ever exceeds this fixed grid (rare, given the headroom), the existing loBin/hiBin
// math.min/max clamp below still holds — overflow volume saturates into the boundary bin instead of
// corrupting the grid further, matching the institutional convention of a fixed grid with edge clamping
// over a dynamically-moving one.
var float sessProfileLo = na
var float sessProfileHi = na
var float sessBinStep   = na

// Fix #6: Reset volume profile bins daily on isNewDay and gate on _isUsMkt feed
if isFirstBar or isNewDay
    array.fill(binVol, 0.0)
    float _gridHalfRange = not na(adr14) and adr14 > 0 ? adr14 * 0.75 : atr * 3.0
    sessProfileLo := close - _gridHalfRange
    sessProfileHi := close + _gridHalfRange
    sessBinStep   := (sessProfileHi - sessProfileLo) / i_vpBins

if _isUsMkt and not na(sessBinStep) and sessBinStep > 0
    // P1-10: distribute THIS bar's volume across every bin its OWN [low,high] range actually overlaps,
    // weighted by price-overlap fraction — not dump the whole bar's volume into a single bin selected
    // by close alone. The old version treated "10,000 shares traded $100-$105" as if all 10,000 traded
    // exactly at the closing print; a wide-range bar could single-handedly distort POC/VAH/VAL (which
    // feed structural target selection and R:R calculations) toward wherever it happened to close,
    // regardless of where most of its volume actually printed. Still a bar-close-only approximation
    // (Pine has no intrabar tick/order data to build a literal volume-at-price profile from), but this
    // is the standard proportional-overlap approximation used when only OHLCV is available.
    int loBin = math.min(i_vpBins - 1, math.max(0, math.floor((low  - sessProfileLo) / sessBinStep)))
    int hiBin = math.min(i_vpBins - 1, math.max(0, math.floor((high - sessProfileLo) / sessBinStep)))
    if hiBin > loBin
        float barRange = high - low
        for b = loBin to hiBin
            float binLo = sessProfileLo + b * sessBinStep
            float binHi = binLo + sessBinStep
            float overlapLo = math.max(binLo, low)
            float overlapHi = math.min(binHi, high)
            float overlapFrac = barRange > 0 ? math.max(0.0, overlapHi - overlapLo) / barRange : 0.0
            array.set(binVol, b, array.get(binVol, b) + volume * overlapFrac)
    else
        array.set(binVol, loBin, array.get(binVol, loBin) + volume)

    int   maxBinIdx = 0
    float maxVol    = 0.0
    float totVol    = 0.0
    for b = 0 to i_vpBins - 1
        float v = array.get(binVol, b)
        totVol += v
        if v > maxVol
            maxVol    := v
            maxBinIdx := b

    vpPOC := sessProfileLo + (maxBinIdx + 0.5) * sessBinStep

    float tgtVol = totVol * 0.70
    float cumVol = maxVol
    int   upI    = maxBinIdx
    int   dnI    = maxBinIdx
    while cumVol < tgtVol and (upI < i_vpBins - 1 or dnI > 0)
        float nUp = upI < i_vpBins - 1 ? array.get(binVol, upI + 1) : 0.0
        float nDn = dnI > 0             ? array.get(binVol, dnI - 1) : 0.0
        if nUp >= nDn and upI < i_vpBins - 1
            upI    += 1
            cumVol += nUp
        else if dnI > 0
            dnI    -= 1
            cumVol += nDn
        else if upI < i_vpBins - 1
            upI    += 1
            cumVol += nUp
    vpVAH := sessProfileLo + (upI + 1.0) * sessBinStep
    vpVAL := sessProfileLo + dnI * sessBinStep

// ─── Kill Zones ───
bool inKzNY = not na(time(timeframe.period, i_kzNY))
bool inKzPM = not na(time(timeframe.period, i_kzPM))
bool inKillZone = isCrypto ? true : (i_useKZ ? (inKzNY or inKzPM) : true)

// DISABLED: Dashboard-only mode
bgcolor(na, title="NY Open KZ")
bgcolor(na, title="NY PM KZ")

// ─── Opening Range (ORB 15m / 30m) Engine ───
string orbSessStr = i_orbLen == "15m" ? "0930-0945:1234567" : "0930-1000:1234567"
bool inOrbWindow = not na(time(timeframe.period, orbSessStr, "America/New_York"))

var float orbHi = na
var float orbLo = na
var bool  orbComplete = false


if isNewDay
    orbHi := na
    orbLo := na
    orbComplete := false

if inOrbWindow
    orbHi := na(orbHi) ? high : math.max(orbHi, high)
    orbLo := na(orbLo) ? low  : math.min(orbLo, low)

if not inOrbWindow and inOrbWindow[1] and not na(orbHi)
    orbComplete := true


// ════════════════════════════════════════════════════════════════════════
// §9  ADAPTIVE SCORING ENGINE
// ════════════════════════════════════════════════════════════════════════
// Each factor normalised 0.0–1.0, then multiplied by regime-adaptive weight.

float htfBullN = ((htf1Bull?1.0:0.0) + (htf2Bull?1.0:0.0) + (htf3Bull?1.0:0.0)) / 3.0
float htfBearN = ((htf1Bear?1.0:0.0) + (htf2Bear?1.0:0.0) + (htf3Bear?1.0:0.0)) / 3.0

// 1. Trend Factor (0-100)
float fTrend = (effectiveTrend == 1 ? 0.3 : 0.0) + (htfBullN * 0.5) + (bullStack ? 0.2 : 0.0)
float sTrend = fTrend * 100.0

// 2. Liquidity Factor (0-100)
float fLiquidity = (bullSweep ? 0.3 : 0.0) + (inDeepDiscount ? 0.3 : inDiscount ? 0.15 : 0.0) + (nearBullOB ? 0.2 : 0.0) + (nearBullFVG ? 0.2 : 0.0)
float sLiq = fLiquidity * 100.0

// 3. Momentum Factor (0-100)
float fMomentum = (rsi > rsiCenter ? 0.4 : 0.0) + (mfi > mfiCenter ? 0.3 : 0.0) + (minorBullBOS ? 0.3 : 0.0)
float sMom = fMomentum * 100.0

// 4. Breadth / Relative Strength Factor (0-100) — Fix Issue #5: Eliminate basket double counting
float sBreadth = mktBreadthPct
float fRelStrength = sBreadth / 100.0

// 5. Execution / Volatility Factor (0-100) — Fix Issue #9: Active integration of fVolatility
float fVolatility = (adrOK ? 0.3 : 0.0) + (adxStrong ? 0.4 : 0.0) + (not isExpansion ? 0.3 : 0.0)
float fExec = (inKillZone ? 0.35 : 0.0) + (adrOK ? 0.25 : 0.0) + ((rsi >= 30.0 and rsi <= 75.0) ? 0.20 : 0.0) + fVolatility * 0.20
float sExec = fExec * 100.0

// Calculate dynamic weights (cached to execute ONLY when a trade closes or first bar for 99%+ speedup)
// Two independent, differently-scaled warmup schedules govern how much this model trusts its own trade
// history — worth reading together since neither references the other: this factor-weight learning below
// unlocks at totalTrades>=5, but f_calcExpectancyWeight's own N_lag = max(5, winLen/4) walk-forward
// exclusion (see its definition) discards the most recent trades from that estimate, so real (non-default-
// fallback) learning effectively doesn't kick in until roughly trade 10. Kelly sizing runs on a separate,
// slower schedule entirely — see kellyConfidence and i_kellyMinTrades (default 30) further down.
var float wTrend = 30.0
var float wLiq   = 25.0
var float wMom   = 20.0
var float wRs    = 15.0
var float wVol   = 10.0

if totalTrades != totalTrades[1] or bar_index == 1
    wTrend := totalTrades >= 5 ? f_calcExpectancyWeight(histTrendVal, histOutcome, histBars, 30.0, i_rollWin, totalTrades, histIdx) : 30.0
    wLiq   := totalTrades >= 5 ? f_calcExpectancyWeight(histLiqVal,   histOutcome, histBars, 25.0, i_rollWin, totalTrades, histIdx) : 25.0
    wMom   := totalTrades >= 5 ? f_calcExpectancyWeight(histMomVal,   histOutcome, histBars, 20.0, i_rollWin, totalTrades, histIdx) : 20.0
    wRs    := totalTrades >= 5 ? f_calcExpectancyWeight(histRsVal,    histOutcome, histBars, 15.0, i_rollWin, totalTrades, histIdx) : 15.0
    wVol   := totalTrades >= 5 ? f_calcExpectancyWeight(histVolVal,   histOutcome, histBars, 10.0, i_rollWin, totalTrades, histIdx) : 10.0

// Fix Issue #6: Degenerate weight guard check (triggerable when weights floor at 0.1)
float rawDynW = wTrend + wLiq + wMom + wRs + wVol
weightDegen := rawDynW <= 5.0
if weightDegen
    wTrend := 30.0
    wLiq   := 25.0
    wMom   := 20.0
    wRs    := 15.0
    wVol   := 10.0
float totalDynW = wTrend + wLiq + wMom + wRs + wVol
float normWTrend = wTrend / totalDynW * 100.0
float normWLiq   = wLiq / totalDynW * 100.0
float normWMom   = wMom / totalDynW * 100.0
float normWRs    = wRs / totalDynW * 100.0
float normWVol   = wVol / totalDynW * 100.0

// Calibrated weights for Institutional Setup Quality (prior weights sum to 1.00: 0.40 + 0.25 + 0.15 + 0.10 + 0.10 = 1.00)
float wTrendCal   = normWTrend * 0.40
float wMomCal     = normWMom * 0.25
float wBreadthCal = normWRs * 0.15
float wLiqCal     = normWLiq * 0.10
float wExecCal    = normWVol * 0.10
float totalCal    = wTrendCal + wMomCal + wBreadthCal + wLiqCal + wExecCal
// Composite long-setup score (0-100) — the entry-setup conviction score, distinct from the per-horizon
// forecast confidence computed by f_calcConf.
float sComposite  = totalCal > 0 ? (sTrend * wTrendCal + sMom * wMomCal + sBreadth * wBreadthCal + sLiq * wLiqCal + sExec * wExecCal) / totalCal : 50.0
compP90 := f_percentileThresh(sComposite[1], 90, 90.0)
compP75 := f_percentileThresh(sComposite[1], 75, 75.0)
compP60 := f_percentileThresh(sComposite[1], 60, 60.0)
compP45 := f_percentileThresh(sComposite[1], 45, 45.0)

// Fix #9: Harmonize minScore gate with 60th percentile (compP60) so B-grade setups pass confidence gate
float minScore = compP60
string setupGrade = f_grade(sComposite, compP90, compP75, compP60, compP45)

// Bear confidence (Full 4-factor OB/FVG structural precision parity)
float fTrendBear       = (effectiveTrend == -1 ? 0.3 : 0.0) + (htfBearN * 0.5) + (bearStack ? 0.2 : 0.0)
float sTrendBear       = fTrendBear * 100.0
float fLiquidityBear   = (bearSweep ? 0.3 : 0.0) + (inDeepPremium ? 0.3 : inPremium ? 0.15 : 0.0) + (nearBearOB ? 0.2 : 0.0) + (nearBearFVG ? 0.2 : 0.0)
float sLiqBear         = fLiquidityBear * 100.0
float fMomentumBear    = (rsi < rsiCenter ? 0.4 : 0.0) + (mfi < mfiCenter ? 0.3 : 0.0) + (minorBearBOS ? 0.3 : 0.0)
float sMomBear         = fMomentumBear * 100.0
// Fix Issue #5: Bear breadth avoids double counting basket
float sBreadthBear     = 100.0 - mktBreadthPct
float fRelStrengthBear = sBreadthBear / 100.0
float fVolatilityBear  = fVolatility
// Fix Issue #9: fVolatilityBear integration into fExecBear
float fExecBear        = (inKillZone ? 0.35 : 0.0) + (adrOK ? 0.25 : 0.0) + ((rsi >= 25.0 and rsi <= 70.0) ? 0.20 : 0.0) + fVolatilityBear * 0.20
float sExecBear        = fExecBear * 100.0

// Fix Issue #8: Direction-aware expectancy weights for bear setups
float wTrendCalBear   = normWTrend * 0.40
float wMomCalBear     = normWMom * 0.25
float wBreadthCalBear = normWRs * 0.15
float wLiqCalBear     = normWLiq * 0.10
float wExecCalBear    = normWVol * 0.10
float totalCalBear    = wTrendCalBear + wMomCalBear + wBreadthCalBear + wLiqCalBear + wExecCalBear
float rawBearScore     = totalCalBear > 0 ? (sTrendBear * wTrendCalBear + sMomBear * wMomCalBear + sBreadthBear * wBreadthCalBear + sLiqBear * wLiqCalBear + sExecBear * wExecCalBear) / totalCalBear : 50.0
float bearConf         = rawBearScore

// Fix #5: Independent dynamic percentile threshold for short-side score
var float bearP90 = 85.0, var float bearP75 = 75.0, var float bearP60 = 65.0, var float bearP45 = 55.0
bearP90 := f_percentileThresh(bearConf[1], 90, 85.0)
bearP75 := f_percentileThresh(bearConf[1], 75, 75.0)
bearP60 := f_percentileThresh(bearConf[1], 60, 65.0)
bearP45 := f_percentileThresh(bearConf[1], 45, 55.0)

string shortGrade = f_grade(bearConf, bearP90, bearP75, bearP60, bearP45)
float bearMinScore = bearP60

// ─── Hourly Projection Pre-compute & Continuous MTF Trend ───
// T_ST: momentum-first signal (price vs EMAs, RSI, candle direction, HTF alignment) with effectiveTrend
// as a secondary bias, so projections follow live price action, not just structure.
float momScore = (close > emaF ? 0.15 : -0.15) + (close > emaM ? 0.15 : -0.15) + (rsi > 50.0 ? 0.15 : -0.15) + (bullStack ? 0.10 : bearStack ? -0.10 : 0.0) + (close > close[1] ? 0.10 : close < close[1] ? -0.10 : 0.0) + (htfBullN - htfBearN) * 0.20
float structBias = effectiveTrend * 0.15
float T_ST = math.max(-1.0, math.min(1.0, momScore + structBias))

float h1Atr = not na(htf1Atr) and htf1Atr > 0 ? htf1Atr : atr
float h2Atr = not na(htf2Atr) and htf2Atr > 0 ? htf2Atr : atr
float h3Atr = not na(htf3Atr) and htf3Atr > 0 ? htf3Atr : atr

float T_1D = math.max(-1.0, math.min(1.0, (htf1Close - htf1Ema) / (2.0 * h1Atr)))
float T_4H = math.max(-1.0, math.min(1.0, (htf2Close - htf2Ema) / (2.0 * h2Atr)))
float T_1H = math.max(-1.0, math.min(1.0, (htf3Close - htf3Ema) / (2.0 * h3Atr)))

// ─── Mean Reversion Engine ───
float rsiMR = 0.0
if rsi < 30.0
    rsiMR := (30.0 - rsi) / 30.0
else if rsi > 70.0
    // Fix: Do not penalize RSI > 70 as negative if market is holding strong bullish trend momentum
    rsiMR := (effectiveTrend == 1 and close >= close[1]) ? 0.0 : (70.0 - rsi) / 30.0

float eqDist = equilibrium > 0 ? (equilibrium - close) / (atr * 3.0) : 0.0
float eqMR = math.max(-1.0, math.min(1.0, eqDist))

// Fix: In strong bullish markup, price trading above equilibrium is trend continuation, not immediate drop
if effectiveTrend == 1 and close >= close[1]
    eqMR := math.max(0.0, eqMR)
else if effectiveTrend == -1 and close <= close[1]
    eqMR := math.min(0.0, eqMR)

float biasMR = rsiMR * 0.4 + eqMR * 0.6

// Blend weight determination based on regime & oversold/overbought exhaustion
float trendWeight = 1.0
if regime == "Mean Reversion" or regime == "Accumulation/Distribution"
    trendWeight := 0.3
else if regime == "Volatility Contraction"
    trendWeight := 0.5
else if regime == "Volatility Expansion"
    trendWeight := 0.60
else if regime == "Pullback"
    trendWeight := 0.7
else if regime == "Trend (Markup)" or regime == "Trend (Markdown)"
    trendWeight := 0.95

// Scale down trend weight if RSI is highly overextended (exhaustion), unless aligned with strong trend
if (rsi >= 75.0 and effectiveTrend != 1) or (rsi <= 25.0 and effectiveTrend != -1)
    trendWeight := trendWeight * 0.5

// ─── Adaptive Forecast Weights via Rolling Correlation & Benchmark Confluence ───
// 1-bar realized return of the completed bar against prior bar forecast
float realizedBarRet = close / close[1] - 1.0

// Priority 10: Rolling correlation of SOXL with Benchmark Index (ICESEMIT), Basket, QQQ, and Timeframes
// P0: indexReturn/basketRetSum/qqqRetRaw now lagged [1], matching T_ST[1]/T_1H[1]/T_4H[1]/T_1D[1] just
// below — without the lag these three measured CONTEMPORANEOUS co-movement (this bar's index return vs.
// this bar's SOXL return: "did they move together"), then got used downstream as corrReliabilityIndex/
// Basket/QQQ to weight how much each factor's PRIOR value should predict this bar's return — a predictive
// claim a same-bar correlation can't support. Lagging measures the same thing T_ST[1] etc. already
// correctly measure: does last bar's factor value predict this bar's realized return.
float corrIndex  = ta.correlation(indexReturn[1],  realizedBarRet, i_rollWin)
float corrBasket = ta.correlation(basketRetSum[1], realizedBarRet, i_rollWin)
float corrQQQ    = ta.correlation(qqqRetRaw[1],    realizedBarRet, i_rollWin)
float corrST     = ta.correlation(T_ST[1],       realizedBarRet, i_rollWin)
float corr1H     = ta.correlation(T_1H[1],       realizedBarRet, i_rollWin)
float corr4H     = ta.correlation(T_4H[1],       realizedBarRet, i_rollWin)
float corr1D     = ta.correlation(T_1D[1],       realizedBarRet, i_rollWin)

int smoothLen   = math.max(20, i_rollWin)
float sCorrIndex  = ta.ema(math.max(0.0, nz(corrIndex, 0.45)), smoothLen)
float sCorrBasket = ta.ema(math.max(0.0, nz(corrBasket, 0.25)), smoothLen)
float sCorrQQQ    = ta.ema(math.max(0.0, nz(corrQQQ, 0.15)), smoothLen)
float sCorrST     = ta.ema(math.max(0.0, nz(corrST, 0.10)), smoothLen)
float sCorr1H     = ta.ema(math.max(0.0, nz(corr1H, 0.10)), smoothLen)
float sCorr4H     = ta.ema(math.max(0.0, nz(corr4H, 0.10)), smoothLen)
float sCorr1D     = ta.ema(math.max(0.0, nz(corr1D, 0.10)), smoothLen)

// ─── Priority 13: Adaptive Evidence Weighting Engine (online mixture-of-factors, NOT Bayesian) ───
// This is a directional-hit-rate-weighted evidence blend: L_index etc. are EWMA hit-rate trackers, not
// P(data|hypothesis) likelihoods, and correlation isn't a likelihood term either — there is no formal
// generative model or likelihood function here, so "prior"/"posterior" below are used only as informal
// labels for "starting weight" / "evidence-reweighted allocation," not as claims of a real Bayesian update.
// Starting weights: Benchmark (0.45), Basket (0.25), QQQ (0.15), Macro (0.10), Momentum (0.05).
var float priorIndex  = 0.45
var float priorBasket = 0.25
var float priorQQQ    = 0.15
var float priorMacro  = 0.10
var float priorMom    = 0.05

// Directional Likelihood Hit Testing against previous bar return
bool hitIndex  = bar_index > 1 and ((indexReturn[1] >= 0 and realizedBarRet >= 0) or (indexReturn[1] < 0 and realizedBarRet < 0))
bool hitBasket = bar_index > 1 and ((basketRetSum[1] >= 0 and realizedBarRet >= 0) or (basketRetSum[1] < 0 and realizedBarRet < 0))
bool hitQQQ    = bar_index > 1 and ((qqqRetRaw[1] >= 0 and realizedBarRet >= 0) or (qqqRetRaw[1] < 0 and realizedBarRet < 0))
bool hitMacro  = bar_index > 1 and ((macroBias[1] >= 0 and realizedBarRet >= 0) or (macroBias[1] < 0 and realizedBarRet < 0))
bool hitMom    = bar_index > 1 and ((T_ST[1] >= 0 and realizedBarRet >= 0) or (T_ST[1] < 0 and realizedBarRet < 0))

var float L_index  = 0.50
var float L_basket = 0.50
var float L_qqq    = 0.50
var float L_macro  = 0.50
var float L_mom    = 0.50

// P1-15: hit credit is now scaled by how BIG the realized move actually was (magNorm, in ATR units),
// not a flat 0.85/0.15 for any hit/miss regardless of magnitude. A forecast that matched a +0.01% wobble
// and one that matched a +2.5% move used to earn the SAME credit — magNorm=0 (no real move) now credits
// hits/misses at 0.50 (uninformative, correctly so: a coin flip on a dead bar tells you nothing about the
// factor's skill), scaling up to the original 0.85/0.15 ceiling only once the move reaches roughly a full
// ATR. This is still a one-bar-ahead learning signal (not rank IC / MSE / log loss / return capture across
// a proper holdout — those would need a much larger restructuring of what history is tracked and are a
// separate, larger undertaking), but it stops treating razor-thin and decisive moves as equally strong
// evidence, which was the specific, cheaply-fixable part of the complaint.
float magNorm = atr > 0 ? math.min(1.0, math.abs(realizedBarRet) * close / atr) : 0.5
float hitCreditIndex  = hitIndex  ? (0.50 + 0.35 * magNorm) : (0.50 - 0.35 * magNorm)
float hitCreditBasket = hitBasket ? (0.50 + 0.35 * magNorm) : (0.50 - 0.35 * magNorm)
float hitCreditQQQ    = hitQQQ    ? (0.50 + 0.35 * magNorm) : (0.50 - 0.35 * magNorm)
float hitCreditMacro  = hitMacro  ? (0.50 + 0.35 * magNorm) : (0.50 - 0.35 * magNorm)
float hitCreditMom    = hitMom    ? (0.50 + 0.35 * magNorm) : (0.50 - 0.35 * magNorm)

if confirmed
    L_index  := bar_index < 20 ? 0.50 : (1.0 - C_EWMA_A) * L_index  + C_EWMA_A * hitCreditIndex
    L_basket := bar_index < 20 ? 0.50 : (1.0 - C_EWMA_A) * L_basket + C_EWMA_A * hitCreditBasket
    L_qqq    := bar_index < 20 ? 0.50 : (1.0 - C_EWMA_A) * L_qqq    + C_EWMA_A * hitCreditQQQ
    L_macro  := bar_index < 20 ? 0.50 : (1.0 - C_EWMA_A) * L_macro  + C_EWMA_A * hitCreditMacro
    L_mom    := bar_index < 20 ? 0.50 : (1.0 - C_EWMA_A) * L_mom    + C_EWMA_A * hitCreditMom

// Issue 2: Replace R² (math.pow(corr,2)) with linear correlation as reliability scalar.
// R² is a variance-explained metric, not a weighting term this evidence blend should be using raw.
// Linear |corr| bounded to [0,1] correctly represents signal reliability.
float corrReliabilityIndex  = math.max(0.0, math.min(1.0, sCorrIndex))
float corrReliabilityBasket = math.max(0.0, math.min(1.0, sCorrBasket))
float corrReliabilityQQQ    = math.max(0.0, math.min(1.0, sCorrQQQ))
float corrReliabilityST     = math.max(0.0, math.min(1.0, sCorrST))
float postIndex  = L_index  * priorIndex  * corrReliabilityIndex
float postBasket = L_basket * priorBasket * corrReliabilityBasket
float postQQQ    = L_qqq    * priorQQQ    * corrReliabilityQQQ
float postMacro  = L_macro  * priorMacro
float postMom    = L_mom    * priorMom    * corrReliabilityST
float postTotal  = postIndex + postBasket + postQQQ + postMacro + postMom

// Evidence-Reweighted Normalized Allocation (online mixture-of-factors, not a Bayesian posterior)
float bIndex  = postTotal > 0 ? postIndex  / postTotal : 0.45
float bBasket = postTotal > 0 ? postBasket / postTotal : 0.25
float bQQQ    = postTotal > 0 ? postQQQ    / postTotal : 0.15
float bMacro  = postTotal > 0 ? postMacro  / postTotal : 0.10
float bMom    = postTotal > 0 ? postMom    / postTotal : 0.05

float nwIndex  = ta.ema(bIndex,  smoothLen)
float nwBasket = ta.ema(bBasket, smoothLen)
float nwQQQ    = ta.ema(bQQQ,    smoothLen)
float nwMacro  = ta.ema(bMacro,  smoothLen)
float nwST     = ta.ema(bMom,    smoothLen)
float nw1H     = nwST * 0.8
float nw4H     = nwST * 0.6
float nw1D     = nwST * 0.4

// P1-13: NVDA/AMD/QQQ/the semiconductor index/SOXL are not independent evidence sources — basketRetSum and
// qqqRetRaw both largely re-express the SAME semiconductor-sector risk indexReturn already carries (index
// is itself a semiconductor benchmark, and QQQ is heavily semiconductor-overweighted via NVDA/AVGO/etc).
// Blended raw, expectedIndexReturn effectively counted that shared semiconductor risk two or three times
// over. Fix: residualize the two secondary, overlapping factors against the primary one (indexReturn, the
// highest-prior/most-direct factor) via simple OLS beta — same corr*stdev/stdev formula already used for
// rollingBeta just below — keeping only the part of basket's/QQQ's return that indexReturn's own
// coefficient doesn't already explain. This is single-factor residualization against the dominant common
// factor, not a full N-way Gram-Schmidt across all 5 evidence factors (macro and momentum are structurally
// different data sources — yield/DXY/VIX and price-action-derived signals respectively — residualizing
// those against each other too would be a separate, larger undertaking); it directly targets the specific
// double-counted pair named (basket/QQQ vs. index), not a complete orthogonal factor system.
float stdevIndexOrtho = ta.stdev(indexReturn, i_rollWin)
float betaBasketOnIdx = (not na(stdevIndexOrtho) and stdevIndexOrtho > 0.00001) ? nz(ta.correlation(basketRetSum, indexReturn, i_rollWin)) * (ta.stdev(basketRetSum, i_rollWin) / stdevIndexOrtho) : 0.0
float betaQQQOnIdx    = (not na(stdevIndexOrtho) and stdevIndexOrtho > 0.00001) ? nz(ta.correlation(qqqRetRaw,    indexReturn, i_rollWin)) * (ta.stdev(qqqRetRaw,    i_rollWin) / stdevIndexOrtho) : 0.0
float basketResidual  = basketRetSum - betaBasketOnIdx * indexReturn
float qqqResidual     = qqqRetRaw    - betaQQQOnIdx    * indexReturn

// ─── Priority 1 & 2: Expected Benchmark Index & SOXL Return Model ───
// Quantitative return forecast ($R_{\text{index}}$) driven by the adaptive evidence weights above — uses
// the ORTHOGONALIZED basket/QQQ residuals above, not their raw (index-correlated) returns.
float expectedIndexReturn = indexReturn * nwIndex + basketResidual * nwBasket + qqqResidual * nwQQQ + (macroAdj * 0.002) * nwMacro

// Dynamic Rolling Beta Estimation (Beta = Corr(SOXL, Index) * StDev(SOXL) / StDev(Index))
// P0-5: rollingBeta/effectiveLeverage are an OBSERVED statistical sensitivity, not SOXL's actual leverage —
// SOXL mechanically resets to 3x (i_leverage) exposure every day regardless of what a trailing correlation/
// stdev ratio measures over i_rollWin bars. Substituting the observed beta for the mechanical constant let a
// noisy sample (thin index feed, short window, temporary decorrelation) silently understate or overstate the
// real contractual multiplier. rollingBeta/effectiveLeverage are still computed below as a diagnostic — e.g.
// to flag when observed sensitivity drifts far from the mechanical 3x — but expectedSOXLReturn now always
// multiplies by the mechanical i_leverage, with beta available as a feature rather than a substitute for it.
float corrSOXLIndex = ta.correlation(realizedBarRet, indexReturn, i_rollWin)
float stdevSOXL     = ta.stdev(realizedBarRet, i_rollWin)
float stdevIndex    = ta.stdev(indexReturn, i_rollWin)
float rollingBeta   = (not na(stdevIndex) and stdevIndex > 0.00001 and not na(corrSOXLIndex)) ? corrSOXLIndex * (stdevSOXL / stdevIndex) : i_leverage
// SOXL is a mechanically 3x-long product — a measured NEGATIVE rolling beta means the sample is broken
// (bad/stale index feed, tiny i_rollWin noise), not a genuine sign flip. Clamping it into [1.5, 4.5] used
// to silently turn e.g. -0.8 into +1.5 (a full-strength long multiplier from a negative reading); falling
// back to the static i_leverage instead treats an unstable/negative reading as "untrustworthy," not "flip it positive."
// Diagnostic only (see note above) — expectedSOXLReturn uses the mechanical i_leverage, not this.
// Clamp band is [0.5x, 1.5x] of the CONFIGURED i_leverage, not a hardcoded [1.5, 4.5] — the original
// literal bounds silently assumed a 3x product (0.5*3=1.5, 1.5*3=4.5) and would wrongly squash this
// diagnostic toward 1.5-4.5 for e.g. i_leverage=1.0 (unleveraged) or -3.0 (inverse) configs. Scaling by
// math.abs(i_leverage) reproduces the original 1.5-4.5 band exactly when i_leverage=3 (the default).
float leverageAbs = math.abs(i_leverage)
float effectiveLeverage = rollingBeta > 0 ? math.max(leverageAbs * 0.5, math.min(leverageAbs * 1.5, rollingBeta)) : i_leverage

// P0: mechanical 3x component (expectedIndexReturn * i_leverage, per P0-5) + a small learned historical
// TRACKING component (avgDailyTrackingResidual, updated in §9's synthetic-NAV block from REAL realized
// SOXL-vs-mechanical-model daily differences — futures roll cost, borrow cost, rebalance slippage, and
// other frictions the expense-ratio + variance-drag terms don't individually model) — instead of treating
// the mechanical replication as exact. avgDailyTrackingResidual is a DAILY-scale quantity; _barsPerDayTR
// converts it to this bar's timeframe so it's not added at the wrong scale (recomputed inline via
// timeframe.* built-ins — no forward-reference issue — rather than reusing barsPerDayNd/barsPerDay, which
// aren't computed until later in the file). Gated at 10 resolved days so an unseasoned residual (near its
// 0.0 seed) can't nudge the forecast before it reflects anything real.
float _tfMinsForTR      = timeframe.isminutes ? timeframe.multiplier : (timeframe.isdaily ? 390.0 : (timeframe.isweekly ? 1950.0 : 7800.0))
float _barsPerDayTR     = math.max(1.0, 390.0 / math.max(1.0, _tfMinsForTR))
float trackingResidualPerBar = trackingResidualN >= 10.0 ? avgDailyTrackingResidual / _barsPerDayTR : 0.0
float expectedSOXLReturn  = expectedIndexReturn * i_leverage + (T_ST * 0.001) * nwST + trackingResidualPerBar

// Fix Issue #2: Model A (Adaptive Evidence Blend + Rolling Beta) Normalized Bias Output
float modelABias = math.max(-1.0, math.min(1.0, expectedSOXLReturn * 100.0 / math.max(0.01, (atr / close) * 100.0)))

// ─── Closing Strength (institutional accumulation/distribution) ───
float closingStrength = (not na(dayHi) and not na(dayLo) and dayHi > dayLo) ? (close - dayLo) / (dayHi - dayLo) : 0.5
float csBias = (closingStrength - 0.5) * 2.0  // Normalized -1 to +1

// ─── Adaptive EOD/Next-Day Factor Weighting (walk-forward correlation) ───
// biasEOD_trend's T_ST/T_1H/T_4H/T_1D weights adapt toward whichever timeframe has actually been
// predictive (each factor's value ~1 trading day ago, correlated non-repainting against the return
// realized since), while preserving the original 2.5 total amplitude rather than normalizing it away.
// corrT1DNd/corrT4HNd/barsPerDayNd/retSinceYest are reused further down for tomRegBias's own weighting.
float tradingDaysNd = syminfo.type == "crypto" ? 365.0 : syminfo.type == "forex" ? 260.0 : 252.0
float minsPerDayNd  = syminfo.type == "crypto" ? 1440.0 : syminfo.type == "forex" ? 1440.0 : 390.0
float barsPerYearNd = timeframe.isdaily ? tradingDaysNd :
     timeframe.isweekly ? 52.0 :
     timeframe.ismonthly ? 12.0 :
     timeframe.isminutes ? tradingDaysNd * minsPerDayNd / timeframe.multiplier :
     tradingDaysNd
int barsPerDayNd    = math.max(1, math.round(barsPerYearNd / tradingDaysNd))
float retSinceYest  = close[barsPerDayNd] > 0 ? (close - close[barsPerDayNd]) / close[barsPerDayNd] : 0.0
float corrTSTNd     = ta.correlation(T_ST[barsPerDayNd], retSinceYest, i_rollWin)
float corrT1HNd     = ta.correlation(T_1H[barsPerDayNd], retSinceYest, i_rollWin)
float corrT4HNd     = ta.correlation(T_4H[barsPerDayNd], retSinceYest, i_rollWin)
float corrT1DNd     = ta.correlation(T_1D[barsPerDayNd], retSinceYest, i_rollWin)
float sCorrTST_eod  = ta.ema(math.max(0.0, nz(corrTSTNd, 0.30)), smoothLen)
float sCorrT1H_eod  = ta.ema(math.max(0.0, nz(corrT1HNd, 0.50)), smoothLen)
float sCorrT4H_eod  = ta.ema(math.max(0.0, nz(corrT4HNd, 0.70)), smoothLen)
float sCorrT1D_eod  = ta.ema(math.max(0.0, nz(corrT1DNd, 1.00)), smoothLen)
float sumCorrEod    = sCorrTST_eod + sCorrT1H_eod + sCorrT4H_eod + sCorrT1D_eod
float wTST_eod = sumCorrEod > 0 ? sCorrTST_eod / sumCorrEod * 2.5 : 0.3
float wT1H_eod = sumCorrEod > 0 ? sCorrT1H_eod / sumCorrEod * 2.5 : 0.5
float wT4H_eod = sumCorrEod > 0 ? sCorrT4H_eod / sumCorrEod * 2.5 : 0.7
float wT1D_eod = sumCorrEod > 0 ? sCorrT1D_eod / sumCorrEod * 2.5 : 1.0

// ─── Adaptive Hourly-Ladder Weighting (walk-forward correlation, horizon-interpolated) ───
// Each of the 8 ladder horizons (30m..6H) gets its own reliability weighting without 8 more
// ta.correlation() calls: interpolates between sCorrST/1H/4H/1D (reliability 1 bar ahead) and
// sCorrTST_eod/T1H_eod/T4H_eod/T1D_eod (reliability ~1 trading day ahead) by how far the horizon sits
// between those two endpoints. Packed into one function (f_adaptBiasTrend) — inlining all 8 horizons in
// the main body previously tripped Pine's "main body too long" limit. An excluded factor (e.g. 30m/45m
// never use T_1D) is passed as tVal=0.0 AND origW=0.0 together, zeroing both its output contribution and
// its share of the redistributed weight budget. Each horizon's original total amplitude is preserved
// rather than renormalized, matching the biasEOD_trend/tomRegBias pattern.
f_adaptBiasTrend(float hzMin, float dayMin, float tST, float t1H, float t4H, float t1D, float origST, float orig1H, float orig4H, float orig1D, bool useNw) =>
    float frac = math.max(0.0, math.min(1.0, hzMin / math.max(1.0, dayMin)))
    float relST = math.max(0.0, sCorrST * (1.0 - frac) + sCorrTST_eod * frac)
    float rel1H = math.max(0.0, sCorr1H * (1.0 - frac) + sCorrT1H_eod * frac)
    float rel4H = math.max(0.0, sCorr4H * (1.0 - frac) + sCorrT4H_eod * frac)
    float rel1D = math.max(0.0, sCorr1D * (1.0 - frac) + sCorrT1D_eod * frac)
    float origSum = origST + orig1H + orig4H + orig1D
    float relSum  = relST + rel1H + rel4H + rel1D
    float wST = relSum > 0 ? relST / relSum * origSum : origST
    float w1H = relSum > 0 ? rel1H / relSum * origSum : orig1H
    float w4H = relSum > 0 ? rel4H / relSum * origSum : orig4H
    float w1D = relSum > 0 ? rel1D / relSum * origSum : orig1D
    float mST = useNw ? nwST : 1.0
    float m1H = useNw ? nw1H : 1.0
    float m4H = useNw ? nw4H : 1.0
    float m1D = useNw ? nw1D : 1.0
    math.max(-1.0, math.min(1.0, tST * (mST * wST) + t1H * (m1H * w1H) + t4H * (m4H * w4H) + t1D * (m1D * w1D)))

float bias30m_trend = f_adaptBiasTrend(30.0,  minsPerDayNd, T_ST, T_1H, T_4H, 0.0,  1.4,  0.8,  0.3,  0.0, true)
float bias45m_trend = f_adaptBiasTrend(45.0,  minsPerDayNd, T_ST, T_1H, T_4H, 0.0,  1.35, 1.0,  0.4,  0.0, true)
float bias1H_trend  = f_adaptBiasTrend(60.0,  minsPerDayNd, T_ST, T_1H, T_4H, T_1D, 1.3,  1.2,  0.6,  0.2, true)
float bias2H_trend  = f_adaptBiasTrend(120.0, minsPerDayNd, T_ST, T_1H, T_4H, T_1D, 0.8,  1.2,  0.9,  0.4, true)
float bias3H_trend  = f_adaptBiasTrend(180.0, minsPerDayNd, T_ST, T_1H, T_4H, T_1D, 0.4,  0.9,  1.2,  0.7, true)
float bias4H_trend  = f_adaptBiasTrend(240.0, minsPerDayNd, 0.0,  T_1H, T_4H, T_1D, 0.0,  0.6,  1.3,  1.2, true)
float bias5H_trend  = f_adaptBiasTrend(300.0, minsPerDayNd, 0.0,  T_1H, T_4H, T_1D, 0.0,  0.3,  1.1,  1.5, true)
float bias6H_trend  = f_adaptBiasTrend(360.0, minsPerDayNd, 0.0,  T_1H, T_4H, T_1D, 0.0,  0.2,  0.9,  1.8, true)
float biasEOD_trend = math.max(-1.0, math.min(1.0, T_ST * (nwST * wTST_eod) + T_1H * (nw1H * wT1H_eod) + T_4H * (nw4H * wT4H_eod) + T_1D * (nw1D * wT1D_eod) + csBias * 0.2 + (effectiveTrend * 0.20)))

// Blended biases (Respect regime weight for EOD forecast, clamp hourly biases, and wire Model A into pathway)
// bias30m_trend/bias45m_trend are now declared earlier alongside bias1H_trend..bias6H_trend (adaptive
// weighting block) so they share the same horizon-interpolated reliability computation.
float trendWeightEOD = math.max(0.30, trendWeight)
float bias30m = math.max(-1.0, math.min(1.0, (bias30m_trend * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias45m = math.max(-1.0, math.min(1.0, (bias45m_trend * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias1H  = math.max(-1.0, math.min(1.0, (bias1H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias2H  = math.max(-1.0, math.min(1.0, (bias2H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias3H  = math.max(-1.0, math.min(1.0, (bias3H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias4H  = math.max(-1.0, math.min(1.0, (bias4H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias5H  = math.max(-1.0, math.min(1.0, (bias5H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))
float bias6H  = math.max(-1.0, math.min(1.0, (bias6H_trend  * trendWeight + biasMR * (1.0 - trendWeight)) * 0.75 + modelABias * 0.25))

// P1-27: REMOVED — this block used to force bias30m..bias6H to a minimum +0.05 whenever effectiveTrend==1
// (and a maximum -0.05 whenever effectiveTrend==-1), regardless of what the underlying blended computation
// actually produced. That guarantees the model can never express a bearish short-term forecast during a
// bullish regime (or vice versa) — the forecast is not allowed to disagree with the regime it's embedded
// in. Statistically this is backwards: forcing agreement improves visual consistency but actively damages
// calibration, since genuine regime/momentum disagreement (e.g. an extended bull trend showing signs of a
// short-term pullback) is real information a forecast should be free to express, not suppress. bias30m
// through bias6H below are now exactly the blended values computed above them, unmodified.
float rawBiasEOD = (biasEOD_trend * trendWeightEOD + biasMR * (1.0 - trendWeightEOD)) * 0.75 + modelABias * 0.25

// Align rawBiasEOD direction with blended hourly forecast to prevent directional divergence
float blendedHourlyAvg = (bias1H + bias2H + bias3H + bias4H + bias5H + bias6H) / 6.0
if (blendedHourlyAvg > 0.05 and rawBiasEOD < 0) or (blendedHourlyAvg < -0.05 and rawBiasEOD > 0)
    rawBiasEOD := rawBiasEOD * 0.3 + blendedHourlyAvg * 0.7

// P1-27: same removal as above — biasEOD used to be floored/ceilinged to stay aligned with effectiveTrend
// (min +0.02 in a bull regime, max -0.02 in a bear regime). Now it's exactly rawBiasEOD: free to disagree
// with the regime tag when the underlying blend actually says so.
float biasEOD = rawBiasEOD

// ─── Pre & Post & Overnight Session Biases (adaptive, same f_adaptBiasTrend engine as the hourly ladder).
// Representative horizons: Pre ~5.5h, Post ~4h, Overnight ~8h (exceeds a trading day, so its reliability
// clamps fully to the ~1-day estimate). useNw=false — these three never used nwST/nw1H/nw4H/nw1D.
float biasPre_trend  = f_adaptBiasTrend(330.0, minsPerDayNd, T_ST, 0.0,  T_4H, T_1D, 0.2, 0.0, 0.4, 0.4, false)
float biasPost_trend = f_adaptBiasTrend(240.0, minsPerDayNd, T_ST, T_1H, T_4H, 0.0,  0.4, 0.4, 0.2, 0.0, false)
// Overnight is the furthest-out horizon before pre-market, so it leans most heavily on daily/4H structure
float biasOvn_trend  = f_adaptBiasTrend(480.0, minsPerDayNd, 0.0,  T_1H, T_4H, T_1D, 0.0, 0.2, 0.3, 0.5, false)

float biasPre = biasPre_trend * trendWeight + biasMR * (1.0 - trendWeight)
float biasPost = biasPost_trend * trendWeight + biasMR * (1.0 - trendWeight)
float biasOvnBlend = biasOvn_trend * trendWeight + biasMR * (1.0 - trendWeight)

// ─── Timeframe & Session Constants ───
var float spx_30m = na

// ─── Daily & Session Projection Pre-compute Anchors ───
string _projSess = f_getSessionIST(time)
bool _isExtended = (_projSess == "PRE-MKT" or _projSess == "POST-MKT" or _projSess == "OVERNIGHT")

// P0 anchors every forward projection (spx_30m..spx_6H, pxEOD, pxPost, pxOvn, pxPre, pxNextDay) and must
// always be the live current price — it used to freeze at the 7PM session-open print, silently ignoring
// whatever price had already done intraday.
float pxEODAnchor = close
float P0          = pxEODAnchor

float tradingDays = syminfo.type == "crypto" ? 365.0 : syminfo.type == "forex" ? 260.0 : 252.0
float minsPerDay  = syminfo.type == "crypto" ? 1440.0 : syminfo.type == "forex" ? 1440.0 : 390.0
float barsPerYear = timeframe.isdaily ? tradingDays :
     timeframe.isweekly ? 52.0 :
     timeframe.ismonthly ? 12.0 :
     timeframe.isminutes ? tradingDays * minsPerDay / timeframe.multiplier :
     tradingDays

// ─── Realized Variance & EWMA Volatility Clustering Engine (Priority 8 & Priority 14) ───
float barReturnSq    = math.pow(close[1] > 0 ? (close - close[1]) / close[1] : 0.0, 2)
var float ewmaVar    = 0.0
if confirmed
    ewmaVar         := bar_index < 20 ? math.pow(atr / close, 2) : 0.94 * ewmaVar + 0.06 * barReturnSq
float realizedVolAnn = math.sqrt(math.max(0.0001, ewmaVar * barsPerYear))
float volClusterMult = math.max(0.7, math.min(2.5, math.sqrt(ewmaVar) / math.max(0.0001, atr / close)))

float dailyRange     = not na(adr14) and adr14 > 0 ? adr14 : atr * 5.0
float hrlyVol        = dailyRange / 6.5

// Priority 14: SOXL Leveraged ETF Compounding Drag Model (-0.5 * L * (L - 1) * sigma^2 * dt). This is the
// standard closed-form first-order approximation of daily-reset volatility decay for a constant-leverage
// product under a lognormal/GBM assumption — it's what actually makes this model account for path-dependent
// compounding, not "expected index return x rolling beta" alone (that product, modelABias further below,
// is a separate ~25%-weighted input into the overall bias — this drag term is applied directly and
// additively to every forecast horizon: step_30m..step_6H, chgRegRemaining/Full, chgPost/Ovn/Pre,
// chgNextDayReg). It's a legitimate closed-form estimate, not a full day-by-day Monte Carlo replication of
// the underlying's return path — but at this script's actual forecast horizons (30m out to next session
// close, never multiple days), a single-period drag estimate and true day-by-day compounding shouldn't
// meaningfully diverge; that divergence only becomes material over multi-day+ holding periods this script
// doesn't forecast.
// P1-12: expenseDragPerBar adds the ONE genuinely missing, cheaply-modelable cost component — the fund's
// own annual expense ratio, which volDragPerBar does not include (that term is purely volatility decay).
// Financing/swap costs and rebalance mechanics are NOT modeled — they're internal to the fund's own
// swap/futures financing arrangements and aren't observable from price/volume data this script has access
// to; representing them would mean fabricating a number with no real basis, which is worse than omitting it.
float leverageFactor = i_leverage
float volDragPerBar  = -0.5 * leverageFactor * (leverageFactor - 1.0) * ewmaVar * close
// P0-7: was (timeframe.multiplier / minsPerDay) / tradingDays — timeframe.multiplier is only "minutes" on a
// minutes chart; on daily/weekly/monthly charts it's days/weeks/months, so the old formula silently computed
// the wrong fraction-of-year there (e.g. a daily chart's multiplier=1 was divided by minsPerDay=390 instead
// of meaning "1 trading day"). barsPerYear above already branches correctly on timeframe.isdaily/isweekly/
// ismonthly/isminutes, so 1/barsPerYear IS the correct "fraction of a trading year this one bar represents"
// for any timeframe — reusing it makes this correct everywhere instead of only on minute charts.
float expenseDragPerBar = -(i_expenseRatio / 100.0) * close / math.max(1.0, barsPerYear)
float volDragPerHour = (volDragPerBar + expenseDragPerBar) * (minsPerDay / math.max(1.0, timeframe.multiplier)) / 6.5

// P0-6: Synthetic daily-reset NAV validator. volDragPerBar's -0.5*L*(L-1)*sigma^2 term is the correct
// closed-form (Ito) approximation of ONE reset cycle's expected drag — not wrong, but a continuous-time
// approximation, not a literal "underlying return -> 3x target -> daily reset -> next NAV -> repeat"
// simulation. The two only provably agree in expectation; a single realized path can diverge from it (the
// classic example: +10% then -10% on the underlying does NOT net to 0% for a daily-reset 3x product). This
// script never forecasts more than one trading session ahead (NxtDay is its longest horizon), so that
// divergence has limited room to compound here — but rather than just asserting that, syntheticSoxlNav
// actually RUNS the discrete mechanical process bar-by-bar (compounding once per completed trading day by
// that day's REALIZED underlying return, net of the expense drag) so its cumulative return can be checked
// directly against SOXL's own actual cumulative return over the same window. Diagnostic/validation only —
// feeds navTrackingGapPct in the Historical Validation row, not any trading signal or forecast input.
var float syntheticSoxlNav = na
var float syntheticNavBase = na
var float realNavBase      = na
if na(syntheticSoxlNav)
    syntheticSoxlNav := close
    syntheticNavBase := close
    realNavBase      := close
if isNewDay and not na(indexDailyRetRaw)
    syntheticSoxlNav := syntheticSoxlNav[1] * (1.0 + i_leverage * indexDailyRetRaw) * (1.0 - (i_expenseRatio / 100.0) / tradingDays)
    // P0: per-day tracking residual = SOXL's OWN realized daily return (soxlDailyRetRaw) minus what the
    // mechanical model predicted for that same day (i_leverage*indexDailyRetRaw, net of expense drag) — the
    // real-world gap the closed-form drag model doesn't capture. EWMA-tracked (10% weight per new day, ~10
    // day half-life) rather than a simple running average, so it stays responsive to regime shifts in
    // financing/roll costs rather than averaging over the instrument's entire history at equal weight. Fed
    // into expectedSOXLReturn back in §9 (trackingResidualPerBar) — this is what makes that a real forecast
    // input, not diagnostic-only.
    if not na(soxlDailyRetRaw)
        float mechanicalDailyRet = i_leverage * indexDailyRetRaw - (i_expenseRatio / 100.0) / tradingDays
        float dailyTrackingResidual = soxlDailyRetRaw - mechanicalDailyRet
        trackingResidualN := trackingResidualN + 1.0
        avgDailyTrackingResidual := trackingResidualN < 10.0 ? dailyTrackingResidual : 0.90 * avgDailyTrackingResidual + 0.10 * dailyTrackingResidual
float syntheticCumRetPct = syntheticNavBase > 0 ? (syntheticSoxlNav / syntheticNavBase - 1.0) * 100.0 : 0.0
float realCumRetPct      = realNavBase > 0 ? (close / realNavBase - 1.0) * 100.0 : 0.0
float navTrackingGapPct  = realCumRetPct - syntheticCumRetPct

// ─── Time-of-Day Volatility Scaling (Fix Issue #4: DST Adaptive Alignment) ───
// P0: rebuilt to share f_getSessionIST's exact session-boundary convention (mktOpen/preOpen/ovnOpen/
// postOpen, shiftMins added to the THRESHOLD, not to mins) instead of an independently-maintained set of
// literal minute thresholds. The old version instead shifted MINS itself (mins = (rawMins+shiftMins)%1440)
// and compared against fixed literals — the opposite sign convention from f_getSessionIST — so during
// non-DST (winter) months this function's session boundaries silently drifted up to 2 hours away from what
// f_getSessionIST reported for the identical timestamp. It also had one fully dead branch ("Post-Market",
// mins>=90 and mins<330, intended 0.50x) that could never fire — that entire range was already claimed by
// the NY Morning/Lunch/Afternoon branches ahead of it in the if/else-if chain — and comments describing
// ranges that no longer matched the literals actually being tested. Rebuilding off the shared boundaries
// fixes all three at once and guarantees this schedule can never drift out of sync with the session
// f_getSessionIST reports for the same timestamp.
f_todVolMult(int ts) =>
    bool isDst = f_isUsDst(ts)
    int shiftMins = isDst ? 0 : 60
    int mins = hour(ts, "Asia/Kolkata") * 60 + minute(ts, "Asia/Kolkata")
    int mktOpen  = 1140 + shiftMins
    int preOpen  = 810  + shiftMins
    int ovnOpen  = 330  + shiftMins
    int postOpen = 90   + shiftMins
    // Regular session (mktOpen .. mktOpen+390, a 6.5h day) gets institutional intraday U-shaped vol
    // buckets: open spike / morning / lunch / afternoon / power hour (30/90/120/90/60 min respectively —
    // together the full 6.5h session). minsIntoSession wraps across midnight since mktOpen sits late in the
    // IST day and the session runs past it. Every other minute of the day falls into exactly one of
    // Post-Market/Overnight/Pre-Market, matching f_getSessionIST's own non-overlapping boundaries.
    int minsIntoSession = (mins - mktOpen + 1440) % 1440
    if minsIntoSession < 30          // NY Open (9:30-10:00 AM EDT)
        1.40
    else if minsIntoSession < 120    // NY Morning (10:00-11:30 AM EDT)
        1.10
    else if minsIntoSession < 240    // NY Lunch (11:30 AM-1:30 PM EDT)
        0.65
    else if minsIntoSession < 330    // NY Afternoon (1:30-3:00 PM EDT)
        0.90
    else if minsIntoSession < 390    // NY Power Hour (3:00-4:00 PM EDT)
        1.35
    else if mins >= postOpen and mins < ovnOpen
        0.50   // Post-Market
    else if mins >= ovnOpen and mins < preOpen
        0.35   // Overnight
    else
        0.60   // Pre-Market (preOpen .. mktOpen)

// ─── Session Bias Input Factors (moved up from §9b so the composite bias block below can reference them
// directly — they used to be declared after this point, so this block computed local "_m" duplicates
// of the same formulas instead. Full factor descriptions live at the §9b Factor 1-8 comments.) ───
float vwapBias = (not na(vwapVal) and vwapVal > 0 and atr > 0) ?
     math.max(-1.0, math.min(1.0, (close - vwapVal) / (atr * 2.0))) : 0.0
float gapBias = (not na(prevDayC) and prevDayC > 0 and atr > 0) ?
     math.max(-1.0, math.min(1.0, (close - prevDayC) / (atr * 3.0))) : 0.0
float recentMom = (close > close[1] ? 0.25 : -0.25) +
     (close > close[2] ? 0.15 : -0.15) +
     (close > close[3] ? 0.10 : -0.10)
recentMom := math.max(-1.0, math.min(1.0, recentMom))
float mfiBias = math.max(-1.0, math.min(1.0, (mfi - mfiCenter) / 50.0))
float rsiExhaust = 0.0
float rsiOverbought = math.min(95.0, rsiCenter + 25.0)
float rsiOversold   = math.max(5.0, rsiCenter - 25.0)
if rsi > rsiOverbought
    rsiExhaust := -(rsi - rsiOverbought) / math.max(1.0, 100.0 - rsiOverbought)
else if rsi < rsiOversold
    rsiExhaust := (rsiOversold - rsi) / math.max(1.0, rsiOversold)
rsiExhaust := math.max(-1.0, math.min(1.0, rsiExhaust))
float vixFactor = not na(vixClose) ? (vixClose > 25.0 ? 0.60 : (vixClose > 18.0 ? 0.80 : 1.0)) : 1.0
float adrDir = csBias != 0.0 ? (csBias > 0.0 ? 1.0 : -1.0) : (close >= open ? 1.0 : -1.0)
float adrExhaustMag = adrConsumedPct > 80.0 ? 0.3 : (adrConsumedPct > 60.0 ? 0.1 : 0.0)
float adrExhaust = -adrDir * adrExhaustMag

// ═══ SESSION-SPECIFIC COMPOSITE BIASES ═══
float biasPreMkt = math.max(-1.0, math.min(1.0, biasPre * 0.15 + T_1D * 0.25 + csBias * 0.20 + gapBias * 0.15 + vwapBias * 0.10 + recentMom * 0.05 + rsiExhaust * 0.05 + adrExhaust * 0.05)) * vixFactor
float biasPostMkt = math.max(-1.0, math.min(1.0, biasPost * 0.15 + csBias * 0.25 + recentMom * 0.20 + T_1H * 0.15 + mfiBias * 0.10 + vwapBias * 0.10 + rsiExhaust * 0.05)) * vixFactor
float biasOvnRaw = biasOvnBlend * 0.15 + T_1D * 0.35 + csBias * 0.25 + gapBias * 0.15 + rsiExhaust * 0.05 + adrExhaust * 0.05
float biasOvn = math.max(-1.0, math.min(1.0, biasOvnRaw)) * vixFactor * 0.40

// ═══ SESSION BIAS SELECTOR ═══
f_sessEffBias(string sess, float mktBias) =>
    float rawBias = switch sess
        "MARKET"    => mktBias
        "PRE-MKT"   => math.max(-1.0, math.min(1.0, mktBias * 0.70 + biasPreMkt * 0.30))
        "POST-MKT"  => math.max(-1.0, math.min(1.0, mktBias * 0.70 + biasPostMkt * 0.30))
        "OVERNIGHT" => math.max(-1.0, math.min(1.0, mktBias * 0.60 + biasOvn * 0.40))
        => 0.0
    if effectiveTrend == 1 and mktBias > 0 and rawBias < 0
        rawBias := mktBias * 0.5
    else if effectiveTrend == -1 and mktBias < 0 and rawBias > 0
        rawBias := mktBias * 0.5
    rawBias

// ─── Institutional Liquidity Attractor Pull Vector (Issue #11) ───
float vwapAttractor = (not na(vwapVal) and vwapVal > 0 and atr > 0) ? (vwapVal - close) / (atr * 4.0) : 0.0
float eqAttractor   = (equilibrium > 0 and atr > 0) ? (equilibrium - close) / (atr * 4.0) : 0.0
float attractorPull = math.max(-0.25, math.min(0.25, vwapAttractor * 0.6 + eqAttractor * 0.4))

// Dynamic forecast drift tracking variable
var float forecastDrift = 0.0

// Bar-time anchored 30m step forecast for walk-forward error tracking (Fix Critical Bug #1: no timenow lookahead on past bars)
int t30m_bar_ts    = time + 1800000
string s30m_bar_st = f_getSessionIST(t30m_bar_ts)
float tod_30m_bar  = f_todVolMult(t30m_bar_ts)
float sv_30m_bar   = hrlyVol * tod_30m_bar * volClusterMult
float step_30m_bar = sv_30m_bar * 0.7071 * (f_sessEffBias(s30m_bar_st, bias30m) + (macroAdj * 0.3) + attractorPull) + volDragPerHour * 0.5 + (forecastDrift * 0.85)
var float spx_30m_bar = na
spx_30m_bar := P0 + step_30m_bar

// P1: independent (P0-anchored, NOT chained through spx_30m_bar or each other) 1H and 4H forecasts —
// mirrors spx_30m_bar's own construction exactly, just at different horizons. Directly addresses "the
// displayed chain shares errors across horizons, validation needs independent per-horizon forecasts": these
// are fresh estimates from P0 using bias1H/bias4H directly, with zero dependency on the DISPLAYED ladder
// (spx_30m -> spx_45m -> spx_1H -> ... in the Sequential State-Space Forecast Chain further down), which
// deliberately chains instead, for a coherent visual scenario path. Exposed as data-window-only plots (§11)
// so they're inspectable without cluttering the chart/dashboard. Diagnostic only, and deliberately NOT yet
// backed by their own tracked accuracy history the way spx_30m_bar/shortHorizonBrier and the next-day
// frozenNextDay/eodBrier pair are — building that needs bar-count-based historical indexing (close[N] for a
// chart-timeframe-dependent N bars-per-hour) whose Pine type-safety (simple vs. series int rules) isn't
// something to get wrong without a compiler available to check it against. A bounded stopping point for
// this round: these are real independent forecasts, not yet a third fully independent calibration dataset.
int t1H_bar_ts    = time + 3600000
string s1H_bar_st = f_getSessionIST(t1H_bar_ts)
float tod_1H_bar  = f_todVolMult(t1H_bar_ts)
float sv_1H_bar   = hrlyVol * tod_1H_bar * volClusterMult
float step_1H_bar = sv_1H_bar * 1.0 * (f_sessEffBias(s1H_bar_st, bias1H) + (macroAdj * 0.3) + attractorPull) + volDragPerHour * 1.0 + (forecastDrift * 0.61)
float spx_1H_indep = P0 + step_1H_bar

int t4H_bar_ts    = time + 14400000
string s4H_bar_st = f_getSessionIST(t4H_bar_ts)
float tod_4H_bar  = f_todVolMult(t4H_bar_ts)
float sv_4H_bar   = hrlyVol * tod_4H_bar * volClusterMult
float step_4H_bar = sv_4H_bar * 2.0 * (f_sessEffBias(s4H_bar_st, bias4H) + (macroAdj * 0.3) + attractorPull) + volDragPerHour * 4.0 + (forecastDrift * 0.37)
float spx_4H_indep = P0 + step_4H_bar

// ─── Priority 3 & 11: Self-Correcting Forecast Error & Model Health Engine ───
// P0: spx_30m_bar is a genuine +30-MINUTE-ahead forecast (t30m_bar_ts = time + 1800000 further up), but
// this used to score it against close[1]/spx_30m_bar[1] — "1 bar ago," which only equals "30 minutes ago"
// on an exact 30-minute chart. On a 5m chart this scored the 30-minute forecast after only 5 minutes; on a
// 60m chart, only after 60 minutes (double the intended horizon) — the calibration dataset's actual meaning
// silently changed with whatever chart timeframe happened to be open. barsFor30m converts the intended
// 30-minute horizon into the right bar offset for THIS chart's timeframe — the same fixed-lag-in-bars idiom
// already used for barsPerDayNd's "1 trading day ago" (e.g. close[barsPerDayNd] further up) — so
// close[barsFor30m]/spx_30m_bar[barsFor30m] genuinely mean "30 minutes ago" on any intraday timeframe.
// Non-minute charts (daily+) fall back to 1 bar, since a 30m sub-bar horizon isn't meaningful there.
float _tfMinsShort = timeframe.isminutes ? timeframe.multiplier : 30.0
int barsFor30m = math.max(1, math.round(30.0 / math.max(1.0, _tfMinsShort)))
float actual1BarChg     = close - close[barsFor30m]
float priorForecastChg  = bar_index > barsFor30m and not na(spx_30m_bar[barsFor30m]) ? (spx_30m_bar[barsFor30m] - close[barsFor30m]) : 0.0
float forecastError1Bar = actual1BarChg - priorForecastChg

// Rolling Mean Absolute Error (MAE) & Root Mean Squared Error (RMSE) Tracking — Fix Issue #3: Gated by confirmed bar
var float rollingMAE = na
var float rollingMSE = na
if confirmed
    rollingMAE := bar_index < 20 ? atr : 0.96 * nz(rollingMAE, atr) + 0.04 * math.abs(forecastError1Bar)
    rollingMSE := bar_index < 20 ? math.pow(atr, 2) : 0.96 * nz(rollingMSE, math.pow(atr, 2)) + 0.04 * math.pow(forecastError1Bar, 2)
float rollingRMSE = math.sqrt(math.max(0.0001, rollingMSE))

// Fix directionalWinRate — compare dimensionless signed bias[1] vs realized return sign (gated by confirmed bar)
bool directionHit = (nz(bias30m[1], 0.0) >= 0 and realizedBarRet >= 0) or (nz(bias30m[1], 0.0) < 0 and realizedBarRet < 0)
var float directionalWinRate = 50.0
// P1-15: same magnitude-scaled credit as the L_index/L_basket/etc trackers above (reuses the same magNorm)
// instead of a flat 100/0 for any hit/miss regardless of how big the realized move was.
float dirHitCredit = directionHit ? (50.0 + 35.0 * magNorm) : (50.0 - 35.0 * magNorm)
if confirmed
    directionalWinRate := bar_index < 20 ? 50.0 : (1.0 - C_EWMA_A) * directionalWinRate + C_EWMA_A * dirHitCredit

// P0-4: shortHorizonBrier update. Reconstructs the probability spx_30m_bar[1] implied ONE bar ago (using
// directionalWinRate[1] and close[1], the values live at that time — not today's, matching the frozenWinRate
// pattern already used for eodBrier) and scores it against whether price actually closed up or down this
// bar. This is a real out-of-sample Brier score for a genuinely short horizon, computed from data already
// tracked for rollingMAE/forecastError1Bar above, not a copy of the next-day-horizon eodBrier.
float priorProbUp1Bar = bar_index > barsFor30m and not na(spx_30m_bar[barsFor30m]) and close[barsFor30m] > 0 ? f_retToProb((spx_30m_bar[barsFor30m] - close[barsFor30m]) / close[barsFor30m] * 100.0, nz(atr[barsFor30m], atr), nz(directionalWinRate[barsFor30m], 50.0), close[barsFor30m]) : 50.0
// P0: raw (pre-Platt) version of the same forecast, via the shared f_rawProb helper, for the online
// Platt-scaling SGD step right below — see f_retToProb's comment for the full rationale. Same guard as
// priorProbUp1Bar so both fall back to the same neutral 50.0 under identical conditions.
float priorRawProbUp1Bar = bar_index > barsFor30m and not na(spx_30m_bar[barsFor30m]) and close[barsFor30m] > 0 ? f_rawProb((spx_30m_bar[barsFor30m] - close[barsFor30m]) / close[barsFor30m] * 100.0, nz(atr[barsFor30m], atr), nz(directionalWinRate[barsFor30m], 50.0), close[barsFor30m]) : 50.0
if confirmed and bar_index > barsFor30m
    shortBrierCount := shortBrierCount + 1.0
    float shortBrierErr = math.pow(priorProbUp1Bar / 100.0 - (actual1BarChg >= 0.0 ? 1.0 : 0.0), 2)
    shortHorizonBrier := bar_index < 30 ? shortBrierErr : 0.96 * nz(shortHorizonBrier, shortBrierErr) + 0.04 * shortBrierErr

    // P0: online Platt-scaling SGD step, short-horizon resolution point (mirrors the long-horizon step in
    // §9b's regSessJustClosed block). One gradient step per resolved 1-bar-ahead forecast — this fires far
    // more often than the once-per-session long-horizon step, so it dominates how fast (a,b) initially
    // move, with the long-horizon step correcting toward next-day-specific calibration on top of that.
    float plattX1 = (priorRawProbUp1Bar - 50.0) / 50.0
    float plattY1 = actual1BarChg >= 0.0 ? 1.0 : 0.0
    float plattP1 = 100.0 / (1.0 + math.exp(-(plattA * plattX1 + plattB)))
    float plattLr1 = 0.02
    plattA := plattA - plattLr1 * (plattP1 / 100.0 - plattY1) * plattX1
    plattB := plattB - plattLr1 * (plattP1 / 100.0 - plattY1)
    plattN := plattN + 1.0

// Fix modelHealthScore — replace arbitrary 50/50 mix with documented 3-component formula.
float daComp    = math.max(0.0, math.min(100.0, directionalWinRate))
float maeRatio  = math.min(1.0, rollingMAE / math.max(0.001, atr))
float maeComp   = (1.0 - maeRatio) * 100.0
// modelHealthScore tracks FORECAST health (directional accuracy, forecast error, probability calibration)
// — brierComp uses eodBrier (return-forecast calibration), not rollBrier (trade P&L calibration), for the
// same reason f_calcConf's steepness gate was switched: trade outcomes are a different prediction target
// from directional price forecasts and shouldn't drive a "how healthy is the FORECAST model" score.
float brierComp = math.max(0.0, (0.25 - nz(eodBrier, 0.25)) / 0.25) * 100.0
float modelHealthScore = math.max(10.0, math.min(99.0, daComp * 0.50 + maeComp * 0.30 + brierComp * 0.20))

// Dynamic self-learning feedback gain (gated by confirmed bar)
float learningGain = math.max(0.01, math.min(0.20, 0.05 * (rollingMAE / math.max(0.01, atr))))
// P2: forecastDrift is an online adaptive controller (model -> error -> drift -> model -> new error ->
// drift), which needs explicit stability guards beyond just the existing EWMA decay (learningGain already
// acts as its half-life). Two additions: (1) an absolute cap, sized off ATR so a run of large forecast
// misses can't let drift compound into an ever-growing correction untethered from the instrument's own
// volatility scale — 0.15*atr keeps drift's own contribution smaller than the smallest step multiplier
// already applied to it downstream (dStep6 = forecastDrift*0.37, so even the least-damped use stays a small
// fraction of a typical bar's range); (2) a regime reset — when effectiveTrend flips, the drift learned
// under the OLD regime was fit to correct errors from a trend state that no longer holds, so it's damped
// toward zero rather than carried forward at full strength into the new regime.
float driftCapVal = atr > 0 ? atr * 0.15 : close * 0.001
if confirmed
    forecastDrift := bar_index < 20 ? 0.0 : (1.0 - learningGain) * forecastDrift + learningGain * forecastError1Bar
    if effectiveTrend != effectiveTrend[1]
        forecastDrift := forecastDrift * 0.3
    forecastDrift := math.max(-driftCapVal, math.min(driftCapVal, forecastDrift))

// ═══════════════════════════════════════════════════════════════════════════
// §9b  SESSION-SPECIFIC PRECISION ENGINE
// ═══════════════════════════════════════════════════════════════════════════
// Each session has fundamentally different price drivers:
// P1: renamed from "Order Flow" — this script has OHLC/volume/VWAP/structure/OB-heuristic/cross-asset data,
// never actual bid/ask, executed-aggressor volume, order-book imbalance, or depth/queue state, so "order
// flow" overstated what it observes. "Structural price/volume liquidity" is the accurate description.
//   MARKET:     Structural price/volume liquidity, structure breaks, momentum, volume
//   PRE-MARKET: Overnight news, gap analysis, daily structure, futures correlation
//   POST-MARKET: Closing strength, momentum exhaustion, smart money flow
//   OVERNIGHT:  Daily structure, mean reversion, minimal activity

// ─── Factors 1-8 (Closing Strength, VWAP Position, Gap Analysis, Late-Session Momentum, MFI Divergence,
// RSI Exhaustion, VIX Regime, ADR Exhaustion) are declared earlier — right before the SESSION-SPECIFIC
// COMPOSITE BIASES block, since biasPreMkt/biasPostMkt/biasOvnRaw need them before this point in the script. ───

// ═══ SESSION-ADAPTIVE DIRECTION THRESHOLDS ═══
// Higher threshold = more signal required to declare INCREASE/DECREASE
// Lower liquidity sessions need stronger bias to be actionable
float threshMkt  = 0.10   // Market: standard precision
float threshPre  = 0.15   // Pre-Market: need 50% more signal
float threshPost = 0.18   // Post-Market: need 80% more signal
float threshOvn  = 0.22   // Overnight: need 2.2x signal

f_sessThresh(string sess) =>
    switch sess
        "MARKET"    => threshMkt
        "PRE-MKT"   => threshPre
        "POST-MKT"  => threshPost
        "OVERNIGHT" => threshOvn
        => threshMkt

// Dynamic Volatility & Macro Adaptation Multipliers (Fix Issues #2 & #5)
float vixRegimeScale  = not na(vixClose) and vixClose > 0 ? (vixClose / 18.0) : 1.0

// Priority 7: Automatic Macro Event Risk & Earnings Volatility Auto-Detection
bool autoMacroSpike = (not na(vixClose) and vixClose > 22.0) or (not na(vixClose[1]) and math.abs(vixClose - vixClose[1]) > 1.2) or (not na(us10yClose[1]) and math.abs(us10yClose - us10yClose[1]) > 0.05)
bool autoVolSpike   = atr > 1.35 * ta.sma(atr, 20) or (rvol > 2.0)
bool autoEventRisk  = autoMacroSpike or autoVolSpike
float autoEventMult = autoEventRisk ? 1.25 : 1.0

float eventVolMultiplier = (i_eventFOMC ? 1.40 : 1.0) * (i_eventCPI ? 1.25 : 1.0) * (i_eventEarnings ? 1.20 : 1.0) * autoEventMult
float dynVolScale     = math.max(0.5, math.min(3.5, volClusterMult * vixRegimeScale * eventVolMultiplier))

bool isMacroShock = autoMacroSpike or (not na(vixClose) and vixClose > 28.0)
string riskLevel  = (isMacroShock or dynVolScale > 2.0) ? "HIGH" : ((autoEventRisk or dynVolScale > 1.3) ? "MEDIUM" : "LOW")
color riskColor   = riskLevel == "HIGH" ? #FF1744 : (riskLevel == "MEDIUM" ? #FF9100 : #00E676)

// Dynamic Session Volatility Multipliers (Adaptive to VIX, Realized Volatility, and ATR Percentiles)
float dynPreMult  = (0.60 + 0.10 * (atr / math.max(0.01, atrP90))) * dynVolScale
float dynPostMult = (0.50 + 0.10 * (atr / math.max(0.01, atrP90))) * dynVolScale
float dynOvnMult  = (0.35 + 0.05 * (atr / math.max(0.01, atrP90))) * dynVolScale

float preMktVol   = hrlyVol * dynPreMult
float postMktVol  = hrlyVol * dynPostMult
float overnightVol = hrlyVol * dynOvnMult

// Issue 3: Re-derive f_calcConf as signal-to-noise ratio (SNR) logistic transform.
// Old formula: 50 + (confRatio-1)*20 had no derivation; SNR-based logistic is documented.
// SNR = |bias| / threshold: SNR=1 → 50% (neutral), SNR=2 → ~73% (strong signal), SNR=0 → ~27% (below noise)
f_calcConf(float adjEb, float et, float ca, float vixFactor, float t_hours = 1.0) =>
    float snr = et > 0 ? math.abs(adjEb) / math.max(et, 0.001) : 0.0
    // Logistic transform: maps SNR to probability space (snr=1→0.5, snr=2→0.73). Steepness self-calibrates
    // against a HORIZON-BLENDED Brier score instead of one fixed dataset. P0-4: shortHorizonBrier (built in
    // §9 from the bar-time-anchored 1-bar-ahead forecast, a genuinely separate out-of-sample series — not a
    // copy of eodBrier) covers the "immediate" end; eodBrier (the next-day-horizon calibration — see the EOD
    // validation block in §9b) covers the "full trading day" end. t_hours/24 interpolates between them, so a
    // 30m-row's confidence steepness is no longer dictated by a calibration score measuring next-day accuracy,
    // and a next-day row isn't dictated by 1-bar accuracy. Still 2 datasets, not 9 fully independent per-horizon
    // ones (that would need bar-time-anchored parallel forecast series per horizon plus their own Brier/hit-rate
    // trackers — a much larger undertaking) — but each end of the horizon spectrum now draws on a calibration
    // history measuring roughly its own timescale instead of a single one-size-fits-all number.
    float baseSteepness = 1.5
    float confSteepness = baseSteepness
    float hzFrac   = math.max(0.0, math.min(1.0, t_hours / 24.0))
    bool  haveShort = shortBrierCount >= 30
    bool  haveLong  = eodCount >= 10
    if haveShort or haveLong
        float shortB = haveShort ? nz(shortHorizonBrier, 0.25) : 0.25
        float longB  = haveLong  ? nz(eodBrier, 0.25) : 0.25
        float blendedBrier = shortB * (1.0 - hzFrac) + longB * hzFrac
        float brierDev = math.max(-0.2, math.min(0.2, 0.20 - blendedBrier))
        confSteepness := baseSteepness * math.max(0.5, 1.0 + brierDev * 2.0)
    float rawConf = 100.0 / (1.0 + math.exp(-(snr - 1.0) * confSteepness))
    float horizonDecay = math.pow(0.94, math.sqrt(math.max(0.0, t_hours)))
    float scaledConf  = rawConf * ca * vixFactor * horizonDecay
    math.max(15.0, math.min(90.0, scaledConf))

f_renderForecastRow(table tbl, int rowIdx, string sess, float spx, float basePx, float cumHours, float rawConf, float hBias, string hourStr, string tl, color bg, string szSmall, string szTiny, string suffix) =>
    float cumRet   = basePx > 0 ? ((spx - basePx) / basePx) * 100.0 : 0.0

    // Signal divergence adaptation (Fix Issue #4): confidence drops when 15m momentum clashes with HTF trend
    float signalDivergence = math.abs(T_ST - T_1D)
    float confDivergenceAdj = math.max(0.40, 1.0 - signalDivergence * 0.35)
    float sconf    = math.max(15.0, math.min(90.0, rawConf * confDivergenceAdj))

    bool isClosed  = sess == "CLOSED"
    // ATR-Scaled Noise Floor (Fix Issue #5: Replaces fixed $0.05 threshold with volatility-adaptive atr * 0.10)
    float noiseFloor = math.max(syminfo.mintick, atr * 0.10)
    bool isUp      = spx >= basePx + noiseFloor
    bool isDn      = spx <= basePx - noiseFloor
    string dIcon   = isClosed ? "" : (isUp ? "📈 " : (isDn ? "📉 " : "-- "))
    color clr      = isClosed ? #616161 : (isUp ? #00E676 : (isDn ? #FF1744 : #9E9E9E))
    string lbl     = "+" + hourStr + " " + tl

    // Dynamic Asymmetric Model Volatility Band (Fix Issue #10: Horizon-Matched Skew). P1-21: this is NOT a
    // rigorous statistical "68% confidence interval" despite being sized off one sigma of modeled vol —
    // once C_SKEW_COEF asymmetrically widens/narrows the upper vs. lower bound based on the model's own
    // directional bias, the two sides no longer correspond to a real 68%-coverage probability interval
    // (a true CI's coverage comes from the outcome DISTRIBUTION, not from how confident the model feels).
    // Correct description: a bias-shaped volatility band, sized from realized/clustered vol — useful as a
    // plausible-range display, not as a calibrated "68% chance the price lands in this range" claim.
    // Skews upside/downside width based on direction of macro trend bias FOR THIS HORIZON
    float skewFactor = 1.0 + C_SKEW_COEF * math.max(-1.0, math.min(1.0, hBias))
    float upperSigma = hrlyVol * math.sqrt(cumHours) * volClusterMult * skewFactor
    float lowerSigma = hrlyVol * math.sqrt(cumHours) * volClusterMult / skewFactor
    float rHigh      = spx + upperSigma
    float rLow       = math.max(0.01, spx - lowerSigma)

    string pctStr  = (cumRet >= 0 ? "+" : "") + str.tostring(cumRet, "#.02") + "%"
    // Directional probability for THIS horizon (was previously only shown for Pre/Reg/Post/Ovn/NextDay rows,
    // leaving the 30m-6H ladder with a confidence % but no P(Up)/P(Dn)). "Conf" = signal confidence
    // (SNR-based, how sure the model is in its own bias — NOT an empirical probability); "CalP" = calibrated
    // probability of the directional call. P1: previously single-letter "C"/"P" — both are percentages, so
    // "C82% P74%" reads as two empirical probabilities at a glance even with the distinction documented in
    // this comment. Spelling out "Conf"/"CalP" (still compact enough for the mobile table cells — see the
    // "kept as short as possible" note on the mobile forecast row further down) keeps that distinction
    // visible in the dashboard itself, not just in code comments nobody reading the chart sees.
    float probUp   = f_retToProb(cumRet, atr, directionalWinRate)
    string probStr = math.abs(cumRet) < 0.10 ? "50%↔" : (cumRet >= 0 ? str.tostring(probUp, "#.0") + "%↑" : str.tostring(100.0 - probUp, "#.0") + "%↓")
    string txt     = isClosed ? "Closed" : (dIcon + "$" + str.tostring(spx, "#.02") + " (" + pctStr + ") [Conf" + str.tostring(sconf, "0") + "% CalP" + probStr + "] $" + str.tostring(rLow, "#.01") + "-" + str.tostring(rHigh, "#.01") + suffix)
    f_dashCell(tbl, rowIdx, lbl, txt, f_sessClr(sess), clr, bg, size.tiny)

// Renders the 30m-6H hourly forecast ladder only. The EOD/Next-Day summary is rendered once by the
// caller (Reg + NxtDay rows) using pxEOD/pxNextDay with their correctly paired confidence bounds —
// this function used to duplicate that with a mismatched pxEOD price against nextDayHi/Lo bounds.
f_renderForecastBlock(table tbl, int startRow, string s30, string s45, string s1, string s2, string s3, string s4, string s5, string s6, float p30, float p45, float p1, float p2, float p3, float p4, float p5, float p6, float P0, color bg1, color bg2, string szSmall, string szTiny, string labelPfx, string tl30, string tl45, string tl1, string tl2, string tl3, string tl4, string tl5, string tl6) =>
    int r = startRow
    float caVal = math.max(0.40, directionalWinRate / 100.0)
    // Each row's confidence uses ITS OWN session's noise threshold (f_sessThresh) — lower-liquidity
    // sessions need a stronger bias to be actionable, instead of one flat market-hours threshold for all.
    float c30  = f_calcConf(bias30m, f_sessThresh(s30), caVal, vixFactor, 0.50)
    float c45  = f_calcConf(bias45m, f_sessThresh(s45), caVal, vixFactor, 0.75)
    float c1   = f_calcConf(bias1H,  f_sessThresh(s1),  caVal, vixFactor, 1.00)
    float c2   = f_calcConf(bias2H,  f_sessThresh(s2),  caVal, vixFactor, 2.00)
    float c3   = f_calcConf(bias3H,  f_sessThresh(s3),  caVal, vixFactor, 3.00)
    float c4   = f_calcConf(bias4H,  f_sessThresh(s4),  caVal, vixFactor, 4.00)
    float c5   = f_calcConf(bias5H,  f_sessThresh(s5),  caVal, vixFactor, 5.00)
    float c6   = f_calcConf(bias6H,  f_sessThresh(s6),  caVal, vixFactor, 6.00)

    f_renderForecastRow(tbl, r, s30, p30, P0, 0.50, c30, bias30m, "30m", labelPfx + tl30, bg1, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s45, p45, P0, 0.75, c45, bias45m, "45m", labelPfx + tl45, bg2, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s1,  p1,  P0, 1.00, c1,  bias1H,  "1",   labelPfx + tl1,  bg1, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s2,  p2,  P0, 2.00, c2,  bias2H,  "2",   labelPfx + tl2,  bg2, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s3,  p3,  P0, 3.00, c3,  bias3H,  "3",   labelPfx + tl3,  bg1, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s4,  p4,  P0, 4.00, c4,  bias4H,  "4",   labelPfx + tl4,  bg2, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s5,  p5,  P0, 5.00, c5,  bias5H,  "5",   labelPfx + tl5,  bg1, szSmall, szTiny, "")
    r += 1
    f_renderForecastRow(tbl, r, s6,  p6,  P0, 6.00, c6,  bias6H,  "6",   labelPfx + tl6,  bg2, szSmall, szTiny, "")
    r += 1
    r

// ─── Timestamps for time-of-day volatility distributions ───
int t30m_step = timenow + 1800000
int t45m_step = timenow + 2700000
int t1H_step  = timenow + 3600000
int t2H_step  = timenow + 7200000
int t3H_step  = timenow + 10800000
int t4H_step  = timenow + 14400000
int t5H_step  = timenow + 18000000
int t6H_step  = timenow + 21600000

string s30m_st = f_getSessionIST(t30m_step)
string s45m_st = f_getSessionIST(t45m_step)
string s1_st   = f_getSessionIST(t1H_step)
string s2_st   = f_getSessionIST(t2H_step)
string s3_st   = f_getSessionIST(t3H_step)
string s4_st   = f_getSessionIST(t4H_step)
string s5_st   = f_getSessionIST(t5H_step)
string s6_st   = f_getSessionIST(t6H_step)

// ─── Sequential State-Space Forecast Chain (Unbroken Markov Path) ───

// Horizon-Decaying Forecast Drift (Fix Issue #3: Prevents runaway drift accumulation across steps)
float dStep1 = forecastDrift * 0.85
float dStep2 = forecastDrift * 0.72
float dStep3 = forecastDrift * 0.61
float dStep4 = forecastDrift * 0.52
float dStep5 = forecastDrift * 0.44
float dStep6 = forecastDrift * 0.37

// Fix 5: Stabilize macroContrib with EWMA-smoothed modelHealthScore to prevent runaway feedback damping
float smoothModelHealth = ta.ema(modelHealthScore, 20)
float macroContrib = macroAdj * math.max(0.35, math.min(1.0, smoothModelHealth / 100.0))

// Step 1: +30m
float tod_30m  = f_todVolMult(t30m_step)
float sv_30m   = hrlyVol * tod_30m * volClusterMult
float step_30m = sv_30m * 0.7071 * (f_sessEffBias(s30m_st, bias30m) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 0.5 + dStep1
spx_30m := P0 + step_30m

// Step 2: +45m (chained from +30m)
float tod_45m  = f_todVolMult(t45m_step)
float sv_45m   = hrlyVol * tod_45m * volClusterMult
float step_45m = sv_45m * 0.50 * (f_sessEffBias(s45m_st, bias45m) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 0.25 + dStep2
float spx_45m  = spx_30m + step_45m

// Step 3: +1H (chained from +45m)
float tod_1H   = f_todVolMult(t1H_step)
float sv_1H    = hrlyVol * tod_1H * volClusterMult
float step_1H  = sv_1H * 0.50 * (f_sessEffBias(s1_st, bias1H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 0.25 + dStep3
float spx_1H   = spx_45m + step_1H

// Step 4: +2H (chained from +1H)
float tod_2H   = f_todVolMult(t2H_step)
float sv_2H    = hrlyVol * tod_2H * volClusterMult
float step_2H  = sv_2H * 1.0 * (f_sessEffBias(s2_st, bias2H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 1.0 + dStep4
float spx_2H   = spx_1H + step_2H

// Step 5: +3H (chained from +2H)
float tod_3H   = f_todVolMult(t3H_step)
float sv_3H    = hrlyVol * tod_3H * volClusterMult
float step_3H  = sv_3H * 1.0 * (f_sessEffBias(s3_st, bias3H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 1.0 + dStep5
float spx_3H   = spx_2H + step_3H

// Step 6: +4H (chained from +3H)
float tod_4H   = f_todVolMult(t4H_step)
float sv_4H    = hrlyVol * tod_4H * volClusterMult
float step_4H  = sv_4H * 1.0 * (f_sessEffBias(s4_st, bias4H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 1.0 + dStep6
float spx_4H   = spx_3H + step_4H

// Step 7: +5H (chained from +4H)
float tod_5H   = f_todVolMult(t5H_step)
float sv_5H    = hrlyVol * tod_5H * volClusterMult
float step_5H  = sv_5H * 1.0 * (f_sessEffBias(s5_st, bias5H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 1.0 + dStep6 * 0.8
float spx_5H   = spx_4H + step_5H

// Step 8: +6H (chained from +5H)
float tod_6H   = f_todVolMult(t6H_step)
float sv_6H    = hrlyVol * tod_6H * volClusterMult
float step_6H  = sv_6H * 1.0 * (f_sessEffBias(s6_st, bias6H) + macroContrib * 0.5 + attractorPull) + volDragPerHour * 1.0 + dStep6 * 0.6
float spx_6H   = spx_5H + step_6H

// ─── SEQUENTIAL INSTITUTIONAL SESSION CHAIN (CHRONOLOGICAL PATH) ───
float normBiasDaily   = biasEOD
float maxDayChg       = math.max(P0 * 0.15, dailyRange * 2.0)
// P0: nowMins/nowSess (below) MUST be derived from `time` (this bar's own timestamp), never `timenow`.
// timenow is the script's EXECUTION wall-clock time — constant across every historical bar during a
// backtest/chart load, not that bar's own time. This whole chain (pxPre/pxEOD/pxPost/pxOvn/pxNextDay)
// runs unconditionally on every bar, not just barstate.islast, and pxNextDay gets frozen into
// frozenNextDay for real out-of-sample EOD/Platt calibration further down — so a timenow-derived nowSess
// used to make EVERY historical bar branch into whatever session is live RIGHT NOW (today), silently
// contaminating eodMAE/eodWinRate/eodBrier/plattA/plattB with the wrong branch's math on every past bar.
// `time` gives each bar its own correct session/remaining-minutes instead. The live dashboard (§12,
// gated on barstate.islast) still uses timenow for on-screen countdowns/labels — that's fine, since it
// only affects display on the current bar and never feeds back into any of these learning arrays.
int nowMins           = hour(time, "Asia/Kolkata") * 60 + minute(time, "Asia/Kolkata")
float remainHoursReg  = math.max(0.5, math.min(6.5, (1140.0 - nowMins) / 60.0))

// 1. Session change calculations
// attractorPull (VWAP/equilibrium mean-reversion pull) is included in every session-level change below,
// matching the hourly ladder (step_30m..step_6H) — otherwise the two paths could point opposite directions.
float chgRegRemaining = math.max(-maxDayChg, math.min(maxDayChg, hrlyVol * math.sqrt(remainHoursReg) * (normBiasDaily + macroAdj * 0.5 + attractorPull) + volDragPerHour * remainHoursReg + dStep1))
float chgRegFull      = math.max(-maxDayChg, math.min(maxDayChg, hrlyVol * math.sqrt(6.5) * (normBiasDaily + macroAdj * 0.5 + attractorPull) + volDragPerHour * 6.5 + dStep1))

// Dampened leverage drag per session to resolve Overnight Drag Dominance (Issue #6)
float dragPost = volDragPerHour * 4.0 * dynPostMult
float dragOvn  = volDragPerHour * 8.0 * dynOvnMult
float dragPre  = volDragPerHour * 5.5 * dynPreMult

// Dedicated Post/Ovn/Pre session changes route through the SAME f_sessEffBias() blend the hourly ladder
// uses (momentum blended with session-specific bias, plus the directional-lock guard), anchored to biasEOD
// — so this and the ladder can't silently disagree on the same session via two unreconciled formulas.
float chgPost = postMktVol * (f_sessEffBias("POST-MKT", biasEOD) + macroAdj * 0.15 + attractorPull) + dragPost + forecastDrift * 0.20
float chgOvn  = overnightVol * (f_sessEffBias("OVERNIGHT", biasEOD) + macroAdj * 0.35 + attractorPull) + dragOvn + forecastDrift * 0.15
float chgPre  = preMktVol * (f_sessEffBias("PRE-MKT", biasEOD) + macroAdj * 0.65 + attractorPull) + dragPre + forecastDrift * 0.10

// Explicit SOXL Opening Gap Model (Pre-Market -> Next Day Open)
float gapDirectionMult = biasPreMkt * 0.6 + basketFactorSum * 0.4
float expectedGap      = hrlyVol * 1.25 * gapDirectionMult * vixRegimeScale

// ─── Adaptive Next-Day Factor Weighting, continued ───
// barsPerDayNd/retSinceYest/corrT1DNd/corrT4HNd are reused from biasEOD_trend's weighting above, but with
// their own fallback/smoothing (sCorrT1D_nd/sCorrT4H_nd) since tomRegBias's T_1D:T_4H emphasis (0.40:0.30)
// differs from biasEOD_trend's (1.0:0.7) and a shared fallback would distort whichever didn't match.
float sCorrT1D_nd   = ta.ema(math.max(0.0, nz(corrT1DNd, 0.40)), smoothLen)
float sCorrT4H_nd   = ta.ema(math.max(0.0, nz(corrT4HNd, 0.30)), smoothLen)
float corrBasketNd  = ta.correlation(basketFactorSum[barsPerDayNd], retSinceYest, i_rollWin)
float corrGapNd     = ta.correlation(gapBias[barsPerDayNd], retSinceYest, i_rollWin)
float sCorrBasketNd = ta.ema(math.max(0.0, nz(corrBasketNd, 0.20)), smoothLen)
float sCorrGapNd    = ta.ema(math.max(0.0, nz(corrGapNd, 0.10)), smoothLen)
float sumCorrNd     = sCorrT1D_nd + sCorrT4H_nd + sCorrBasketNd + sCorrGapNd
float wT1DNd    = sumCorrNd > 0 ? sCorrT1D_nd   / sumCorrNd : 0.40
float wT4HNd    = sumCorrNd > 0 ? sCorrT4H_nd   / sumCorrNd : 0.30
float wBasketNd = sumCorrNd > 0 ? sCorrBasketNd / sumCorrNd : 0.20
float wGapNd    = sumCorrNd > 0 ? sCorrGapNd    / sumCorrNd : 0.10

// Next Day Regular Session Close (Tomorrow's session)
float tomRegBias    = T_1D * wT1DNd + T_4H * wT4HNd + basketFactorSum * wBasketNd + gapBias * wGapNd
float chgNextDayReg = math.max(-maxDayChg, math.min(maxDayChg, dailyRange * 0.4 * (tomRegBias + macroAdj * 1.0 + attractorPull) + volDragPerHour * 6.5 + forecastDrift * 0.05))

// 2. Chaining logically from P0 based on current active session
float pxPre = na
float pxEOD = na
float pxPost = na
float pxOvn = na
float pxNextDayOpen = na
float pxNextDay = na

// See the P0 note above nowMins — same timenow-vs-time rationale applies here.
string nowSess = f_getSessionIST(time)

if nowSess == "OVERNIGHT" or nowSess == "CLOSED"
    // Overnight (remaining) -> Pre-Market -> Regular Market -> Post-Market -> Overnight -> Next Day
    float remainHoursOvn = math.max(0.5, math.min(8.0, (810.0 - nowMins) / 60.0))
    float chgOvnRemaining = overnightVol * math.sqrt(remainHoursOvn) * (f_sessEffBias("OVERNIGHT", biasEOD) + macroAdj * 0.35 + attractorPull) + volDragPerHour * remainHoursOvn * dynOvnMult + forecastDrift * 0.15
    float pxOvnClose = P0 + chgOvnRemaining
    pxPre := pxOvnClose + chgPre
    pxEOD := pxPre + chgRegFull
    pxPost := pxEOD + chgPost
    pxOvn := pxPost + chgOvn
    // Gap anchors to pxOvn — the LAST link in this branch's chain — not pxPre, so NxtDay continues the
    // chain instead of being a disconnected sibling of pxEOD that could jump the opposite direction.
    pxNextDayOpen := pxOvn + expectedGap
    pxNextDay := pxNextDayOpen + chgNextDayReg

else if nowSess == "PRE-MKT"
    // Pre-Market (remaining) -> Regular Market -> Post-Market -> Overnight -> Next Day
    float remainHoursPre = math.max(0.5, math.min(5.5, (1140.0 - nowMins) / 60.0))
    float chgPreRemaining = preMktVol * math.sqrt(remainHoursPre) * (f_sessEffBias("PRE-MKT", biasEOD) + macroAdj * 0.65 + attractorPull) + volDragPerHour * remainHoursPre * dynPreMult + forecastDrift * 0.10
    pxPre := P0 + chgPreRemaining
    pxEOD := pxPre + chgRegFull
    pxPost := pxEOD + chgPost
    pxOvn := pxPost + chgOvn
    // Same fix as the Overnight branch: anchor to pxOvn (the last link in this chain), not pxPre.
    pxNextDayOpen := pxOvn + expectedGap
    pxNextDay := pxNextDayOpen + chgNextDayReg

else if nowSess == "MARKET"
    // Regular Market (remaining) -> Post-Market -> Overnight -> Pre-Market -> Next Day
    pxEOD := P0 + chgRegRemaining
    pxPost := pxEOD + chgPost
    pxOvn := pxPost + chgOvn
    pxPre := pxOvn + chgPre
    pxNextDayOpen := pxPre + expectedGap
    pxNextDay := pxNextDayOpen + chgNextDayReg

else if nowSess == "POST-MKT"
    // Post-Market (remaining) -> Overnight -> Pre-Market -> Regular Market -> Next Day
    float remainHoursPost = math.max(0.5, math.min(4.0, (330.0 - nowMins) / 60.0))
    float chgPostRemaining = postMktVol * math.sqrt(remainHoursPost) * (f_sessEffBias("POST-MKT", biasEOD) + macroAdj * 0.15 + attractorPull) + volDragPerHour * remainHoursPost * dynPostMult + forecastDrift * 0.20
    pxPost := P0 + chgPostRemaining
    pxOvn := pxPost + chgOvn
    pxPre := pxOvn + chgPre
    pxEOD := pxPre + chgRegFull
    // Same fix: anchor to pxEOD — the last link in THIS branch's chain (Post -> Ovn -> Pre -> Reg) —
    // not pxPre, which here is an earlier midpoint, not the chain's endpoint.
    pxNextDayOpen := pxEOD + expectedGap
    pxNextDay := pxNextDayOpen + chgNextDayReg

float nextDayChg = pxNextDay - P0

// ═══════════════════════════════════════════════════════════════════════════
// BASE-PRICE REFERENCE — how every session forecast's % return is measured
// ═══════════════════════════════════════════════════════════════════════════
// This script tracks forecasts for four session states — PRE-MARKET, REGULAR MARKET, POST-MARKET,
// OVERNIGHT — detected by f_getSessionIST(ts) (§2). Every forecast, whether it's a dashboard row or
// consumed internally (e.g. by the Session Alignment Engine right below), is fundamentally a
// [targetPrice, basePrice] pair, and its % return is ALWAYS (targetPrice - basePrice) / basePrice * 100 —
// never a raw price compared against another row's raw price, since different rows use different bases
// (see Type A vs Type B below) and comparing raw forecast prices across rows with different bases is
// meaningless. This section is the single reference for what basePrice is, for every row, in every
// current-session state — read it before touching any of the base-price logic below or in
// f_renderSessionOutlookRows (just above §12).
//
// ─── Type A: "from here, where does the NEXT occurrence of this session finish?" ───
// Used for PRE-MARKET, POST-MARKET, OVERNIGHT. Base = the CURRENT LIVE PRICE (pxEODAnchor / P0 / safeAnchor
// — the same value, close, just named differently depending on which block reads it), regardless of which
// of the four sessions is currently active. This is the same measurement "SOXL is up 2% today" makes
// intraday: always relative to right now, not to some other session's close.
//
// ─── Type B: "where will the REGULAR session close relative to the last completed regular close?" ───
// Used for REGULAR MARKET. Base = prevDayC (the last COMPLETED regular session's close), in every
// current-session state — including while a regular session is still live, since today's own close isn't
// known yet and the last genuinely completed reference point is still yesterday's. This lets "Current Reg"
// (today's expected close) and "Next Reg" (tomorrow's expected close) share ONE consistent reference, so
// they can be compared directly as two points on the same axis rather than two differently-anchored numbers.
//
// ─── Row-by-row (target = that row's forecast price; base = what it's measured against) ───
//   PRE   target = next Pre-Market session's close     | base = current live price (Type A)
//   REG   target = upcoming/current Reg close, or the   | base = prev COMPLETED Reg close (Type B),
//         next one once today's has passed              |        i.e. prevDayC / g_regBase
//   POST  target = next Post-Market session's close     | base = current live price (Type A)
//   OVN   target = next Overnight session's close        | base = current live price (Type A) —
//                                                          |   EXCEPT while CURRENTLY INSIDE Overnight,
//                                                          |   where base switches to the current Regular
//                                                          |   price instead (the live overnight tick is
//                                                          |   illiquid/unrepresentative) — see regBase /
//                                                          |   ovnBaseAnchor in f_renderSessionOutlookRows
// Since Type A's base is just "current live price" and Type B's is just "prevDayC," the base itself doesn't
// change with the current session — only WHICH forecast counts as "next" does (today's vs. tomorrow's Reg;
// this cycle's vs. next cycle's Pre/Post/Ovn), which the nowSess if/else-if chain above (pxPre/pxEOD/
// pxPost/pxOvn/pxNextDay) already resolves per current session.
//
// ─── Two DIFFERENT "Next Reg" numbers exist in this file, on purpose — not a bug, not drift ───
// 1. The dashboard's visible NxtDay row/badge (§12, f_renderSessionOutlookRows's expRetDaily) measures
//    pxNextDay against safeAnchor (CURRENT LIVE PRICE, Type A) — "how far is tomorrow's expected close from
//    where price is trading RIGHT NOW." That's the number a trader looking at the live chart actually wants.
// 2. The Session Alignment Engine's nextRegReturn (right below) measures the SAME pxNextDay against
//    g_regBase (prevDayC, Type B) instead — matching curRegReturn's OWN base so the two can be compared
//    apples-to-apples as two points on one day-over-day axis, which the Decision Layer's "does Current Reg
//    agree with Next Reg" divergence check specifically needs. Different questions, deliberately different
//    bases — don't unify them.
//
// ─── Where each piece lives ───
//   Session detection ............ f_getSessionIST(ts)                              (§2)
//   Price chain (pxPre/pxEOD/     the nowSess if/else-if chain, just above this block
//   pxPost/pxOvn/pxNextDay) ...... ("SEQUENTIAL INSTITUTIONAL SESSION CHAIN")         (§9b)
//   Dashboard row bases .......... f_renderSessionOutlookRows                        (just above §12)
//   Decision-layer bases ......... the Session Alignment Engine                      (immediately below)

// ─── P0: Session Alignment Engine (Forecast Layer -> Decision Layer, confirmation-only gate) ───
// Builds normalized (return-%, not raw price) forecasts for the two PRIMARY regular-session legs — today's
// expected close vs yesterday's close, and tomorrow's expected close measured against that SAME
// yesterday's-close reference (today's own close isn't known yet while the session is still live, so
// "Next Reg" uses the same last-COMPLETED-regular-close base as "Current Reg" rather than a base that
// doesn't exist yet) — plus the three SECONDARY context legs (next Pre/Post/Overnight vs the current live
// price: "from here, where does the next occurrence of this session finish"). Every leg reports
// expectedReturnPct + probUp via the SAME f_retToProb the rest of the dashboard already uses, so the
// decision below compares normalized returns/probabilities across sessions — never raw forecast prices
// against each other, which would be meaningless across legs with different bases.
float g_regBase = (not na(prevDayC) and prevDayC > 0) ? prevDayC : pxEODAnchor

float curRegReturn  = g_regBase > 0 ? ((pxEOD - g_regBase) / g_regBase) * 100.0 : 0.0
float curRegProbUp  = f_retToProb(curRegReturn, atr, directionalWinRate)
float nextRegReturn = g_regBase > 0 ? ((pxNextDay - g_regBase) / g_regBase) * 100.0 : 0.0
float nextRegProbUp = f_retToProb(nextRegReturn, atr, directionalWinRate)

float alignPreReturn  = pxEODAnchor > 0 ? ((nz(pxPre, pxEODAnchor)  - pxEODAnchor) / pxEODAnchor) * 100.0 : 0.0
float alignPreProbUp  = f_retToProb(alignPreReturn, atr, directionalWinRate)
float alignPostReturn = pxEODAnchor > 0 ? ((nz(pxPost, pxEODAnchor) - pxEODAnchor) / pxEODAnchor) * 100.0 : 0.0
float alignPostProbUp = f_retToProb(alignPostReturn, atr, directionalWinRate)
float alignOvnReturn  = pxEODAnchor > 0 ? ((nz(pxOvn, pxEODAnchor)  - pxEODAnchor) / pxEODAnchor) * 100.0 : 0.0
float alignOvnProbUp  = f_retToProb(alignOvnReturn, atr, directionalWinRate)

// ATR-scaled noise floor expressed as a %, matching f_renderForecastRow's own noiseFloor principle (never
// a fixed $/% value), so direction classification stays consistent regardless of price level.
float alignNoiseFloorPct = pxEODAnchor > 0 ? (atr * 0.10) / pxEODAnchor * 100.0 : 0.05

f_alignDir(float ret) =>
    ret > alignNoiseFloorPct ? 1 : (ret < -alignNoiseFloorPct ? -1 : 0)

int curRegDir    = f_alignDir(curRegReturn)
int nextRegDir   = f_alignDir(nextRegReturn)
int alignPreDir  = f_alignDir(alignPreReturn)
int alignPostDir = f_alignDir(alignPostReturn)
int alignOvnDir  = f_alignDir(alignOvnReturn)

// P0: PRIMARY = current + next regular session — BOTH must agree, beyond noise, to confirm a direction
// (the "Current Reg bullish but Next Reg bearish -> WAIT, not LONG" rule from the spec's divergence
// example). SECONDARY (Pre/Post/Ovn) only feeds the alignment SCORE below, never a hard gate on its own —
// matching the spec's explicit "confirmation, not primary entry triggers" framing.
bool sessionPrimaryBull = curRegDir == 1 and nextRegDir == 1
bool sessionPrimaryBear = curRegDir == -1 and nextRegDir == -1
bool sessionDivergent   = (curRegDir == 1 and nextRegDir == -1) or (curRegDir == -1 and nextRegDir == 1)
int  secondaryBullCount = (alignPreDir == 1 ? 1 : 0) + (alignPostDir == 1 ? 1 : 0) + (alignOvnDir == 1 ? 1 : 0)
int  secondaryBearCount = (alignPreDir == -1 ? 1 : 0) + (alignPostDir == -1 ? 1 : 0) + (alignOvnDir == -1 ? 1 : 0)

// directionalStrength per leg = expectedReturn scaled by normalized confidence (probUp remapped from
// [0,100] to [-1,+1]) — a 55% probability contributes far less than a 90% probability at the same raw %
// return, so "UP 51%" and "UP 78%" don't get counted the same way a flat direction tally would.
f_alignStrength(float ret, float probUp) =>
    ret * (2.0 * (probUp / 100.0) - 1.0)

// P1: 40/30/10/10/10 is a documented starting heuristic (Current Reg / Next Reg / Pre / Post / Ovn), not a
// learned or validated allocation — these should eventually be learned from historical predictive
// performance per-leg rather than assumed optimal.
float alignRawScore = f_alignStrength(curRegReturn, curRegProbUp) * 0.40 +
     f_alignStrength(nextRegReturn, nextRegProbUp) * 0.30 +
     f_alignStrength(alignPreReturn, alignPreProbUp) * 0.10 +
     f_alignStrength(alignPostReturn, alignPostProbUp) * 0.10 +
     f_alignStrength(alignOvnReturn, alignOvnProbUp) * 0.10

// Normalized to a 0-100 display scale centered at 50 (neutral), scaled relative to a half-ATR%-sized move
// (the same vol-relative scaling principle already used for noise floors elsewhere) instead of an
// arbitrary fixed range.
float alignScaleDenom = pxEODAnchor > 0 and atr > 0 ? (atr / pxEODAnchor) * 100.0 * 0.5 : 1.0
float alignmentScore = 50.0 + math.max(-1.0, math.min(1.0, alignScaleDenom > 0 ? alignRawScore / alignScaleDenom : 0.0)) * 50.0

// P0: sessionLongConfirm/sessionShortConfirm are an ADDITIONAL confirmation gate ANDed into buySignal/
// sellSignal in §10 — never a replacement for the existing trade-eligibility engine (trend/score/R:R/
// timing/execution quality all still apply in full). i_useSessionAlign defaults OFF, so both booleans stay
// permanently true (no effect) unless explicitly enabled.
bool sessionLongConfirm  = not i_useSessionAlign or sessionPrimaryBull
bool sessionShortConfirm = not i_useSessionAlign or sessionPrimaryBear

string sessionDecision = sessionPrimaryBull ? (secondaryBullCount >= 2 ? "LONG BIAS" : "LONG BIAS (Low Conv)") :
     sessionPrimaryBear ? (secondaryBearCount >= 2 ? "SHORT BIAS" : "SHORT BIAS (Low Conv)") :
     sessionDivergent ? "WAIT (Reg Divergence)" :
     "NEUTRAL/MIXED"

// Asymmetric EOD model volatility band for Next Day Close (see P1-21 note above f_renderSessionOutlookRows'
// skew computation — the asymmetric skew here means this is a bias-shaped range, not a formal 68% CI).
float nextDaySkew = 1.0 + C_SKEW_COEF * math.max(-1.0, math.min(1.0, tomRegBias))
float nextDayHi   = pxNextDay + (dailyRange * 0.5 * volClusterMult * nextDaySkew)
float nextDayLo   = math.max(0.01, pxNextDay - (dailyRange * 0.5 * volClusterMult / nextDaySkew))

// EOD Forecast Accuracy & Return-Probability Calibration Bin Updates. Fires on the regular session's close
// (not calendar midnight, which could land on a pre-market bar) and validates a forecast FROZEN at that
// same event each day, not re-read live via pxNextDay[1] (which drifts, since P0 = live close). Crypto has
// no regular session, so it keeps the calendar-day boundary as its closest analogue.
bool regSessJustClosed = isCrypto ? (ta.change(time("D")) != 0) : (session.ismarket[1] and not session.ismarket)
float regCloseVal = isCrypto ? close : close[1]
float regCloseP0  = isCrypto ? P0    : P0[1]

var float frozenNextDay = na
var float frozenOrigin  = na
var float frozenAtr     = na
// frozenWinRate captures directionalWinRate AT FORECAST TIME — the same accuracy scalar f_retToProb used
// live when the dashboard actually rendered this forecast's probability. Previously the validation below
// re-scored every past forecast with a hardcoded caWinRate=50.0 (forcing accMult=1.0 regardless of what
// was really live), so a forecast shown at e.g. 62% could get bin-classified as if it had been shown at a
// different probability — silently decoupling the calibration bookkeeping from what was actually displayed.
var float frozenWinRate = na
if regSessJustClosed
    frozenNextDay := pxNextDay
    frozenOrigin  := regCloseP0
    frozenAtr     := atr
    frozenWinRate := directionalWinRate

// eodMAE/eodWinRate/eodCount/eodBrier declared earlier (top-of-file, alongside rollBrier) so f_calcConf
// can reference eodBrier/eodCount — updated here below.
if regSessJustClosed and confirmed and not na(frozenNextDay[1]) and frozenOrigin[1] > 0
    eodCount := eodCount + 1.0
    float eodErr = math.abs(regCloseVal - frozenNextDay[1])
    eodMAE := bar_index < 30 ? eodErr : 0.95 * nz(eodMAE, eodErr) + 0.05 * eodErr
    bool eodHit = (frozenNextDay[1] >= frozenOrigin[1] and regCloseVal >= frozenOrigin[1]) or (frozenNextDay[1] < frozenOrigin[1] and regCloseVal < frozenOrigin[1])
    eodWinRate := bar_index < 30 ? 50.0 : (1.0 - C_EWMA_A) * eodWinRate + C_EWMA_A * (eodHit ? 100.0 : 0.0)

    // frozenAtr[1]/frozenOrigin[1] reconstruct the score AS IT WAS COMPUTED at forecast time — the ATR in
    // effect then, and the price level the % return was measured against then — not today's live values,
    // so a yesterday's-forecast is scored against what its dashboard cell actually displayed, not
    // reclassified under today's (possibly very different) volatility regime or price base.
    float retExp = (frozenNextDay[1] - frozenOrigin[1]) / frozenOrigin[1] * 100.0
    float retAct = (regCloseVal - frozenOrigin[1]) / frozenOrigin[1] * 100.0
    // frozenWinRate[1] (not a hardcoded 50.0) reconstructs the EXACT probability that was live-displayed.
    float frozenProbUp = f_retToProb(retExp, frozenAtr[1], nz(frozenWinRate[1], 50.0), frozenOrigin[1])
    float eodProbErr = math.pow(frozenProbUp / 100.0 - (retAct >= 0.0 ? 1.0 : 0.0), 2)
    eodBrier := bar_index < 30 ? eodProbErr : 0.95 * nz(eodBrier, eodProbErr) + 0.05 * eodProbErr

    // P0: online Platt-scaling SGD step, long-horizon resolution point (mirrors the short-horizon step in
    // §9 right after shortHorizonBrier — see that site for the full rationale). x is the RAW (pre-Platt)
    // model score at forecast time, via the shared f_rawProb helper so this can't drift out of sync with
    // what f_retToProb itself computes; y is the actual realized outcome. One gradient step nudges (a,b)
    // toward better separating up-closes from down-closes given that raw score.
    float frozenRawProbUp = f_rawProb(retExp, frozenAtr[1], nz(frozenWinRate[1], 50.0), frozenOrigin[1])
    float plattX2 = (frozenRawProbUp - 50.0) / 50.0
    float plattY2 = retAct >= 0.0 ? 1.0 : 0.0
    float plattP2 = 100.0 / (1.0 + math.exp(-(plattA * plattX2 + plattB)))
    float plattLr2 = 0.02
    plattA := plattA - plattLr2 * (plattP2 / 100.0 - plattY2) * plattX2
    plattB := plattB - plattLr2 * (plattP2 / 100.0 - plattY2)
    plattN := plattN + 1.0

// ─── Projection Pre-compute (Adaptive Chart Timeframe Bias) ───
// Match the forecast horizon to the chart timeframe for maximum precision
float normBias = timeframe.isdaily ? biasEOD :
     (timeframe.multiplier >= 240 ? bias4H :
     (timeframe.multiplier >= 60 ? bias1H :
     bias1H * 0.6 + T_ST * 0.4)) // Faster responsiveness for short-term timeframes

float upFrac    = 0.5 + 0.5 * normBias
float dnFrac    = 1.0 - upFrac
float nextTfHi  = close + atr * 1.2 * upFrac
float nextTfLo  = math.max(0.01, close - atr * 1.2 * dnFrac)

// ─── Expected Opening Range Pre-compute (Projected before 9:30 AM open) ───
float orbExpMult = i_orbLen == "15m" ? 0.60 : 0.813
float expOrbHalfRng = hrlyVol * orbExpMult
float expOrbCenter  = _isExtended ? pxPre : close
float orbBias       = math.max(-1.0, math.min(1.0, biasPreMkt))
float expOrbHi      = expOrbCenter + expOrbHalfRng * (1.0 + 0.15 * orbBias)
float expOrbLo      = math.max(0.01, expOrbCenter - expOrbHalfRng * (1.0 - 0.15 * orbBias))





// ─── Simulated Portfolio Drawdown & Loss Controls ───
var float dailyPnL = 0.0
var float simEquity = i_acctSize
var float peakEquity = i_acctSize
var float maxDrawdown = 0.0

// P1-17: reset dailyPnL on isNewDay (the symbol's native trading-session boundary, already used elsewhere
// for dayHi/dayLo and the volume profile) — NOT an IST calendar-date change. The US regular session runs
// 7:00 PM IST -> 1:30 AM IST, crossing IST midnight while still being ONE trading session; the old
// dayofmonth("Asia/Kolkata") check would reset dailyPnL to 0 in the middle of that session, letting a
// single session's risk silently split across two "daily" loss-limit windows. isNewDay flips once per new
// regular session (at its open), so it never fires mid-session regardless of what IST clock time that is.
if isNewDay
    dailyPnL := 0.0

// P1: dailyLossLimitVal was pinned to the ORIGINAL i_acctSize forever — once simEquity has grown or shrunk
// materially from that starting figure, a fixed-% limit on the original capital stops reflecting the actual
// capital currently at risk. sessionStartEquity snapshots simEquity once per trading session (isNewDay, not
// continuously — so the limit is stable intraday, not a moving target as trades close throughout the day)
// and the %-based limit is computed off THAT.
// P0: this used to ALSO take math.min(...) against a second, ORIGINAL-i_acctSize-based floor, on the
// reasoning that a %-of-shrunk-equity limit could get so small that ordinary noise halts trading. But
// math.min of two negative numbers picks whichever permits the LARGER dollar loss — after a genuine
// drawdown, that floor was WIDER (in absolute $) than sessionStartEquity's own %, so the daily cap silently
// permitted MORE relative risk exactly when the account was already damaged — the opposite of what a risk
// control should do under drawdown. dailyLossLimitVal is now a strict %-of-CURRENT-session-equity cap, full
// stop: i_dailyLossLim applies consistently regardless of how much simEquity has grown or shrunk since
// inception, with no floor loosening it back toward the original account size.
var float sessionStartEquity = i_acctSize
if isNewDay
    sessionStartEquity := simEquity
float dailyLossLimitVal = -sessionStartEquity * (i_dailyLossLim / 100.0)
bool dailyLossHalted    = dailyPnL <= dailyLossLimitVal

// Execution Quality Filter (Pre-Trade Gates)
float atrMA          = ta.sma(atr, 20)
bool isAtrShock      = atrMA > 0 and atr / atrMA > 2.5
bool isExcessiveGap  = close[1] > 0 and math.abs(open - close[1]) / close[1] > 0.015
float volMA_exec     = ta.sma(volume, 20)
bool isLiquidityThin = volMA_exec > 0 and volume / volMA_exec < 0.5
float bodySz_exec    = math.abs(close - open)
float rangeSz_exec   = high - low
bool isDojiShock     = rangeSz_exec > 0 and bodySz_exec / rangeSz_exec < 0.15

bool isVixExtreme = not na(vixClose) and vixClose > 35.0
// P0: consecutive-loss circuit breaker (#37) — lossCooldownActive checks the SAME executionOk gate every
// other pre-trade filter already goes through, rather than a separate ad hoc check at the entry site.
// lossCooldownUntilBar (declared in §2, updated at the win/loss tally in §10's Exit block) is set to
// bar_index + i_lossCooldownBars once i_maxConsecLosses trips; this expires on its own once bar_index
// passes it, so it can never permanently lock the strategy out.
bool lossCooldownActive = not na(lossCooldownUntilBar) and bar_index < lossCooldownUntilBar
bool executionOk = not isAtrShock and not isExcessiveGap and not isLiquidityThin and not isDojiShock and not dailyLossHalted and not isMacroShock and not isVixExtreme and not lossCooldownActive

// §10  TRADE EXECUTION & POSITION MANAGEMENT
// ════════════════════════════════════════════════════════════════════════

var float entryTrend = 0.5
var float entryLiq   = 0.5
var float entryMom   = 0.5
var float entryRs    = 0.5
var float entryVol   = 0.5
var float entryPosSize = 0.0

var bool   inLong   = false,  var bool   inShort   = false
var float  entryPx  = na,     var float  slPx      = na
var float  tp1Px    = na,     var float  tp2Px     = na,   var float tp3Px = na
var int    entryBar = na,     var string tradeDir  = "FLAT"
var string slState  = "—",    var string entryGrade = "—"
var bool   tp1Hit   = false,  var bool   tp2Hit    = false, var bool tp3Hit = false
var float  peakPx   = na


// ─── Adaptive Stop-Loss: symmetric structural anchors (Fix #7) ───
float slFallbackLong = close - atr * 1.5
float bestSLLong     = slFallbackLong
float maxSlDist      = atr * 3.0

if not na(lastSL) and lastSL < close and close - lastSL <= maxSlDist
    bestSLLong := math.max(bestSLLong, lastSL)
if array.size(obBots) > 0
    float ob = array.get(obBots, array.size(obBots) - 1)
    if not na(ob) and ob < close and close - ob <= maxSlDist
        bestSLLong := math.max(bestSLLong, ob)
if not na(vpVAL) and vpVAL < close and close - vpVAL <= maxSlDist
    bestSLLong := math.max(bestSLLong, vpVAL)
if not na(dayLo) and dayLo < close and close - dayLo <= maxSlDist
    bestSLLong := math.max(bestSLLong, dayLo)

// Symmetric Bearish structural resistance stop
float slFallbackBear = close + atr * 1.5
float bestSLBear     = slFallbackBear

if not na(lastSH) and lastSH > close and lastSH - close <= maxSlDist
    bestSLBear := math.min(bestSLBear, lastSH)
if array.size(bearObTops) > 0
    float obT = array.get(bearObTops, array.size(bearObTops) - 1)
    if not na(obT) and obT > close and obT - close <= maxSlDist
        bestSLBear := math.min(bestSLBear, obT)
if not na(vpVAH) and vpVAH > close and vpVAH - close <= maxSlDist
    bestSLBear := math.min(bestSLBear, vpVAH)
if not na(dayHi) and dayHi > close and dayHi - close <= maxSlDist
    bestSLBear := math.min(bestSLBear, dayHi)

bool isBearBias = effectiveTrend == -1
float riskDistLong = math.max(atr * 0.3, close - bestSLLong)
float riskDistShort = math.max(atr * 0.3, bestSLBear - close)
float riskDist = isBearBias ? riskDistShort : riskDistLong

// P0: gap/event-risk-adjusted sizing (#34) — riskDollars/riskDist alone assumes the position can always
// exit AT the stop; SOXL (3x leveraged) can gap straight through it overnight on macro/semiconductor news,
// realizing a materially larger loss than the nominal stop distance implies. gapHistDollar tracks the last
// 60 sessions' actual opening gap magnitude (|open - prior close|, $ terms) so gapRiskP95 reflects this
// INSTRUMENT's own realized gap behavior rather than a generic assumption — it starts near 0 and only
// becomes meaningful once real sessions have populated most of the 60 slots (conservative: during warmup
// this term just contributes nothing, falling back to whichever of the other two is larger, never zeroing
// out sizing). effectiveRiskDist — used ONLY for SIZING below (kellyTargetPosSize/rawPosSize), never for
// where slPx/tp*Px actually get placed, which stay anchored to the structural riskDist — is whichever of
// the nominal stop distance, the 95th-percentile historical gap, or a stress-scaled distance
// (eventVolMultiplier, already computed in §9b from FOMC/CPI/earnings flags + auto-detected macro/vol
// spikes) is largest, so a realistic worst-case fill shrinks the position size even when the nominal
// ATR-based stop distance alone looks tight.
var array<float> gapHistDollar = array.new<float>(60, 0.0)
var int gapHistIdx = 0
if isNewDay
    float gapAbs = not na(close[1]) and close[1] > 0 ? math.abs(open - close[1]) : 0.0
    array.set(gapHistDollar, gapHistIdx, gapAbs)
    gapHistIdx := (gapHistIdx + 1) % 60
float gapRiskP95 = array.percentile_nearest_rank(gapHistDollar, 95)
float eventStressRiskDist = riskDist * eventVolMultiplier
float effectiveRiskDist = math.max(riskDist, math.max(gapRiskP95, eventStressRiskDist))

// Volatility Targeting & Kelly Position Sizing Calculations
float currentDrawdown = peakEquity > 0 ? (peakEquity - simEquity) / peakEquity * 100.0 : 0.0
maxDrawdown := math.max(maxDrawdown, currentDrawdown)
// P0: modelHealthScore (§9 — directional accuracy + forecast error + probability calibration composite)
// was computed but never fed back into sizing, so a genuinely degraded model kept risking full size
// indefinitely. healthRiskMult scales risk down as health degrades, layered on top of (not replacing) the
// drawdown throttle above. Gated on eodCount>=10 (same threshold f_calcConf already uses to trust eodBrier)
// before applying at all — modelHealthScore's brierComp term sits pinned at a neutral 0 until real
// out-of-sample EOD validations exist (eodBrier starts at the 0.25 coin-flip baseline and only updates once
// per session close), so scoring it before then would read as "unhealthy" purely from lack of data, not
// genuine degradation — that would gate the very first trades needed to ever accumulate real history.
// Floored at 0.25 rather than 0 (unlike the review's suggested <50->0%): a hard zero on a live composite
// score risks a permanent lockout if modelHealthScore settles in a persistently mediocre range under normal
// operation, not just genuine breakdown — a 75% cut is still a real, meaningful risk reduction without
// being able to brick the strategy's ability to ever trade again.
float healthRiskMult = eodCount < 10.0 ? 1.0 : (modelHealthScore >= 80.0 ? 1.0 : (modelHealthScore >= 65.0 ? 0.75 : (modelHealthScore >= 50.0 ? 0.50 : 0.25)))
float activeRiskPct = (currentDrawdown > 5.0 ? i_riskPct * 0.5 : i_riskPct) * healthRiskMult

// 1. Risk Dollars
float riskDollars = simEquity * activeRiskPct / 100.0

// 2. Volatility Sizing
float targetVolVal = i_targetVol / 100.0
float volTargetPosSize = realizedVolAnn > 0 ? (simEquity * targetVolVal) / (realizedVolAnn * close) : 0.0

// 3. Rolling Fractional Kelly Sizing (Fix Medium #7: Rolling win-rate AND rolling win/loss magnitude over i_rollWin)
float rollSumWinR   = 0.0
float rollCountWin  = 0.0
float rollSumLossR  = 0.0
float rollCountLoss = 0.0
// P0: sumR/sumRSq accumulated in the SAME pass over histOutcome, for the general-distribution Kelly
// formula below that replaces the old win-rate/win-loss-ratio f_calcKelly call.
float rollSumR   = 0.0
float rollSumRSq = 0.0
int activeLenK = math.min(totalTrades, i_rollWin)
if activeLenK > 0
    for k = 0 to activeLenK - 1
        float otK = array.get(histOutcome, k)
        rollSumR   += otK
        rollSumRSq += otK * otK
        if otK > 0
            rollSumWinR  += otK
            rollCountWin += 1.0
        else if otK < 0
            rollSumLossR  += math.abs(otK)
            rollCountLoss += 1.0

float blendedTargetRR = i_tp1R * 0.50 + i_tp2R * 0.30 + i_tp3R * 0.20
float rollAvgWinR     = rollCountWin > 0 ? rollSumWinR / rollCountWin : blendedTargetRR
float rollAvgLossR    = rollCountLoss > 0 ? rollSumLossR / rollCountLoss : 1.0
float rollAvgWinLoss  = rollAvgLossR > 0 ? rollAvgWinR / rollAvgLossR : blendedTargetRR
// P0: replaced the textbook binary-outcome Kelly (win-rate + win/loss RATIO) with the general-distribution
// formula f*=E[R]/E[R^2], computed directly from the ACTUAL realized R-multiple distribution (histOutcome)
// via rollSumR/rollSumRSq above — the binary formula assumes every trade is either a fixed win of size b
// or a fixed loss of 1, which this strategy's partial exits/trailing stops/variable holding periods/gap
// fills don't produce; collapsing the real, variable-sized R-multiples into "win-rate + one ratio" discards
// exactly the distribution shape Kelly needs. f*=E[R]/E[R^2] is the growth-optimal fraction for ANY
// per-trade return distribution sized as a fraction of capital, not just a binary one. rollMeanRLCB (a
// lower-confidence-bound: the mean minus one standard error) shrinks the numerator toward zero when the
// sample doesn't yet clearly separate from zero, instead of trusting a noisy small-N mean at full
// strength — a practical guard against Kelly overbetting on an estimate that's still mostly noise.
float rollMeanR    = activeLenK > 0 ? rollSumR / activeLenK : 0.0
float rollMeanRSq  = activeLenK > 0 ? rollSumRSq / activeLenK : 0.0
float rollVarR     = activeLenK > 1 ? math.max(0.0, rollMeanRSq - rollMeanR * rollMeanR) : 0.0
float rollSeR      = activeLenK > 1 ? math.sqrt(rollVarR / activeLenK) : math.abs(rollMeanR)
float rollMeanRLCB = math.max(0.0, rollMeanR - rollSeR)
float kellyFValRaw = activeLenK >= 5 and rollMeanRSq > 0 ? rollMeanRLCB / rollMeanRSq : 0.0
float kellyFVal    = math.max(0.0, math.min(1.0, kellyFValRaw)) * math.max(0.05, math.min(1.0, i_kellyFract))
// P0: sized off effectiveRiskDist (gap/event-adjusted, see #34 above), not the bare structural riskDist.
float kellyTargetPosSize = effectiveRiskDist > 0 ? (simEquity * kellyFVal) / effectiveRiskDist : 0.0

// P1-16: Kelly is extremely sensitive to estimation error, and this model's outcome distribution (partial
// exits, trailing stops, regime changes, varying holding periods and stop distances) doesn't resemble the
// simple fixed-payoff assumptions textbook Kelly is easiest to trust under — a small rolling sample makes
// the win-rate/win-loss-ratio inputs themselves noisy. Previously this trusted Kelly at FULL strength the
// instant totalTrades hit 5, an abrupt switch with no confidence weighting for how thin that sample still
// is. kellyConfidence now ramps smoothly from 0 (no real trade history — pure vol-target sizing, Kelly
// contributes nothing) to 1.0 only once i_kellyMinTrades (default 30) real trades have been recorded,
// blending continuously between the conservative vol-target size and the fractional-Kelly size in between.
// This is a separate, slower schedule than the factor-weight learning's totalTrades>=5 warmup — see the
// comment above wTrend's declaration for the other one.
float kellyConfidence = math.max(0.0, math.min(1.0, (totalTrades - 5.0) / math.max(1.0, i_kellyMinTrades - 5.0)))
// P1: Kelly error scales with estimation error in win-rate/win-loss-ratio, and i_kellyMinTrades (default 30)
// is still a small sample for those inputs — full 0.25-fractional-Kelly sizing off 30 trades isn't
// institutionally trustworthy on its own. Rather than letting kellyConfidence ramp all the way to a FULL
// substitution of volTargetPosSize once N>=30, Kelly's influence is capped to at most a +-20% adjustment off
// the vol-target base at any confidence level — vol-target sizing remains the base size; Kelly only nudges
// it, it never fully replaces it, however much trade history accumulates.
float kellyDelta       = kellyTargetPosSize - volTargetPosSize
float kellyDeltaCapped = math.max(-volTargetPosSize * 0.20, math.min(volTargetPosSize * 0.20, kellyDelta))
float activeKellyPosSize = volTargetPosSize + kellyConfidence * kellyDeltaCapped

// Hard cap on gross exposure (position notional as a % of equity) — independent of what Kelly/vol-target/
// risk-based sizing compute, so no combination of those estimates can size a position beyond a fixed,
// user-controlled ceiling.
float maxExposureShares = (simEquity * i_maxGrossExposurePct / 100.0) / close

// P0: sized off effectiveRiskDist (gap/event-adjusted, see #34 above), not the bare structural riskDist —
// slPx/tp*Px placement further down still uses riskDist unchanged; only the SHARE COUNT shrinks to reflect
// realistic worst-case fill risk.
float rawPosSize = effectiveRiskDist > 0 ? math.min(riskDollars / effectiveRiskDist, math.min(volTargetPosSize, math.min(activeKellyPosSize, maxExposureShares))) : 0.0
float posSize = rawPosSize >= 0.5 ? math.floor(rawPosSize) : 0.0
// P1: literal cash-on-hand backstop (can't buy more shares than current equity actually funds) — now
// redundant BY DESIGN with maxExposureShares/i_maxGrossExposurePct above (capped at 100, see that input's
// comment) rather than silently overriding a config that implied more than 100% was reachable. Kept as a
// second, independent floor/close-based check rather than relying on maxExposureShares alone.
posSize := math.min(posSize, math.floor(simEquity / close))

// P0-8: TRADE ELIGIBILITY ENGINE — these R:R / overextension / timing gates used to live ONLY inside the
// barstate.islast-gated dashboard block (§12), computed purely for display. buySignal/sellSignal (below)
// never saw them, so it was possible for buySignal to fire (an alert + a real internal entry) on the exact
// same bar the dashboard displayed "Suspended (R:R < 2x)" / "Suspended (Await Pullback)" / "Suspended
// (Outside Window)" — two independent decision paths that could disagree. They're now computed HERE, on
// every bar (not just the last one), and folded directly into buySignal/sellSignal, so there is exactly
// ONE eligibility engine; the dashboard (§12) now only READS these same booleans instead of recomputing
// its own copy, guaranteeing the "why suspended" message can never contradict whether a signal actually fired.
float boEntry  = isBearBias ? math.min(low[1], close - atr * 0.8) : math.max(high[1], close + atr * 0.8)
float potSL    = isBearBias ? bestSLBear : bestSLLong
float structRiskAgg = math.max(atr * 0.3, math.abs(close - potSL))

float structTargetLong = na
if not na(vpVAH) and vpVAH > close and vpVAH - close <= maxSlDist
    structTargetLong := vpVAH
if not na(lastSH) and lastSH > close and lastSH - close <= maxSlDist
    structTargetLong := na(structTargetLong) ? lastSH : math.min(nz(structTargetLong), lastSH)
if not na(prevDayH) and prevDayH > close and prevDayH - close <= maxSlDist
    structTargetLong := na(structTargetLong) ? prevDayH : math.min(nz(structTargetLong), prevDayH)
bool targetFallbackLong = na(structTargetLong)
if targetFallbackLong
    structTargetLong := close + atr * i_tp1R  // Fallback

float structTargetShort = na
if not na(vpVAL) and vpVAL < close and close - vpVAL <= maxSlDist
    structTargetShort := vpVAL
if not na(lastSL) and lastSL < close and close - lastSL <= maxSlDist
    structTargetShort := na(structTargetShort) ? lastSL : math.max(nz(structTargetShort), lastSL)
if not na(prevDayL) and prevDayL < close and close - prevDayL <= maxSlDist
    structTargetShort := na(structTargetShort) ? prevDayL : math.max(nz(structTargetShort), prevDayL)
bool targetFallbackShort = na(structTargetShort)
if targetFallbackShort
    structTargetShort := close - atr * i_tp1R  // Fallback

float structRewardAgg = isBearBias ? math.abs(close - nz(structTargetShort, close - atr)) : math.abs(nz(structTargetLong, close + atr) - close)
float rrAgg = structRiskAgg > 0 ? structRewardAgg / structRiskAgg : 0.0

float boRisk = math.max(atr * 0.3, math.abs(boEntry - potSL))
float boReward = isBearBias ? math.abs(boEntry - nz(structTargetShort, boEntry - atr)) : math.abs(nz(structTargetLong, boEntry + atr) - boEntry)
float rrBo = boRisk > 0 ? boReward / boRisk : 0.0

bool badTiming = not inKillZone or rvol < 1.0
bool isOverextendedLong  = (inDiscount == false and priceDepth > 65.0) or rsi > 75.0
bool isOverextendedShort = (inPremium == false and priceDepth < 35.0) or rsi < 25.0

// P1-28: R:R = 2.5 off a genuine structural target (VAH/swing-high/prior-day-high) and R:R = 2.5 off a
// synthetic ATR-multiple fallback (no real level existed above/below close) are not equivalent claims —
// the fallback target is mathematically generated, not a level price has any particular reason to reach.
// Requiring a higher bar (3.0x) when targetFallbackLong/Short is true means the model demands more
// theoretical edge to compensate for the weaker (synthetic, not structural) reward-side evidence, instead
// of treating both R:R sources as equally trustworthy the way a flat 2.0x threshold did for both.
float rrMinLong  = targetFallbackLong  ? 3.0 : 2.0
float rrMinShort = targetFallbackShort ? 3.0 : 2.0

// P0: sessionLongConfirm/sessionShortConfirm (§9b Session Alignment Engine) appended as an ADDITIONAL
// gate — permanently true (no effect) unless i_useSessionAlign is explicitly enabled.
bool buySignal  = confirmed and _isUsMkt and effectiveTrend == 1 and sComposite >= minScore and (setupGrade == "A+" or setupGrade == "A" or setupGrade == "B") and executionOk and posSize > 0 and rrAgg >= rrMinLong and not isOverextendedLong and not badTiming and sessionLongConfirm
bool sellSignal = confirmed and _isUsMkt and canShort and effectiveTrend == -1 and bearConf >= bearMinScore and (shortGrade == "A+" or shortGrade == "A" or shortGrade == "B") and executionOk and posSize > 0 and rrBo >= rrMinShort and not isOverextendedShort and not badTiming and sessionShortConfirm

// P1-18: dynamic slippage multiplier — a fixed 5bps/side is a baseline assumption, not an execution model.
// Real slippage scales with liquidity (thin volume -> wider effective spread), volatility regime (VIX,
// realized vol clustering), and gap risk (SOXL specifically gaps hard around overnight semiconductor/macro
// news, and a gapped fill effectively crosses a much wider spread than a quiet one) — reuses signals
// already computed elsewhere (rvol, volClusterMult, vixRegimeScale, isExcessiveGap) rather than inventing
// new proprietary microstructure inputs this script has no way to observe (true spread, ADV, order-book
// depth, queue position). Each component is individually bounded, then the combined multiplier is clamped
// to [0.5x, 5x] so it can widen or (mildly) narrow the base assumption without ever degenerating. Moved
// above the Entry block (was previously declared after it) so entryPx below can use it — see entryPx's own
// comment for why.
float liquidityMult   = math.max(1.0, 1.0 / math.max(0.2, math.min(1.0, rvol)))
float gapSlipMult     = isExcessiveGap ? 2.5 : 1.0
float dynSlippageMult = math.max(0.5, math.min(5.0, volClusterMult * vixRegimeScale * liquidityMult * gapSlipMult))
float effSlippageBps  = i_slippageBps * dynSlippageMult

// ─── Entry (Long & Short Execution Engine) ───
if buySignal and not inLong and not inShort
    inLong     := true
    // P0: entryPx now reflects a REALISTIC fill (signal price + expected entry-side slippage), not the raw
    // theoretical close — riskDist/posSize/rrAgg above are still computed off the frictionless signal price
    // (correct for a PRE-TRADE eligibility check, since no real fill exists until a trade actually opens),
    // but SL/TP levels derived FROM the fill should reflect what was actually paid, not the frictionless
    // quote. f_partialExitPnl/the final-exit friction calc below had this same entry-side slippage baked in
    // as a SEPARATE cost on top of an unadjusted entryPx — now that it's folded directly into entryPx
    // instead, both friction formulas drop their own entry-side term to avoid double-charging it (the math
    // is unchanged in total: (exitPx - adjustedEntryPx) - exitSideFriction is algebraically identical to
    // (exitPx - close) - entrySideFriction - exitSideFriction).
    entryPx    := close * (1.0 + effSlippageBps / 10000.0)
    slPx       := entryPx - riskDist
    tp1Px      := entryPx + riskDist * i_tp1R
    tp2Px      := entryPx + riskDist * i_tp2R
    tp3Px      := entryPx + riskDist * i_tp3R
    entryBar   := bar_index
    tradeDir   := "LONG"
    slState    := "STRUCT SL"
    entryGrade := setupGrade
    tp1Hit     := false
    tp2Hit     := false
    tp3Hit     := false
    peakPx     := close
    entryTrend := fTrend
    entryLiq   := fLiquidity
    entryMom   := fMomentum
    entryRs    := fRelStrength
    entryVol   := fExec
    entryPosSize := posSize
    // Fix 4 & 7: Long entry calibration blending using Long-specific calibration arrays
    float sigL   = f_sigmoid((sComposite - bearConf) / 50.0, i_sigmoidK)
    int _calBinL = math.min(4, math.floor(sigL / 20.0))
    float _empPL  = array.get(calBinEmpPLong, _calBinL)
    float _empNL  = array.get(calBinTotalLong, _calBinL)
    float _blendL = math.min(1.0, _empNL / 20.0)
    float baseProbL = _blendL * _empPL + (1.0 - _blendL) * sigL
    // Fix 6: Dynamic Model Consensus Divergence Penalty
    float setupBiasL = (sComposite - bearConf) / 50.0
    float forecastBiasL = (pxEODAnchor > 0 and atr > 0) ? (pxEOD - pxEODAnchor) / atr : 0.0
    float divDistL = math.abs(setupBiasL - forecastBiasL)
    float divPenaltyL = math.max(0.80, 1.0 - divDistL * 0.10)
    openTradeProb := baseProbL * divPenaltyL

else if sellSignal and not inLong and not inShort
    inShort    := true
    // See the long-side entryPx comment above — same rationale, mirrored for a short fill (receives
    // slightly LESS than the quoted price, not more).
    entryPx    := close * (1.0 - effSlippageBps / 10000.0)
    slPx       := entryPx + riskDist
    tp1Px      := entryPx - riskDist * i_tp1R
    tp2Px      := entryPx - riskDist * i_tp2R
    tp3Px      := entryPx - riskDist * i_tp3R
    entryBar   := bar_index
    tradeDir   := "SHORT"
    slState    := "STRUCT SL"
    entryGrade := shortGrade
    tp1Hit     := false
    tp2Hit     := false
    tp3Hit     := false
    peakPx     := close
    entryTrend := fTrendBear
    entryLiq   := fLiquidityBear
    entryMom   := fMomentumBear
    entryRs    := fRelStrengthBear
    entryVol   := fExecBear
    entryPosSize := posSize
    // Fix 4 & 7: Short entry calibration blending using Short-specific calibration arrays
    float sigS   = f_sigmoid((bearConf - sComposite) / 50.0, i_sigmoidK)
    int _calBinS = math.min(4, math.floor(sigS / 20.0))
    float _empPS  = array.get(calBinEmpPShort, _calBinS)
    float _empNS  = array.get(calBinTotalShort, _calBinS)
    float _blendS = math.min(1.0, _empNS / 20.0)
    float baseProbS = _blendS * _empPS + (1.0 - _blendS) * sigS
    // Fix 6: Dynamic Model Consensus Divergence Penalty
    float setupBiasS = (bearConf - sComposite) / 50.0
    float forecastBiasS = (pxEODAnchor > 0 and atr > 0) ? (pxEODAnchor - pxEOD) / atr : 0.0
    float divDistS = math.abs(setupBiasS - forecastBiasS)
    float divPenaltyS = math.max(0.80, 1.0 - divDistS * 0.10)
    openTradeProb := baseProbS * divPenaltyS

// Dollar P&L + friction for ONE tranche of a trade, booked at its own fill price/share count. Pure (no
// mutation) — callers apply the result to simEquity/dailyPnL/bankedFriction themselves. P0: entry-side
// slippage is no longer charged HERE — it's already baked directly into entryPxVal (see entryPx's own
// comment at the Entry block above) — charging it again here would double-count it. Exit-side slippage +
// commission are still real, separate costs incurred at THIS tranche's own exit and stay here.
f_partialExitPnl(float entryPxVal, float exitPxVal, float shares, bool isLong) =>
    float grossPerShare = isLong ? (exitPxVal - entryPxVal) : (entryPxVal - exitPxVal)
    float frictionPerShareVal = exitPxVal * (effSlippageBps / 10000.0) + i_commissionPerShare * 2.0
    float netPnlDollars = (grossPerShare - frictionPerShareVal) * shares
    [netPnlDollars, frictionPerShareVal * shares]

// ─── Active Scaled Position Tracking (Fix Critical Bug #2: Partial Exit Profit Banking) ───
var float bankedR = 0.0
var float remFrac = 1.0
var float initialRiskPx = 0.0
// Fix P0-2: sum of $ friction already booked at TP1/TP2/TP3 tranche exits this trade, so the final exit's
// R-multiple cost (costInR below) reflects ALL tranches' friction, not just the last one's.
var float bankedFriction = 0.0
// P0-6: sum of REAL $ P&L already booked at TP1/TP2/TP3 tranche exits this trade — so the final win/loss
// classification and grossWin/grossLoss below can use the trade's COMPLETE economics (all tranches), not
// just whatever the last remaining tranche happened to do. Previously wins/losses/grossWin/grossLoss used
// only the final tranche's per-share netPnl, so e.g. +0.75R at TP1 + +0.90R at TP2 + -1.00R on the
// remainder would get globally counted as a LOSS despite the trade being net profitable overall.
var float bankedDollarPnl = 0.0

if (buySignal and not inLong) or (sellSignal and not inShort)
    bankedR := 0.0
    remFrac := 1.0
    initialRiskPx := riskDist
    bankedFriction := 0.0
    bankedDollarPnl := 0.0

if inLong and confirmed
    // P0: track the bar's actual intrabar HIGH, not close — a long that traded $100->$104->closed $101
    // reached a genuine $104 peak; using close alone would silently understate it as $101, pulling the
    // eventual trail = peakPx - atr*i_trailMult level closer to price than the position's real run-up
    // justifies. This is still an OHLC-only approximation (Pine has no tick data to confirm the true
    // intrabar peak beyond "the high printed"), not a claim of tick-level precision.
    peakPx := math.max(nz(peakPx, close), high)

    // Fix P0-3: if this bar's range would ALSO have hit the stop (at its level BEFORE this bar's TP
    // processing), OHLC data can't tell us whether price touched the TP or the SL first — assume SL-first
    // (the standard conservative backtest convention) instead of banking TP profit that may not have
    // actually happened before the stop, which the original high-then-low check order silently assumed.
    bool slAlsoInRangeLong = low <= slPx
    if not slAlsoInRangeLong
        if high >= tp1Px and not tp1Hit
            tp1Hit  := true
            bankedR := bankedR + 0.50 * i_tp1R
            remFrac := remFrac - 0.50
            slPx    := math.max(slPx, entryPx)
            slState := "BREAK-EVEN"
            // Fix P0-2: book this tranche's $ P&L now, at its OWN fill price, instead of pricing the whole
            // position at the eventual final exit (which ignored that 50% already sold here at a better price).
            [tp1NetPnl, tp1Fric] = f_partialExitPnl(entryPx, tp1Px, entryPosSize * 0.50, true)
            simEquity  := simEquity + tp1NetPnl
            peakEquity := math.max(peakEquity, simEquity)
            dailyPnL   := dailyPnL + tp1NetPnl
            bankedFriction := bankedFriction + tp1Fric
            bankedDollarPnl := bankedDollarPnl + tp1NetPnl

        // P0-7: re-check the stop against THIS SAME bar's low using the level it stands at AFTER TP1 just
        // moved it to breakeven — not only the bar's opening stop level (slAlsoInRangeLong above). Without
        // this, a single wide-range candle could tag TP1, move stop to BE, then also tag TP2/TP3, silently
        // assuming the bar's low never round-tripped back through the new BE level in between — OHLC data
        // can't prove the true intrabar order, so this applies the SAME conservative SL-first convention
        // already used above, just re-run against the stop as it stands after each move. If the bar's low
        // also breaches the new BE level, TP2/TP3 are blocked here and the actual exit is still correctly
        // picked up moments later by the Exit section below (bar_index > entryBar, using this same updated
        // slPx). This is still an OHLC-based approximation, not a true intrabar reconstruction — genuinely
        // resolving the ordering needs lower-timeframe execution data (e.g. request.security_lower_tf() to
        // replay 1m bars under a 15m signal), which is a materially larger, separate undertaking.
        bool slHitAfterTp1 = tp1Hit and low <= slPx
        if not slHitAfterTp1
            if high >= tp2Px and not tp2Hit
                tp2Hit  := true
                bankedR := bankedR + 0.30 * i_tp2R
                remFrac := remFrac - 0.30
                [tp2NetPnl, tp2Fric] = f_partialExitPnl(entryPx, tp2Px, entryPosSize * 0.30, true)
                simEquity  := simEquity + tp2NetPnl
                peakEquity := math.max(peakEquity, simEquity)
                dailyPnL   := dailyPnL + tp2NetPnl
                bankedFriction := bankedFriction + tp2Fric
                bankedDollarPnl := bankedDollarPnl + tp2NetPnl

            if high >= tp3Px and not tp3Hit
                tp3Hit  := true
                bankedR := bankedR + 0.20 * i_tp3R
                remFrac := remFrac - 0.20
                [tp3NetPnl, tp3Fric] = f_partialExitPnl(entryPx, tp3Px, entryPosSize * 0.20, true)
                simEquity  := simEquity + tp3NetPnl
                peakEquity := math.max(peakEquity, simEquity)
                dailyPnL   := dailyPnL + tp3NetPnl
                bankedFriction := bankedFriction + tp3Fric
                bankedDollarPnl := bankedDollarPnl + tp3NetPnl

        // Trailing update is intentionally NOT re-checked against THIS SAME bar's low (unlike the P0-3/P0-7
        // SL-first re-checks above) — the new trail level only gets tested starting next bar via canExit
        // (bar_index > entryBar). OHLC can't prove whether this bar's low touched the fresh trail level
        // before or after the high that produced peakPx, so re-checking same-bar would be just as much an
        // approximation as leaving it — this deliberately gives the position the full remainder of the
        // current bar before the tightened stop can apply, rather than guessing an intrabar order.
        if tp1Hit
            float trail = peakPx - atr * i_trailMult
            if trail > slPx
                slPx    := trail
                slState := "TRAILING"

else if inShort and confirmed
    // P0: short-side mirror of the long-side note above — tracks the bar's actual intrabar LOW, not close.
    peakPx := math.min(nz(peakPx, close), low)

    bool slAlsoInRangeShort = high >= slPx
    if not slAlsoInRangeShort
        if low <= tp1Px and not tp1Hit
            tp1Hit  := true
            bankedR := bankedR + 0.50 * i_tp1R
            remFrac := remFrac - 0.50
            slPx    := math.min(slPx, entryPx)
            slState := "BREAK-EVEN"
            [tp1NetPnlS, tp1FricS] = f_partialExitPnl(entryPx, tp1Px, entryPosSize * 0.50, false)
            simEquity  := simEquity + tp1NetPnlS
            peakEquity := math.max(peakEquity, simEquity)
            dailyPnL   := dailyPnL + tp1NetPnlS
            bankedFriction := bankedFriction + tp1FricS
            bankedDollarPnl := bankedDollarPnl + tp1NetPnlS

        // P0-7 (short side mirror): re-check the stop against THIS SAME bar's high at the level it stands
        // at AFTER TP1 just moved it to breakeven — see the long-side comment above for full rationale.
        bool slHitAfterTp1S = tp1Hit and high >= slPx
        if not slHitAfterTp1S
            if low <= tp2Px and not tp2Hit
                tp2Hit  := true
                bankedR := bankedR + 0.30 * i_tp2R
                remFrac := remFrac - 0.30
                [tp2NetPnlS, tp2FricS] = f_partialExitPnl(entryPx, tp2Px, entryPosSize * 0.30, false)
                simEquity  := simEquity + tp2NetPnlS
                peakEquity := math.max(peakEquity, simEquity)
                dailyPnL   := dailyPnL + tp2NetPnlS
                bankedFriction := bankedFriction + tp2FricS
                bankedDollarPnl := bankedDollarPnl + tp2NetPnlS

            if low <= tp3Px and not tp3Hit
                tp3Hit  := true
                bankedR := bankedR + 0.20 * i_tp3R
                remFrac := remFrac - 0.20
                [tp3NetPnlS, tp3FricS] = f_partialExitPnl(entryPx, tp3Px, entryPosSize * 0.20, false)
                simEquity  := simEquity + tp3NetPnlS
                peakEquity := math.max(peakEquity, simEquity)
                dailyPnL   := dailyPnL + tp3NetPnlS
                bankedFriction := bankedFriction + tp3FricS
                bankedDollarPnl := bankedDollarPnl + tp3NetPnlS

        // Short-side mirror of the long-side trailing note above — same deliberate next-bar-only check.
        if tp1Hit
            float trail = peakPx + atr * i_trailMult
            if trail < slPx
                slPx    := trail
                slState := "TRAILING"

// ─── Exit (Long & Short) ───
// P0: TP3 (the last partial-exit tranche) can bring remFrac to exactly 0 — meaning zero shares remain —
// while inLong/inShort stayed true until whatever LATER bar happened to trip a separate SL/CHoCH condition.
// A fully liquidated trade (remFrac<=0) isn't "open" in any economic sense: it blocked new entries
// (buySignal/sellSignal require not inLong/not inShort) for however many bars until that unrelated
// condition eventually fired — in a flat/rangebound market that might never happen, permanently locking the
// model out of new signals despite genuinely holding zero shares. longTpExhausted/shortTpExhausted force
// the SAME finalization (state reset, rolling-array recording, win/loss tally) to run on the exact bar
// remFrac reaches zero — remShares further down naturally evaluates to 0 in that case, so fill/friction
// values are irrelevant (multiplied by zero) and total P&L is exactly what TP1-3 already banked.
bool longTpExhausted  = inLong  and remFrac <= 0.0
bool shortTpExhausted = inShort and remFrac <= 0.0

// P0: dailyMtmHalted forces a full exit when the OPEN position's live mark-to-market loss alone (not just
// already-REALIZED dailyPnL from past exits) breaches the daily loss limit. dailyLossHalted/executionOk
// only ever saw REALIZED P&L, so a position could be deeply underwater on paper — well past the configured
// daily risk budget — with no mechanism to close it before its own stop eventually got hit; the daily loss
// limit only ever blocked NEW entries after a loss had already been booked. Since this script only ever
// holds one position at a time, unrealized P&L couldn't previously affect an ENTRY decision (entries
// require not inLong/not inShort, so no position is open when one is being considered) — this is the one
// place unrealized P&L actually needed to matter: forcing the existing position closed once its own live
// loss alone exceeds the day's risk budget, not just gating what comes after it.
float unrealizedPnL = inLong ? (close - entryPx) * entryPosSize * math.max(0.0, remFrac) : (inShort ? (entryPx - close) * entryPosSize * math.max(0.0, remFrac) : 0.0)
float dailyMTM = dailyPnL + unrealizedPnL
bool dailyMtmHalted = dailyMTM <= dailyLossLimitVal

bool canExit       = confirmed and not na(entryBar) and bar_index > entryBar
// P0: maxHoldExceeded (#36) — without a hard cap, a trade can stay open indefinitely if price never
// reaches SL, TP, or a CHoCH (e.g. a long, quiet chop after entry) — capital stays committed and no new
// signal can be taken (buySignal/sellSignal require not inLong/not inShort) for however long that lasts.
// i_maxHoldBars=0 disables this entirely.
bool maxHoldExceeded = i_maxHoldBars > 0 and canExit and (bar_index - entryBar) >= i_maxHoldBars
bool longSLhit     = canExit and inLong and low <= slPx
bool longFullExit  = longSLhit or (canExit and inLong and bearCHoCH) or longTpExhausted or (canExit and inLong and dailyMtmHalted) or (inLong and maxHoldExceeded)
bool shortSLhit    = canExit and inShort and high >= slPx
bool shortFullExit = shortSLhit or (canExit and inShort and bullCHoCH) or shortTpExhausted or (canExit and inShort and dailyMtmHalted) or (inShort and maxHoldExceeded)

if longFullExit or shortFullExit
    bool isExitLong = longFullExit
    // P1-19: gap-aware stop fill. A stop order becomes a market order once triggered — it does NOT fill
    // at the stop price if the market already gapped through it (overnight news, semiconductor earnings,
    // FOMC/CPI, a broad shock). If this bar's OPEN is already worse than slPx, the realistic fill is the
    // open (the actual first tradable price), not the stop level the model can no longer realize. This
    // matters enormously for a leveraged ETF, where gap magnitude is amplified 3x vs. the underlying.
    float longStopFill  = open < slPx ? open : slPx
    float shortStopFill = open > slPx ? open : slPx
    float fill = isExitLong ? (longSLhit ? longStopFill : close) : (shortSLhit ? shortStopFill : close)

    // ─── Execution Friction (realistic institutional costs) ─── uses effSlippageBps (dynamic, see P1-18
    // above), not the raw i_slippageBps input, so the final tranche's friction scales with the SAME
    // liquidity/volatility/gap conditions the partial-exit tranches already priced in. P0: entry-side
    // slippage is NOT charged here — it's already baked into entryPx itself (see entryPx's comment at the
    // Entry block) — only this tranche's own exit-side slippage is a separate, still-unbooked cost.
    float slippageCost = fill * (effSlippageBps / 10000.0)
    float commissionCost = i_commissionPerShare * 2.0
    float frictionPerShare = slippageCost + commissionCost

    // Fix P0-2: book $ P&L only for the fraction NOT already banked at TP1/TP2/TP3 above (each of which
    // booked its own simEquity/dailyPnL at its own fill price when it hit). Previously this priced the
    // ENTIRE entryPosSize at the single final fill, ignoring that some fraction already sold at a
    // different (usually better) TP price earlier in the trade.
    float remShares = entryPosSize * math.max(0.0, remFrac)
    float finalPnlPerShare = isExitLong ? (fill - entryPx) : (entryPx - fill)
    float netPnl = finalPnlPerShare - frictionPerShare  // per-share, final tranche only
    float finalNetPnl = netPnl * remShares
    simEquity  := simEquity + finalNetPnl
    peakEquity := math.max(peakEquity, simEquity)
    dailyPnL   := dailyPnL + finalNetPnl

    // P0-6: canonical whole-trade $ P&L = everything banked at TP1/TP2/TP3 + this final tranche. wins/
    // losses/grossWin/grossLoss below must use THIS, not netPnl (which is only the last tranche's
    // per-share result and previously ignored both share count and any already-banked TP profit).
    float totalTradePnl = bankedDollarPnl + finalNetPnl

    // Realized R-multiple achieved (Fix #5 & Critical Bug #2: Blends banked partial profit R with remaining position exit R)
    float entryRisk = initialRiskPx > 0 ? initialRiskPx : (isExitLong ? (entryPx - slPx) : (slPx - entryPx))
    float remGrossR = entryRisk > 0 ? (isExitLong ? (fill - entryPx) : (entryPx - fill)) / entryRisk : 0.0
    // costInR now covers ALL tranches' friction (bankedFriction from TP1-3 + this final tranche's), not
    // just the final exit's — previously partial-exit friction was silently uncounted in the R-multiple.
    float totalFrictionDollars = bankedFriction + frictionPerShare * remShares
    float costInR   = (entryRisk > 0 and entryPosSize > 0) ? totalFrictionDollars / (entryRisk * entryPosSize) : 0.0
    float tradeR    = bankedR + math.max(0.0, remFrac) * remGrossR - costInR

    // Record data into rolling walk-forward feedback arrays
    array.set(histTrendVal, histIdx, entryTrend)
    array.set(histLiqVal,   histIdx, entryLiq)
    array.set(histMomVal,   histIdx, entryMom)
    array.set(histRsVal,    histIdx, entryRs)
    array.set(histVolVal,   histIdx, entryVol)
    array.set(histOutcome,  histIdx, tradeR)
    array.set(histProb,     histIdx, openTradeProb)
    array.set(histBars,     histIdx, bar_index)
    array.set(histBarsHeld, histIdx, bar_index - entryBar)
    histIdx := (histIdx + 1) % i_rollWin

    // Fix 4 & 7: Update Long or Short calibration bins with Laplace smoothing
    int calBin = math.min(4, math.floor(openTradeProb / 20.0))
    if isExitLong
        array.set(calBinTotalLong, calBin, array.get(calBinTotalLong, calBin) + 1.0)
        if tradeR > 0
            array.set(calBinWinsLong, calBin, array.get(calBinWinsLong, calBin) + 1.0)
        float _cbNL = array.get(calBinTotalLong, calBin)
        float _cbWL = array.get(calBinWinsLong, calBin)
        float laplacePL = ((_cbWL + 2.0) / (_cbNL + 4.0)) * 100.0
        array.set(calBinEmpPLong, calBin, laplacePL)
    else
        array.set(calBinTotalShort, calBin, array.get(calBinTotalShort, calBin) + 1.0)
        if tradeR > 0
            array.set(calBinWinsShort, calBin, array.get(calBinWinsShort, calBin) + 1.0)
        float _cbNS = array.get(calBinTotalShort, calBin)
        float _cbWS = array.get(calBinWinsShort, calBin)
        float laplacePS = ((_cbWS + 2.0) / (_cbNS + 4.0)) * 100.0
        array.set(calBinEmpPShort, calBin, laplacePS)

    // P2-4/P1: Empirical validation BY SETUP GRADE (A+/A/B/C — the actual composite grade buySignal/
    // sellSignal gate entries on), not by probability bucket. This replaces the old "True Pooled" block,
    // which UPDATED using calBin (derived from openTradeProb) but was DISPLAYED next to setupGrade as if it
    // were that grade's own win rate — a real mismatch, since probability and composite score are different
    // quantities that only coincidentally share a 0-100 scale, so the old "[A+ 68% Win, N=142]" footnote was
    // actually the win rate of whichever probability bucket the CURRENT bar's score number happened to
    // numerically match, not A+ trades' actual history. gIdx below buckets by entryGrade (the grade actually
    // recorded at entry, already tracked for other purposes) instead. Also adds Expected R (mean realized
    // tradeR per grade) — Win% alone doesn't say whether a grade is profitable once loss size is accounted
    // for. C never populates since buySignal/sellSignal only allow A+/A/B entries; that's expected, not a
    // bug. This covers the trade-ELIGIBILITY grade specifically — a literal per-OB-score reaction table
    // (tracking every order block touched, whether or not it became part of a live A+/B trade signal) would
    // need its own separate reaction-detection system and is not what this builds.
    int gIdx = f_gradeIdx(entryGrade)
    if gIdx >= 0
        array.set(calGradeTotal, gIdx, array.get(calGradeTotal, gIdx) + 1.0)
        array.set(calGradeSumR,  gIdx, array.get(calGradeSumR, gIdx) + tradeR)
        // P2: sum of tradeR^2, alongside the existing sum of tradeR — lets the dashboard compute a real
        // standard error on Expected R (variance = E[R^2] - E[R]^2) instead of just showing a point estimate
        // with no sense of how much sampling noise it carries. See the SCORE row footnote in §12.
        array.set(calGradeSumRSq, gIdx, array.get(calGradeSumRSq, gIdx) + tradeR * tradeR)
        if tradeR > 0
            array.set(calGradeWins, gIdx, array.get(calGradeWins, gIdx) + 1.0)
        float _gN = array.get(calGradeTotal, gIdx)
        float _gW = array.get(calGradeWins, gIdx)
        array.set(calGradeEmpP, gIdx, ((_gW + 2.0) / (_gN + 4.0)) * 100.0)
        array.set(calGradeExpR, gIdx, array.get(calGradeSumR, gIdx) / _gN)

    totalTrades   += 1
    if tp1Hit
        tp1Hits += 1
    if tp2Hit
        tp2Hits += 1
    if tp3Hit
        tp3Hits += 1
    if totalTradePnl >= 0
        wins     += 1
        grossWin += totalTradePnl
        consecutiveLosses := 0
    else
        losses    += 1
        grossLoss += math.abs(totalTradePnl)
        consecutiveLosses += 1
        // P0: consecutive-loss circuit breaker (#37) — a losing streak often means current conditions
        // don't match what the model was validated on. i_maxConsecLosses=0 disables this entirely; a
        // TIME-LIMITED cooldown (not a permanent halt) so it can't deadlock the strategy — it always
        // re-opens after i_lossCooldownBars regardless of what happens next.
        if i_maxConsecLosses > 0 and consecutiveLosses >= i_maxConsecLosses
            lossCooldownUntilBar := bar_index + i_lossCooldownBars
    inLong     := false
    inShort    := false
    entryPx    := na
    tp1Px      := na
    tp2Px      := na
    tp3Px      := na
    slPx       := na
    entryBar   := na
    tradeDir   := "FLAT"
    entryGrade := "—"

// ─── Performance Metrics ───
float winRate   = totalTrades > 0 ? wins * 1.0 / totalTrades * 100.0 : 0.0
float avgWin    = wins > 0 ? grossWin / wins : 0.0
float avgLoss   = losses > 0 ? grossLoss / losses : 0.0
float pf        = grossLoss > 0 ? grossWin / grossLoss : 0.0
float ev        = totalTrades > 0 ? (winRate/100.0 * avgWin) - ((1.0-winRate/100.0) * avgLoss) : 0.0
// Fix #11: When all trades are wins (avgLoss == 0), estimate R:R using current risk distance as proxy
float avgRR     = avgLoss > 0 ? avgWin / avgLoss : (avgWin > 0 ? avgWin / math.max(riskDist, atr * 1.5) : 0.0)
if totalTrades > 0 and (avgLoss > 0 or avgWin > 0)
    liveAvgRR := avgRR  // Feed real R:R back to Kelly sizing on next bar

// ─── Rolling Institutional Performance Metrics ───
[rWR, rPF, rExp] = f_calcRollingMetrics(histOutcome, i_rollWin, totalTrades)
rollPF      := totalTrades > 0 ? rPF : pf
rollExpectancy := totalTrades > 0 ? rExp : ev

// Fix #5: Pass ringIdx explicitly to eliminate implicit global histIdx dependency
f_calcRollingCalmar(array<float> outcomeArr, int winLen, int totalTrades, int ringIdx) =>
    int activeLen = math.min(totalTrades, winLen)
    if activeLen == 0
        0.0
    else
        float cumRet = 0.0
        float peakRet = 0.0
        float maxDD = 0.0
        for k = 0 to activeLen - 1
            int idx = (ringIdx - activeLen + k + winLen) % winLen
            float r = array.get(outcomeArr, idx)
            cumRet += r
            peakRet := math.max(peakRet, cumRet)
            float dd = peakRet - cumRet
            maxDD := math.max(maxDD, dd)
        maxDD > 0 ? cumRet / maxDD : (cumRet > 0 ? 10.0 : 0.0)

var float rollCalmar = 0.0

if totalTrades != totalTrades[1] or bar_index == 1
    rollSharpe  := totalTrades >= 2 ? f_calcRollingSharpe(histOutcome, histBarsHeld, i_rollWin, totalTrades) : 0.0
    rollSortino := totalTrades >= 2 ? f_calcRollingSortino(histOutcome, histBarsHeld, i_rollWin, totalTrades) : 0.0
    [rBrier, rProbMAE] = f_calcRollingCalibration(histOutcome, histProb, i_rollWin, totalTrades)
    rollBrier    := totalTrades > 0 ? rBrier : 0.25
    rollProbMAE  := totalTrades > 0 ? rProbMAE : 0.0
    rollCalmar  := totalTrades > 0 ? f_calcRollingCalmar(histOutcome, i_rollWin, totalTrades, histIdx) : 0.0


// ════════════════════════════════════════════════════════════════════════
// §11  VISUAL OVERLAYS (Display-Mode Filtered)
// ════════════════════════════════════════════════════════════════════════

// ─── Chart Lines RE-ENABLED (labels/boxes still hidden for mobile) ───

// EMAs (Expert)
plot(showEmas ? emaF   : na, "EMA Fast", color=color.new(#00BCD4, 20), linewidth=1)
plot(showEmas ? emaM   : na, "EMA Mid",  color=color.new(#2196F3, 30), linewidth=1)
plot(showEmas ? emaS   : na, "EMA Slow", color=color.new(#FF9800, 30), linewidth=2)
plot(showEmas ? ema200 : na, "EMA 200",  color=color.new(#9C27B0, 40), linewidth=2, style=plot.style_circles)
plot(showVwap ? vwapVal : na, "VWAP", color=color.new(#FFD600, 0), linewidth=2)
// P1: labeled "~" — these bin bar VOLUME by proportional [low,high] overlap (§8), which is a real
// improvement over single-bin-at-close, but it's still bar-distributed volume, not true tick-level
// transaction-at-price data. Treat POC/VAH/VAL as approximate reference levels, not precise auction stats —
// they're still used as structural stop/target anchors elsewhere, so that distinction matters there too.
plot(showProfile ? vpPOC : na, "~POC", color=color.new(#FFD600, 0), linewidth=2, style=plot.style_linebr)
plot(showProfile ? vpVAH : na, "~VAH", color=color.new(#00E5FF, 40), linewidth=1, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(showProfile ? vpVAL : na, "~VAL", color=color.new(#00E5FF, 40), linewidth=1, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(showPrevDay ? prevDayH : na, "Prev Day H", color=color.new(#FF1744, 40), linewidth=1, style=plot.style_steplinebr, display = display.all - display.status_line - display.data_window)
plot(showPrevDay ? prevDayL : na, "Prev Day L", color=color.new(#00E676, 40), linewidth=1, style=plot.style_steplinebr, display = display.all - display.status_line - display.data_window)
plot(showEquil ? equilibrium : na, "Equilibrium", color=color.new(#9E9E9E, 40), linewidth=1, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(isExpert ? nextTfHi : na, "Expected Max", color=color.new(#00E676, 50), style=plot.style_linebr, linewidth=1, offset=1)
plot(isExpert ? nextTfLo : na, "Expected Min", color=color.new(#FF1744, 50), style=plot.style_linebr, linewidth=1, offset=1)
// P1: independent (non-chained) 1H/4H forecasts — see spx_1H_indep/spx_4H_indep's declaration comment in
// §9. Data-window-only (not on-chart, not in the dashboard) since these are a validation/research aid, not
// a trading signal — compare against the chained ladder's own 1H/4H rows to see how much the chain has
// drifted from an independent same-horizon estimate.
plot(spx_1H_indep, "1H Forecast (Independent)", display=display.data_window)
plot(spx_4H_indep, "4H Forecast (Independent)", display=display.data_window)

// Opening Range Levels (ORB 15m / 30m)
bool showRealizedOrb = _isUsMkt and (orbComplete or inOrbWindow)
float displayOrbHi = showRealizedOrb ? orbHi : expOrbHi
float displayOrbLo = showRealizedOrb ? orbLo : expOrbLo
plot(i_showORB and not na(displayOrbHi) ? displayOrbHi : na, "ORB Max (High)", color=color.new(#00E5FF, showRealizedOrb and orbComplete ? 0 : 35), linewidth=2, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(i_showORB and not na(displayOrbLo) ? displayOrbLo : na, "ORB Min (Low)",  color=color.new(#FF9100, showRealizedOrb and orbComplete ? 0 : 35), linewidth=2, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(inLong ? entryPx : na, "Entry", color=color.new(#00BCD4, 0), linewidth=2, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(inLong ? tp1Px   : na, "TP1",   color=color.new(#8BC34A, 0), linewidth=1, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(inLong ? tp2Px   : na, "TP2",   color=color.new(#00E676, 0), linewidth=1, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(inLong ? tp3Px   : na, "TP3",   color=color.new(#00C853, 0), linewidth=2, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plot(inLong ? slPx    : na, "SL",    color=color.new(#FF1744, 0), linewidth=2, style=plot.style_linebr, display = display.all - display.status_line - display.data_window)
plotshape(buySignal and not inLong[1], title="BUY",
     location=location.belowbar, style=shape.triangleup,
     color=#00E676, textcolor=color.white, text="BUY ⚡", size=size.large)


// Renders the Pre/Reg/Post/Ovn/NxtDay session-outlook rows (pulled out of the main dashboard body to stay
// under Pine's "main body too long" limit). Placed here, not up in §9b with its sibling helpers, because
// Pine requires closure-referenced identifiers declared earlier in TEXTUAL order — pxPre/pxEOD/pxNextDay/
// etc. aren't computed until the SEQUENTIAL SESSION CHAIN block partway through §9b. expRetPre/probUpPre/
// etc. are recomputed locally here (same formula/inputs) rather than passed in, since they can't drift
// out of sync with the 🔮NXT-DAY row the dashboard renders separately when both derive from the same inputs.
f_renderSessionOutlookRows(table tbl, int startRow, color bgAlt1, color bgAlt2, string szTiny, bool isHolidayToday) =>
    int r = startRow
    bool isMktClosed = isHolidayToday or f_getSessionIST(timenow) == "CLOSED"
    float safeAnchor = pxEODAnchor > 0 ? pxEODAnchor : (close > 0 ? close : 1.0)
    string dateNxtDay  = f_getSessDateStr("NXT-DAY")
    string datePreMkt  = f_getSessDateStr("PRE-MKT")
    string datePostMkt = f_getSessDateStr("POST-MKT")
    string dateOvnMkt  = f_getSessDateStr("OVERNIGHT")
    string dateRegMkt  = f_getSessDateStr("REG-MKT")
    // f_getSessDateStr("REG-MKT") shifts forward once mins>=1140 (7PM IST) — correct for the other three
    // nowSess branches, where the Reg row chains forward to a session that hasn't opened yet. But when
    // nowSess=="MARKET" we're already INSIDE the regular session that opened at TODAY's 7PM, so the row
    // should stay dated today, not roll to the following trading day.
    string dateRegMktDisplay = nowSess == "MARKET" ? f_fmtDateStr(timenow) : dateRegMkt

    // When we're currently INSIDE a session, that session's own row skips past its own (already-live)
    // completion and shows the NEXT occurrence instead — chained one full cycle further (through the
    // remaining legs of the session order Pre->Reg->Post->Ovn->Pre) — per explicit dashboard requirement.
    // The other three rows already land on "next" naturally via the existing nowSess chain in §9b.
    float pxPreDisplay = pxPre
    string datePreMktDisplay = datePreMkt
    if nowSess == "PRE-MKT"
        pxPreDisplay := pxPre + chgRegFull + chgPost + chgOvn + chgPre
        datePreMktDisplay := f_getSessDateStr("PRE-MKT-NEXT")

    float pxPostDisplay = pxPost
    string datePostMktDisplay = datePostMkt
    if nowSess == "POST-MKT"
        pxPostDisplay := pxPost + chgOvn + chgPre + chgRegFull + chgPost
        datePostMktDisplay := f_getSessDateStr("POST-MKT-NEXT")

    // Overnight's price target (pxOvn) already lands on the NEXT cycle when nowSess=="OVERNIGHT" (the §9b
    // chain routes today's remaining overnight through the intermediate pxOvnClose, only exposing the
    // FOLLOWING cycle's value as pxOvn) — but dateOvnMkt doesn't know that and would otherwise print
    // TODAY's date under a price that's actually tomorrow's forecast. Only the date needs the skip here.
    string dateOvnMktDisplay = dateOvnMkt
    if nowSess == "OVERNIGHT"
        dateOvnMktDisplay := f_getSessDateStr("OVERNIGHT-NEXT")

    float errorScale = 1.0 + (nz(rollingMAE, atr) / math.max(0.1, atr)) * 0.20
    float sigmaPre   = preMktVol * math.sqrt(5.5) * volClusterMult * errorScale
    float sigmaEod   = hrlyVol * math.sqrt(6.5) * volClusterMult * errorScale
    float sigmaPost  = postMktVol * math.sqrt(4.0) * volClusterMult * errorScale
    float sigmaOvn   = overnightVol * math.sqrt(8.0) * volClusterMult * errorScale

    float preSkew  = 1.0 + C_SKEW_COEF * biasPreMkt
    float pre68Lo  = math.max(0.01, pxPreDisplay - (sigmaPre / preSkew))
    float pre68Hi  = pxPreDisplay + (sigmaPre * preSkew)

    float eodSkew  = 1.0 + C_SKEW_COEF * biasEOD
    float eod68Lo  = math.max(0.01, pxEOD - (sigmaEod / eodSkew))
    float eod68Hi  = pxEOD + (sigmaEod * eodSkew)

    float postSkew = 1.0 + C_SKEW_COEF * biasPostMkt
    float post68Lo = math.max(0.01, pxPostDisplay - (sigmaPost / postSkew))
    float post68Hi = pxPostDisplay + (sigmaPost * postSkew)

    float ovnSkew  = 1.0 + C_SKEW_COEF * biasOvn
    float ovn68Lo  = math.max(0.01, pxOvn - (sigmaOvn / ovnSkew))
    float ovn68Hi  = pxOvn + (sigmaOvn * ovnSkew)

    // Row: Pre-Market Outlook (1:30 PM IST). Base is always the CURRENT live price (safeAnchor); the
    // target is pxPreDisplay — "today's own" pre-market unless we're already inside it, in which case
    // it's the NEXT one (see pxPreDisplay above).
    float expRetPre = safeAnchor > 0 ? ((nz(pxPreDisplay, safeAnchor) - safeAnchor) / safeAnchor) * 100.0 : 0.0
    float probUpPre = f_retToProb(expRetPre, atr, directionalWinRate)
    color preClr = (pxPreDisplay >= safeAnchor + atr * 0.05) ? #00E676 : ((pxPreDisplay <= safeAnchor - atr * 0.05) ? #FF1744 : #9E9E9E)
    string preIcon = (pxPreDisplay >= safeAnchor + atr * 0.05) ? "📈" : ((pxPreDisplay <= safeAnchor - atr * 0.05) ? "📉" : "--")
    // P0-3: (Emp:Y%,N=Z) makes explicit how much of probUpPre is validated empirical frequency vs. still
    // the tanh-transform prior — same transparency the NxtDay row already had, now consistent everywhere.
    [preEmpBlend, preEmpN] = f_retProbEmpWeight()
    string preProbStr = math.abs(expRetPre) < 0.10 ? "50.0%↔" : (expRetPre >= 0 ? (str.tostring(probUpPre, "#.0") + "%↑") : (str.tostring(100.0 - probUpPre, "#.0") + "%↓")) + " (Emp:" + str.tostring(preEmpBlend * 100.0, "#.0") + "%,N=" + str.tostring(preEmpN, "0") + ")"
    string preTxt = datePreMktDisplay + " " + preIcon + " $" + str.tostring(pxPreDisplay, "#.02") + " [$" + str.tostring(pre68Lo, "#.01") + "-" + str.tostring(pre68Hi, "#.01") + "] (" + (expRetPre >= 0 ? "+" : "") + str.tostring(expRetPre, "#.02") + "%) " + preProbStr
    if isMktClosed
        f_dashCell(tbl, r, "Pre (1:30PM)", preTxt, #9E9E9E, #FFD600, bgAlt1, szTiny)
    else
        f_dashCell(tbl, r, (nowSess == "PRE-MKT" ? "🟡Pre" : "Pre (1:30PM)"), preTxt, #9E9E9E, preClr, bgAlt1, szTiny)
    r += 1

    // Row: Regular Market Outlook (7:00 PM IST Today's Session Close). Base is ALWAYS the PREVIOUS
    // regular session's close (prevDayC), not live price, in every nowSess branch — so this reads as a
    // genuine day-over-day change ("expected to close up/down X% vs yesterday's close"), the same way
    // "SPY is up 1.2% today" is always measured against yesterday's close, not against whatever price is
    // right now. pxEOD itself (the actual $ target) is untouched — only this comparison base changed.
    float regBase = (not na(prevDayC) and prevDayC > 0) ? prevDayC : safeAnchor
    float expRetEod = ((pxEOD - regBase) / regBase) * 100.0
    float probUpEod = f_retToProb(expRetEod, atr, directionalWinRate)
    string eodUp = str.tostring(probUpEod, "#.0")
    string eodDn = str.tostring(100.0 - probUpEod, "#.0")
    string eodRet = (expRetEod >= 0 ? "+" : "") + str.tostring(expRetEod, "#.00")
    [eodEmpBlend, eodEmpN] = f_retProbEmpWeight()
    string eodProbStr = (math.abs(expRetEod) < 0.10 ? "50.0%↔" : (expRetEod >= 0 ? (eodUp + "%↑") : (eodDn + "%↓"))) + " (Emp:" + str.tostring(eodEmpBlend * 100.0, "#.0") + "%,N=" + str.tostring(eodEmpN, "0") + ")"
    color regClr = (pxEOD >= regBase + atr * 0.05) ? #00E676 : ((pxEOD <= regBase - atr * 0.05) ? #FF1744 : #9E9E9E)
    string regIcon = (pxEOD >= regBase + atr * 0.05) ? "📈" : ((pxEOD <= regBase - atr * 0.05) ? "📉" : "--")
    string regTxt = dateRegMktDisplay + " " + regIcon + " $" + str.tostring(pxEOD, "#.02") + " [$" + str.tostring(eod68Lo, "#.01") + "-" + str.tostring(eod68Hi, "#.01") + "] (" + eodRet + "%) " + eodProbStr
    if isMktClosed
        f_dashCell(tbl, r, "Reg (7:00PM)", regTxt, #9E9E9E, #FFD600, bgAlt2, szTiny)
    else
        f_dashCell(tbl, r, (nowSess == "MARKET" ? "🟢Market" : "Reg (7:00PM)"), regTxt, #9E9E9E, regClr, bgAlt2, szTiny)
    r += 1

    // Row: Post-Market Outlook (1:30 AM IST). Base is always the CURRENT live price (safeAnchor); the
    // target is pxPostDisplay — "today's own" post-market unless we're already inside it, in which case
    // it's the NEXT one (see pxPostDisplay above).
    float expRetPost = safeAnchor > 0 ? ((nz(pxPostDisplay, safeAnchor) - safeAnchor) / safeAnchor) * 100.0 : 0.0
    float probUpPost = f_retToProb(expRetPost, atr, directionalWinRate)
    color postClr = (pxPostDisplay >= safeAnchor + atr * 0.05) ? #00E676 : ((pxPostDisplay <= safeAnchor - atr * 0.05) ? #FF1744 : #9E9E9E)
    string postIcon = (pxPostDisplay >= safeAnchor + atr * 0.05) ? "📈" : ((pxPostDisplay <= safeAnchor - atr * 0.05) ? "📉" : "--")
    [postEmpBlend, postEmpN] = f_retProbEmpWeight()
    string postProbStr = (math.abs(expRetPost) < 0.10 ? "50.0%↔" : (expRetPost >= 0 ? (str.tostring(probUpPost, "#.0") + "%↑") : (str.tostring(100.0 - probUpPost, "#.0") + "%↓"))) + " (Emp:" + str.tostring(postEmpBlend * 100.0, "#.0") + "%,N=" + str.tostring(postEmpN, "0") + ")"
    string postTxt = datePostMktDisplay + " " + postIcon + " $" + str.tostring(pxPostDisplay, "#.02") + " [$" + str.tostring(post68Lo, "#.01") + "-" + str.tostring(post68Hi, "#.01") + "] (" + (expRetPost >= 0 ? "+" : "") + str.tostring(expRetPost, "#.02") + "%) " + postProbStr
    if isMktClosed
        f_dashCell(tbl, r, "Post (1:30AM)", postTxt, #9E9E9E, #FFD600, bgAlt1, szTiny)
    else
        f_dashCell(tbl, r, (nowSess == "POST-MKT" ? "🔵Post" : "Post (1:30AM)"), postTxt, #9E9E9E, postClr, bgAlt1, szTiny)
    r += 1

    // Row: Overnight Outlook (5:30 AM IST). Base is the CURRENT live price (safeAnchor) in every session
    // EXCEPT when we're currently inside the overnight session itself — there the base switches to
    // regBase (current regular market price) instead of the illiquid live overnight tick, per explicit
    // dashboard requirement. (regBase is defined earlier above, in the Regular Market Outlook row.)
    float ovnBaseAnchor = nowSess == "OVERNIGHT" ? regBase : safeAnchor
    float expRetOvn = ovnBaseAnchor > 0 ? ((nz(pxOvn, ovnBaseAnchor) - ovnBaseAnchor) / ovnBaseAnchor) * 100.0 : 0.0
    float probUpOvn = f_retToProb(expRetOvn, atr, directionalWinRate)
    color ovnClr = (pxOvn >= ovnBaseAnchor + atr * 0.05) ? #00E676 : ((pxOvn <= ovnBaseAnchor - atr * 0.05) ? #FF1744 : #9E9E9E)
    string ovnIcon = (pxOvn >= ovnBaseAnchor + atr * 0.05) ? "📈" : ((pxOvn <= ovnBaseAnchor - atr * 0.05) ? "📉" : "--")
    [ovnEmpBlend, ovnEmpN] = f_retProbEmpWeight()
    string ovnProbStr = (math.abs(expRetOvn) < 0.10 ? "50.0%↔" : (expRetOvn >= 0 ? (str.tostring(probUpOvn, "#.0") + "%↑") : (str.tostring(100.0 - probUpOvn, "#.0") + "%↓"))) + " (Emp:" + str.tostring(ovnEmpBlend * 100.0, "#.0") + "%,N=" + str.tostring(ovnEmpN, "0") + ")"
    string ovnTxt = dateOvnMktDisplay + " " + ovnIcon + " $" + str.tostring(pxOvn, "#.02") + " [$" + str.tostring(ovn68Lo, "#.01") + "-" + str.tostring(ovn68Hi, "#.01") + "] (" + (expRetOvn >= 0 ? "+" : "") + str.tostring(expRetOvn, "#.02") + "%) " + ovnProbStr
    if isMktClosed
        f_dashCell(tbl, r, "Ovn (5:30AM)", ovnTxt, #9E9E9E, #FFD600, bgAlt2, szTiny)
    else
        f_dashCell(tbl, r, (nowSess == "OVERNIGHT" ? "🌙Ovn" : "Ovn (5:30AM)"), ovnTxt, #9E9E9E, ovnClr, bgAlt2, szTiny)
    r += 1

    // Row: Next Day Outlook (session close one full cycle beyond Reg)
    float expRetDaily = (nz(nextDayChg, 0.0) / safeAnchor) * 100.0
    float probUpDaily = f_retToProb(expRetDaily, atr, directionalWinRate)
    string ndUp = str.tostring(probUpDaily, "#.0")
    string ndRet = (expRetDaily >= 0 ? "+" : "") + str.tostring(expRetDaily, "#.00")
    float gapPct = not na(prevDayC) and prevDayC > 0 ? math.abs(close - prevDayC) / prevDayC * 100.0 : 0.0
    bool catalystDetected = gapPct > 3.0 or rvol > 3.0
    string ndIcon = expRetDaily >= 0.10 ? "📈" : (expRetDaily <= -0.10 ? "📉" : "--")
    // (N=...) now shows the ACTUAL calibration sample backing THIS probability (validated forecast-vs-
    // outcome pairs in the relevant return-bin) instead of totalTrades — a completely different, unrelated
    // counter (trade entries/exits) that happened to be sitting nearby and got used as a stand-in.
    [ndEmpBlend, ndEmpN] = f_retProbEmpWeight()
    string ndProbStr = math.abs(expRetDaily) < 0.10 ? "50.0%↔" : (expRetDaily >= 0 ? (ndUp + "%↑ (N=" + str.tostring(ndEmpN, "0") + ", Emp:" + str.tostring(ndEmpBlend * 100.0, "#.0") + "%)") : (str.tostring(100.0 - probUpDaily, "#.0") + "%↓ (N=" + str.tostring(ndEmpN, "0") + ", Emp:" + str.tostring(ndEmpBlend * 100.0, "#.0") + "%)"))
    string gapStr = " Gap:$" + str.tostring(pxNextDayOpen, "#.02")
    string ndTxt = dateNxtDay + " " + ndIcon + " $" + str.tostring(pxNextDay, "#.02") + " [$" + str.tostring(nextDayLo, "#.01") + "-" + str.tostring(nextDayHi, "#.01") + "] (" + ndRet + "%)" + gapStr + " " + ndProbStr + (catalystDetected ? " ⚠️" : "")
    f_dashCell(tbl, r, "NxtDay", ndTxt, #9E9E9E, isMktClosed ? #FFD600 : (catalystDetected ? #FFD600 : (expRetDaily >= 0.10 ? #00E676 : (expRetDaily <= -0.10 ? #FF1744 : #9E9E9E))), bgAlt1, szTiny)
    r += 1
    r

// ════════════════════════════════════════════════════════════════════════
// §12  DASHBOARD HUD (Display-Mode Filtered)
// ════════════════════════════════════════════════════════════════════════

var table dash = na

if i_showDash and barstate.islast

    // Text sizing — responsive to i_dashSize setting (defaults to Tiny for mobile/narrow views)
    string szTiny   = i_dashSize == "Tiny" ? size.tiny : (i_dashSize == "Small" ? size.tiny : (i_dashSize == "Normal" ? size.small : size.normal))
    string szSmall  = i_dashSize == "Tiny" ? size.tiny : (i_dashSize == "Small" ? size.small : (i_dashSize == "Normal" ? size.normal : size.large))
    string szNormal = i_dashSize == "Tiny" ? size.tiny : (i_dashSize == "Small" ? size.small : (i_dashSize == "Normal" ? size.normal : size.large))

    // P1: today (exchange-local date, via timenow — consistent with every other "current status" computation
    // in this dashboard block, all of which are already timenow-based and only meaningful live) is a full
    // NYSE/Nasdaq closure per the manually-maintained i_holidayDates list. See that input's tooltip for scope
    // — this affects the live SESS/CLOSED display below, not historical bar processing or forward date-rolling.
    bool isHolidayToday = f_isDateListed(f_exchDateStr(timenow), i_holidayDates)


    // P0-8: boEntry/potSL/rrAgg/rrBo/targetFallbackLong/targetFallbackShort/badTiming/isOverextendedLong/
    // isOverextendedShort are now computed once, globally, in §10 (right before buySignal/sellSignal) so
    // this dashboard and the actual trade-entry engine read the exact same values — see the P0-8 comment
    // there for why. potSL is still used below for the mobile-view SL display.

    // Task 8: Continuous data-driven Volatility & Risk Ratio
    float volRiskRatio       = math.max(0.5, volClusterMult)
    float rmseRiskRatio      = atr > 0 ? math.max(0.5, rollingRMSE / atr) : 1.0
    float adrRiskRatio       = math.max(0.5, adrConsumedPct / 80.0)
    float compositeRiskRatio = volRiskRatio * 0.40 + rmseRiskRatio * 0.35 + adrRiskRatio * 0.25
    string riskStr = compositeRiskRatio >= 1.35 ? "High 🔴" : (compositeRiskRatio >= 0.95 ? "Medium 🟡" : "Low 🟢")

    // P0: openRiskDollars/openRiskPct (#35) — the "portfolio heat" analogue for this single-position,
    // single-instrument architecture. True cross-position gross/net/sector/factor/correlated exposure (as
    // a multi-position portfolio risk system would track) doesn't apply here by design — there is never
    // more than one position in one instrument — but "how much would closing at the current stop actually
    // cost right now" is a real, meaningful heat metric even for one position, and wasn't previously
    // surfaced anywhere on the dashboard.
    float openRiskDollars = inLong ? math.max(0.0, close - slPx) * entryPosSize * math.max(0.0, remFrac) : (inShort ? math.max(0.0, slPx - close) * entryPosSize * math.max(0.0, remFrac) : 0.0)
    float openRiskPct = simEquity > 0 ? openRiskDollars / simEquity * 100.0 : 0.0

    // ─── Position Sizing Calculator (reuses §10 Execution Engine sizing directly) ───
    float tradeShares  = posSize

    // ─── Three-State Trend Model (Whipsaw Resistant) ───
    string dashTrendText = "Neutral 🟡"
    color dashTrendBg = color.new(#331a00, 0)
    color dashTrendClr = #FF9800

    if effectiveTrend == 1
        bool inCorr = close < emaM or (rsi < 45.0 and close < emaF)
        if inCorr
            dashTrendText  := "Neutral Bullish (Correction) 🟡"
            dashTrendBg    := color.new(#331a00, 0)
            dashTrendClr   := #FF9800
        else
            dashTrendText  := "Bullish 🟢"
            dashTrendBg    := color.new(#003d1a, 0)
            dashTrendClr   := #00E676
    else if effectiveTrend == -1
        bool inCorr = close > emaM or (rsi > 55.0 and close > emaF)
        if inCorr
            dashTrendText  := "Neutral Bearish (Correction) 🟡"
            dashTrendBg    := color.new(#331a00, 0)
            dashTrendClr   := #FF9800
        else
            dashTrendText  := "Bearish 🔴"
            dashTrendBg    := color.new(#3d0000, 0)
            dashTrendClr   := #FF1744

    // ─── Priority-Based Action Decision ───
    string sigTxt = ""
    color  sigBg  = color.new(#1a1a1a, 0)
    color  sigClr = color.white

    if inLong
        float slDistAtr = atr > 0 ? (close - slPx) / atr : 1.0
        if slDistAtr < 0.5
            sigTxt := "🚨 Near SL (Long)"
            sigBg  := color.new(#FF1744, 0)
            sigClr := color.white
        else
            sigTxt := "🟢 HOLD LONG"
            sigBg  := color.new(#003d1a, 0)
            sigClr := #00E676
    else if inShort
        float slDistAtr = atr > 0 ? (slPx - close) / atr : 1.0
        if slDistAtr < 0.5
            sigTxt := "🚨 Near SL (Short)"
            sigBg  := color.new(#FF1744, 0)
            sigClr := color.white
        else
            sigTxt := "🔴 HOLD SHORT"
            sigBg  := color.new(#3d0000, 0)
            sigClr := #FF1744
    else
        // P0-8: the FINAL decision in each branch below reads buySignal/sellSignal directly — the exact
        // same booleans that gate the actual entry, alert, and backtest recording — instead of
        // independently re-deriving a "should I show BUY" verdict from a parallel set of checks. Every
        // condition that could make buySignal/sellSignal false now has a corresponding informational
        // branch here explaining WHY, but none of them can override or contradict the real signal: if
        // buySignal is true, this always shows BUY; if false, it always shows some flavor of Suspended.
        if posSize == 0
            sigTxt := "Suspended (Edge Neg)"
            sigBg  := color.new(#4A0000, 0)
            sigClr := #FF6F00
        else if effectiveTrend == 1
            if buySignal
                // targetFallbackLong means the reward side of rrAgg had no real level to reference (no
                // VAH/swing-high/prior-day-high above close) and used an arbitrary ATR multiple instead —
                // flagged rather than silently shown with the same confidence as a genuine structural R:R.
                sigTxt := "🟢 BUY" + (targetFallbackLong ? " (approx R:R)" : "")
                sigBg  := color.new(#004d25, 0)
                sigClr := #00FF88
            else if rrAgg < rrMinLong
                sigTxt := "Suspended (R:R < " + str.tostring(rrMinLong, "#.1") + "x)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if isOverextendedLong
                sigTxt := "Suspended (Await Pullback)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if badTiming
                sigTxt := "Suspended (Outside Window)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if sComposite < minScore or (setupGrade != "A+" and setupGrade != "A" and setupGrade != "B")
                sigTxt := "Suspended (Score/Grade Below Min)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else
                sigTxt := "Suspended (Execution Filters)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
        else if effectiveTrend == -1
            if sellSignal
                sigTxt := "🔴 SELL SHORT" + (targetFallbackShort ? " (approx R:R)" : "")
                sigBg  := color.new(#4d0000, 0)
                sigClr := #FF1744
            else if not canShort
                // canShort is a static config gate (i_allowShort, or a shortable instrument type) — check it
                // before the price-action-dependent reasons below so a permanently-disabled-shorting setup
                // never gets misreported as an R:R/timing/score problem it doesn't actually have.
                sigTxt := "Suspended (Shorting Disabled)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if rrBo < rrMinShort
                sigTxt := "Suspended (R:R < " + str.tostring(rrMinShort, "#.1") + "x)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if isOverextendedShort
                sigTxt := "Suspended (Await Pullback)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if badTiming
                sigTxt := "Suspended (Outside Window)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else if bearConf < bearMinScore or (shortGrade != "A+" and shortGrade != "A" and shortGrade != "B")
                sigTxt := "Suspended (Score/Grade Below Min)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
            else
                sigTxt := "Suspended (Execution Filters)"
                sigBg  := color.new(#331a00, 0)
                sigClr := #FF9800
        else
            sigTxt := "Suspended (Rangebound)"
            sigBg  := color.new(#331a00, 0)
            sigClr := #FF9800

    // Fix #3: Conditionally swap composite score/grade based on active regime (isBearBias)
    float activeScore = isBearBias ? bearConf : sComposite
    string activeGrade = isBearBias ? shortGrade : setupGrade
    float activeMinScore = isBearBias ? bearMinScore : minScore
    string scoreLabel = isBearBias ? "Short: " : ""

    string compositeStatus = activeScore < 40.0 ? "Avoid 🔴" : (activeScore < activeMinScore ? "Watch 🟡" : (activeScore < math.max(80.0, activeMinScore + 10.0) ? "Tradable 🟢" : "Conviction 🔥"))
    color  compositeClr = activeScore >= activeMinScore ? (isBearBias ? #FF1744 : #00E676) : (activeScore >= 40.0 ? #FFB300 : #FF1744)

    // ─── Directional Probabilities (Return-Driven, Directionally Guaranteed) ───
    // Maps expected return % directly to probability. At ±5% return → 95%/5% probability.
    // Guarantees: if expRet < 0, probUp is ALWAYS < 50%. If expRet > 0, probUp is ALWAYS > 50%.
    float safeAnchor = pxEODAnchor > 0 ? pxEODAnchor : (close > 0 ? close : 1.0)

    // Computed once here (not just inside the expanded detail block below) so the compact 🔮NXT-DAY
    // badge can show it too — it previously omitted the date entirely while the detailed "NxtDay" row
    // further down showed one, leaving the two next-day displays looking like they might disagree.
    string dateNxtDay = f_getSessDateStr("NXT-DAY")

    // Next Day Outlook
    float expRetDaily = (nz(nextDayChg, 0.0) / safeAnchor) * 100.0
    float probUpDaily = f_retToProb(expRetDaily, atr, directionalWinRate)
    float probDnDaily = 100.0 - probUpDaily
    string ndUp = str.tostring(probUpDaily, "#.0")
    string ndDn = str.tostring(probDnDaily, "#.0")
    string ndRet = (expRetDaily >= 0 ? "+" : "") + str.tostring(expRetDaily, "#.00")

    // Next-Day badge is derived from probUpDaily — the SAME number the adjacent Up/Dn% text shows — not
    // from biasEOD (a different session's signal), so the badge can't contradict the numbers beside it.
    string nextDayBias = "NEUTRAL ↔"
    if probUpDaily >= 65.0
        nextDayBias := "BULLISH ↑"
    else if probUpDaily >= 55.0
        nextDayBias := "SLIGHT BULL"
    else if probUpDaily <= 35.0
        nextDayBias := "BEARISH ↓"
    else if probUpDaily <= 45.0
        nextDayBias := "SLIGHT BEAR"
    color nextDayClr = probUpDaily >= 55.0 ? #00E676 : (probUpDaily <= 45.0 ? #FF1744 : #FFB300)

    // ─── Reuse / Recreate Table (Quant Memory Optimization) ───
    // P1: Mobile View no longer forces the dashboard down to a reduced 4-row summary — it shows the exact
    // same rows as desktop (gated on i_dashExpand/i_displayMode below, same as always), just rendered
    // mobile-safe: every cell in every row is capped to the g_dashColW1/g_dashColW2 width split and
    // left-aligned (declared globally near i_mobileView's other display flags — see that declaration's
    // comment for why: TradingView's mobile app clips overflowing text instead of wrapping it, and clips
    // from both ends when a cell is center-aligned, so capping width + forcing left-align is what keeps a
    // long row's price/direction visible even if its tail gets clipped on a narrow screen).
    bool shouldExpand = i_dashExpand and not (i_displayMode == "Beginner")
    // Table row allocations: Compact=6 rows | Expanded=24/23 rows, +1 more if i_useSessionAlign adds its
    // own ALIGN row (all inputs, so this count is fixed for the life of one script run).
    int dashRows = not shouldExpand ? 6 : (i_showORB ? 24 : 23) + (i_useSessionAlign ? 1 : 0)
    // P0: dashRows depends only on i_dashExpand/i_displayMode/i_showORB — all static inputs, constant for
    // the lifetime of one script run (changing an input reloads the whole script, resetting `dash` to na
    // anyway). The old delete-then-recreate ran on EVERY barstate.islast execution — every single realtime
    // tick while the last bar is live, not just once — for a table whose size never actually changes across
    // those calls. Creating it once (na(dash) is only ever true the first time this code path runs) and
    // just re-running the table.cell() calls below on each tick (which update existing cells in place, no
    // deletion needed) is functionally identical and avoids that per-tick churn.
    if na(dash)
        dash := table.new(f_dashPos(i_dashPos), 2, dashRows,
             bgcolor=color.new(#060612, 0), border_color=color.new(#1e1e2f, 0),
             border_width=1, frame_color=color.new(#00E5FF, 0), frame_width=2)

    color hBg    = color.new(#03030a, 0)
    color bgAlt1 = color.new(#0a0a16, 0)
    color bgAlt2 = color.new(#101026, 0)
    color tG     = #9E9E9E
    color tW     = #E0E0E0
    color aC     = #00E5FF

    int r = 0

    // ═══ Row 0: Title ═══
    f_dashCell(dash, r, "⚡SMC", syminfo.ticker + "•" + f_tfLabel(), aC, tG, hBg, szSmall)
    r += 1

    // Row 1: Trend State
    f_dashCell(dash, r, "🚦TREND", dashTrendText, color.white, dashTrendClr, dashTrendBg, szSmall)
    r += 1

    // Row 2: Timing
    f_dashCell(dash, r, "⏱TIMING", sigTxt, color.white, sigClr, sigBg, szSmall)
    r += 1

    // Row 3: Composite Rating
    // P2-4/P1: index by the GRADE itself (f_gradeIdx(setupGrade)), not a probability bucket that
    // happened to share sComposite's 0-100 scale — see calGradeTotal's declaration comment for why the
    // old calBinEmpP/calBinTotal lookup here was mismatched. Now also shows Expected R (mean realized
    // R-multiple of past trades that opened at this grade), not just Win% — a grade can have a high win
    // rate and still be unprofitable (small wins, large losses), or vice versa.
    int _gIdxScore        = f_gradeIdx(setupGrade)
    float _empWinForScore = _gIdxScore >= 0 ? array.get(calGradeEmpP, _gIdxScore) : 50.0
    float _empNForScore   = _gIdxScore >= 0 ? array.get(calGradeTotal, _gIdxScore) : 0.0
    float _expRForScore   = _gIdxScore >= 0 ? array.get(calGradeExpR, _gIdxScore) : 0.0
    // P2: standard error on Expected R, from the same per-grade tallies (variance = E[R^2]-E[R]^2,
    // SE = sqrt(variance/N)) — "does A+ actually have statistically significant positive expectancy" is
    // a real question the ExpR point estimate alone can't answer; showing it as ExpR±SE instead of a
    // bare number lets the reader judge that themselves (a mean well inside +-1 SE of zero isn't
    // distinguishable from no edge yet, whatever N happens to be). This is a normal approximation, not a
    // proper small-sample t-test — reads as optimistic (narrower than reality) at low N, which is why
    // the SE term itself is only shown once N>=5, and even then should be read cautiously at low N.
    float _gSumRSqForScore = _gIdxScore >= 0 ? array.get(calGradeSumRSq, _gIdxScore) : 0.0
    float _gVarForScore   = _empNForScore > 1.0 ? math.max(0.0, _gSumRSqForScore / _empNForScore - _expRForScore * _expRForScore) : 0.0
    float _gSEForScore    = _empNForScore > 1.0 ? math.sqrt(_gVarForScore / _empNForScore) : 0.0
    string expRStr        = (_expRForScore >= 0 ? "+" : "") + str.tostring(_expRForScore, "#.02") + (_empNForScore >= 5.0 ? "±" + str.tostring(_gSEForScore, "#.02") : "")
    bool isDivergenceNow  = (sComposite - bearConf > 10.0 and pxEOD < P0 - atr * 0.1) or (bearConf - sComposite > 10.0 and pxEOD > P0 + atr * 0.1)
    string divFlag        = isDivergenceNow ? " ⚠️DIVERGENT" : ""
    // weightDegen was computed in §9 (all expectancy weights floored at 0.1, meaning the walk-forward
    // feedback loop currently trusts none of the factors) but never surfaced — silently resetting to
    // static defaults with no visible signal that the adaptive weighting had broken down.
    string degenFlag      = weightDegen ? " ⚠️WT-DEGEN" : ""
    string scoreFootnote  = " [" + setupGrade + " " + str.tostring(_empWinForScore, "#.0") + "% Win, ExpR:" + expRStr + ", N=" + str.tostring(_empNForScore, "0") + "]" + divFlag + degenFlag
    f_dashCell(dash, r, "📊SCORE", str.tostring(activeScore, "#.1") + "/100 " + compositeStatus + scoreFootnote, tG, compositeClr, bgAlt2, szSmall)
    r += 1

    // Fix High #4: Explicit Risk Level & Next-Day Directional Badge Dashboard Cells
    string openRiskStr = (inLong or inShort) ? (" | Heat:$" + str.tostring(openRiskDollars, "#.0") + " (" + str.tostring(openRiskPct, "#.1") + "%)") : ""
    string riskTxt = riskStr + " (Vol:" + str.tostring(volRiskRatio, "#.02") + "x | RMSE:" + str.tostring(rmseRiskRatio, "#.02") + "x)" + openRiskStr
    f_dashCell(dash, r, "⚠️RISK", riskTxt, tG, riskStr == "High 🔴" ? #FF1744 : (riskStr == "Medium 🟡" ? #FF9100 : #00E676), bgAlt1, szSmall)
    r += 1

    f_dashCell(dash, r, "🔮NXT-DAY", dateNxtDay + " " + nextDayBias + " (Exp Ret: " + ndRet + "% | Up:" + ndUp + "%/Dn:" + ndDn + "%)", tG, nextDayClr, bgAlt2, szSmall)
    r += 1

    if shouldExpand
        // ─── Historical Validation Row ───
        // Brier: MSE of calibrated probability vs realized outcome (0.25 = coin-flip baseline, below = real
        // skill). DirAcc: bar-level directional hit rate. EOD-Hit: % of days pxNextDay's direction matched
        // the actual next close. Below N=30/20 the backing sample is too sparse to trust — flagged, not
        // colored green, so a low-N score can't look more confident than it is.
        string lowNFlag = eodCount < 30.0 ? " ⚠LowN" : ""
        int brierN = math.min(totalTrades, i_rollWin)
        string brierNFlag = brierN < 20 ? " (N=" + str.tostring(brierN, "0") + ", low-N)" : " (N=" + str.tostring(brierN, "0") + ")"
        // Audit #4 fix: Brier/DirAcc are trade entry/exit calibration (histOutcome/histProb), NOT next-day
        // forecast calibration — prefixed explicitly so they're never read as measuring the same thing as
        // NxtDay Hit/Brier (the metrics actually scored against pxNextDay vs. the realized next close).
        // NxtDay Brier answers the institutional calibration question directly: when this model said "72%
        // up," did next-day closes actually land up ~72% of the time? Same 0.25 coin-flip baseline as Trade
        // Brier, scored out-of-sample via frozenNextDay/frozenOrigin (never re-using in-sample live data).
        // P0-6: navTrackingGapPct = SOXL's actual cumulative return minus the synthetic discrete daily-reset
        // NAV's cumulative return since this indicator loaded — a direct, real check of the leverage/drag
        // model against reality (not a claim the closed-form drag formula is correct, an actual measurement).
        string navGapStr = " | NAV Gap:" + (navTrackingGapPct >= 0 ? "+" : "") + str.tostring(navTrackingGapPct, "#.02") + "%"
        string validTxt = "Trade Brier:" + str.tostring(rollBrier, "#.02") + brierNFlag + " (Base 0.25) | Trade DirAcc:" + str.tostring(directionalWinRate, "#.0") + "% | NxtDay Hit:" + str.tostring(eodWinRate, "#.0") + "% Brier:" + str.tostring(eodBrier, "#.02") + " (N=" + str.tostring(eodCount, "0") + ")" + lowNFlag + navGapStr
        color validClr = brierN < 20 ? #9E9E9E : (rollBrier <= 0.20 ? #00E676 : (rollBrier <= 0.25 ? #FFB300 : #FF1744))
        f_dashCell(dash, r, "🧪VALID", validTxt, tG, validClr, bgAlt1, szTiny)
        r += 1

        // ─── Tail-Risk Row: P(next-day move exceeds a leveraged-ETF-relevant threshold) ───
        // SOXL is 3x leveraged, so ±2% moves are routine, not tail events — shown so "68% up" isn't
        // mistaken for "68% chance of a big move."
        float pUpBig = f_probExceed(expRetDaily, atr, 2.0)
        float pDnBig = f_probExceed(expRetDaily, atr, -2.0)
        string tailTxt = "P(>+2%):" + str.tostring(pUpBig, "#.0") + "% | P(<-2%):" + str.tostring(100.0 - pDnBig, "#.0") + "%"
        f_dashCell(dash, r, "☢TAIL", tailTxt, tG, tW, bgAlt2, szTiny)
        r += 1

        // P0: Session Alignment row — only rendered when i_useSessionAlign is on (dashRows above already
        // budgets +1 row for exactly this case). Shows the Decision-Layer verdict (§9b) plus its two
        // PRIMARY legs (Current/Next Regular) so the reasoning behind the gate is visible, not just the
        // final label — including the three SECONDARY context legs (Pre/Post/Ovn), same as desktop.
        if i_useSessionAlign
            color alignBg = sessionPrimaryBull ? color.new(#003d1a, 0) : (sessionPrimaryBear ? color.new(#3d0000, 0) : color.new(#331a00, 0))
            color alignClr = sessionPrimaryBull ? #00E676 : (sessionPrimaryBear ? #FF1744 : #FF9800)
            string alignIcon = sessionPrimaryBull ? "🟢" : (sessionPrimaryBear ? "🔴" : (sessionDivergent ? "⚠️" : "⚪"))
            string alignTxt = alignIcon + " " + sessionDecision + " " + str.tostring(alignmentScore, "#.0") + "/100" + " | CurReg:" + (curRegReturn >= 0 ? "+" : "") + str.tostring(curRegReturn, "#.00") + "% " + str.tostring(curRegProbUp, "#.0") + "%↑ | NxtReg:" + (nextRegReturn >= 0 ? "+" : "") + str.tostring(nextRegReturn, "#.00") + "% " + str.tostring(nextRegProbUp, "#.0") + "%↑ | Pre:" + (secondaryBullCount + secondaryBearCount == 0 ? "~" : (alignPreDir > 0 ? "↑" : (alignPreDir < 0 ? "↓" : "~"))) + " Post:" + (alignPostDir > 0 ? "↑" : (alignPostDir < 0 ? "↓" : "~")) + " Ovn:" + (alignOvnDir > 0 ? "↑" : (alignOvnDir < 0 ? "↓" : "~"))
            f_dashCell(dash, r, "🎯ALIGN", alignTxt, color.white, alignClr, alignBg, szTiny)
            r += 1

        // Context rows
        if i_showORB
            string orbTxt = ""
            color orbClr = tW
            if showRealizedOrb
                orbTxt := "$" + str.tostring(orbLo, "#.02") + "-$" + str.tostring(orbHi, "#.02") + (inOrbWindow ? " 🟡" : " 🟢")
                orbClr := inOrbWindow ? #FFD600 : #00E5FF
            else
                orbTxt := "$" + str.tostring(expOrbLo, "#.02") + "-$" + str.tostring(expOrbHi, "#.02") + " 🔮"
                orbClr := #FFD600
            f_dashCell(dash, r, "ORB" + i_orbLen, orbTxt, tG, orbClr, bgAlt2, szTiny)
            r += 1

        // Next Timeframe Range (session-aware)
        string tfLabel = f_tfLabel()
        bool isMktClosed = isHolidayToday or f_getSessionIST(timenow) == "CLOSED"
        if isMktClosed
            bool ovnIsUp = pxOvn >= safeAnchor
            string ovnIcon = ovnIsUp ? "📈" : "📉"
            color ovnClr = ovnIsUp ? #00E676 : #FF1744
            string ovnDirText = ovnIsUp ? "UP" : "DN"
            float ovn15mLo = math.max(0.01, pxOvn - atr * 0.5)
            float ovn15mHi = pxOvn + atr * 0.5
            f_dashCell(dash, r, "Nxt" + tfLabel, ovnIcon + " $" + str.tostring(pxOvn, "#.02") + " [$" + str.tostring(ovn15mLo, "#.01") + "-" + str.tostring(ovn15mHi, "#.01") + "]", tG, ovnClr, bgAlt2, szTiny)
        else
            string nextDir = normBias >= 0.15 ? "📈" : (normBias <= -0.15 ? "📉" : "↔")
            color nextClr = normBias >= 0.15 ? #00E676 : (normBias <= -0.15 ? #FF1744 : #9E9E9E)
            f_dashCell(dash, r, "Nxt" + tfLabel, nextDir + " $" + str.tostring(nextTfLo, "#.02") + "-$" + str.tostring(nextTfHi, "#.02"), tG, nextClr, bgAlt2, szTiny)
        r += 1

        // ─── Chronological Session Forecast Rows (PreMkt -> RegMkt -> PostMkt -> Overnight -> Next Day) ───
        // Consolidated into f_renderSessionOutlookRows (defined just above §12) — was ~100 lines of
        // main-body table-building code, one of the largest contributors to the "main body too long" error.
        r := f_renderSessionOutlookRows(dash, r, bgAlt1, bgAlt2, szTiny, isHolidayToday)

        // ═══ Session-Aware Forecast Engine (IST → US Market) ═══
        // Sessions: Market 7PM-1:30AM | Post-Mkt 1:30AM-5:30AM | Overnight 5:30AM-1:30PM | Pre-Mkt 1:30PM-7PM IST
        // Weekend: Sat 5:30AM IST → Mon 5:30AM IST = CLOSED

        int thirtyMinMs = 1800000
        int fortyFiveMinMs = 2700000
        int oneHrMs = 3600000
        int t0H = timenow            // actual wall-clock time (not bar time)
        int t30m = timenow + thirtyMinMs
        int t45m = timenow + fortyFiveMinMs
        int t1H = timenow + 1 * oneHrMs
        int t2H = timenow + 2 * oneHrMs
        int t3H = timenow + 3 * oneHrMs
        int t4H = timenow + 4 * oneHrMs
        int t5H = timenow + 5 * oneHrMs
        int t6H = timenow + 6 * oneHrMs

        // Detect sessions for current bar and each forecast hour
        // Fix: Always use IST-based wall-clock session (not exchange session flags)
        string s0 = f_getSessionIST(t0H)
        string s30m = f_getSessionIST(t30m)
        string s45m = f_getSessionIST(t45m)
        string s1 = f_getSessionIST(t1H)
        string s2 = f_getSessionIST(t2H)
        string s3 = f_getSessionIST(t3H)
        string s4 = f_getSessionIST(t4H)
        string s5 = f_getSessionIST(t5H)
        string s6 = f_getSessionIST(t6H)

        // Time labels
        string tl0 = f_fmt12h(t0H)
        string tl30m = f_fmt12h(t30m), string tl45m = f_fmt12h(t45m)
        string tl1 = f_fmt12h(t1H), string tl2 = f_fmt12h(t2H), string tl3 = f_fmt12h(t3H)
        string tl4 = f_fmt12h(t4H), string tl5 = f_fmt12h(t5H), string tl6 = f_fmt12h(t6H)

        // Weekend detection
        int nowDow = dayofweek(t0H, "Asia/Kolkata")
        int liveMins = hour(t0H, "Asia/Kolkata") * 60 + minute(t0H, "Asia/Kolkata")
        bool isWeekend = s0 == "CLOSED" or isHolidayToday

        // ── Row 16: CURRENT SESSION STATUS ──
        string sessStatusTxt = ""
        color  sessBg = color.new(#0a0a16, 0)
        color  sessTxtClr = #9E9E9E
        if isWeekend
            // P1: isHolidayToday can make isWeekend true on an ordinary WEEKDAY holiday, where "Nxt:Mon
            // 5:30AM" would be wrong (the next session isn't necessarily Monday) — the weekend-specific
            // "Nxt:Mon" text below only applies when it's a genuine Sat/Sun closure, not a holiday closure.
            // Holiday-aware next-session date rolling isn't implemented (see i_holidayDates' tooltip).
            sessStatusTxt := isHolidayToday and s0 != "CLOSED" ? "CLOSED (Holiday)" : "CLOSED | Nxt:Mon 5:30AM"
            sessBg  := color.new(#3d0000, 0)
            sessTxtClr := #FF1744
        else
            string sessNow = s0
            string nextSess = ""
            string nextTime = ""
            if sessNow == "MARKET"
                nextSess := "Post"
                nextTime := "1:30 AM"
            else if sessNow == "POST-MKT"
                nextSess := "Ovn"
                nextTime := "5:30 AM"
            else if sessNow == "OVERNIGHT"
                nextSess := "Pre"
                nextTime := "1:30 PM"
            else if sessNow == "PRE-MKT"
                nextSess := "Market"
                nextTime := "7:00 PM"
            else
                nextSess := "Ovn"
                nextTime := "Mon 5:30 AM"
            sessStatusTxt := f_sessIcon(sessNow) + " " + sessNow + " (" + tl0 + ") Nxt:" + nextSess
            sessBg  := color.new(f_sessClr(sessNow), 80)
            sessTxtClr := f_sessClr(sessNow)
        f_dashCell(dash, r, "SESS", sessStatusTxt, color.white, sessTxtClr, sessBg, size.tiny)
        r += 1

        if isWeekend
            // Calculate next Monday targetStart (Anchored to 5:30 AM IST Overnight Session Start)
            int y = year(timenow, "Asia/Kolkata")
            int m = month(timenow, "Asia/Kolkata")
            int d = dayofmonth(timenow, "Asia/Kolkata")
            int midnightToday = timestamp("Asia/Kolkata", y, m, d, 0, 0, 0)
            int daysToMonday = nowDow == dayofweek.sunday ? 1 : nowDow == dayofweek.saturday ? 2 : (nowDow == dayofweek.monday and liveMins < 330) ? 0 : (9 - nowDow) % 7
            int targetStart = midnightToday + daysToMonday * 86400000 + 19800000

            int t30m_we = targetStart + thirtyMinMs
            int t45m_we = targetStart + fortyFiveMinMs
            int t1H_we = targetStart + 1 * oneHrMs
            int t2H_we = targetStart + 2 * oneHrMs
            int t3H_we = targetStart + 3 * oneHrMs
            int t4H_we = targetStart + 4 * oneHrMs
            int t5H_we = targetStart + 5 * oneHrMs
            int t6H_we = targetStart + 6 * oneHrMs

            string s30m_we = f_getSessionIST(t30m_we)
            string s45m_we = f_getSessionIST(t45m_we)
            string s1_we = f_getSessionIST(t1H_we)
            string s2_we = f_getSessionIST(t2H_we)
            string s3_we = f_getSessionIST(t3H_we)
            string s4_we = f_getSessionIST(t4H_we)
            string s5_we = f_getSessionIST(t5H_we)
            string s6_we = f_getSessionIST(t6H_we)

            string tl30m_we = f_fmt12h(t30m_we)
            string tl45m_we = f_fmt12h(t45m_we)
            string tl1_we = f_fmt12h(t1H_we)
            string tl2_we = f_fmt12h(t2H_we)
            string tl3_we = f_fmt12h(t3H_we)
            string tl4_we = f_fmt12h(t4H_we)
            string tl5_we = f_fmt12h(t5H_we)
            string tl6_we = f_fmt12h(t6H_we)

            r := f_renderForecastBlock(dash, r, s30m_we, s45m_we, s1_we, s2_we, s3_we, s4_we, s5_we, s6_we, spx_30m, spx_45m, spx_1H, spx_2H, spx_3H, spx_4H, spx_5H, spx_6H, P0, bgAlt1, bgAlt2, szSmall, szTiny, "Mon ", tl30m_we, tl45m_we, tl1_we, tl2_we, tl3_we, tl4_we, tl5_we, tl6_we)
        else
            r := f_renderForecastBlock(dash, r, s30m, s45m, s1, s2, s3, s4, s5, s6, spx_30m, spx_45m, spx_1H, spx_2H, spx_3H, spx_4H, spx_5H, spx_6H, P0, bgAlt1, bgAlt2, szSmall, szTiny, "", tl30m, tl45m, tl1, tl2, tl3, tl4, tl5, tl6)


// ════════════════════════════════════════════════════════════════════════
