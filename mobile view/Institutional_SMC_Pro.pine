i_symIndex  = input.symbol("ICE:ICESEMIT", "Primary Benchmark Index (ICESEMIT)", group=grp2, tooltip="NYSE Semiconductor Index (ICE:ICESEMIT or INDEX:ICESEMIT). Primary driver for SOXL 3x daily leverage calculation. Automatically falls back to SMH/SOXX if unavailable.")
i_sym1      = input.symbol("MU",   "1. Symbol",           group=grp2)
i_w1        = input.float(8.55,    "   Weight %",         group=grp2)
i_sym2      = input.symbol("AMD",  "2. Symbol",           group=grp2)
i_w2        = input.float(8.10,    "   Weight %",         group=grp2)
i_sym3      = input.symbol("NVDA", "3. Symbol",           group=grp2)
i_w3        = input.float(6.82,    "   Weight %",         group=grp2)
i_sym4      = input.symbol("INTC", "4. Symbol",           group=grp2)
i_w4        = input.float(6.34,    "   Weight %",         group=grp2)
i_sym5      = input.symbol("AVGO", "5. Symbol",           group=grp2)
i_w5        = input.float(6.08,    "   Weight %",         group=grp2)
i_sym6      = input.symbol("AMAT", "6. Symbol",           group=grp2)
i_w6        = input.float(5.78,    "   Weight %",         group=grp2)
i_sym7      = input.symbol("KLAC", "7. Symbol",           group=grp2)
i_w7        = input.float(5.65,    "   Weight %",         group=grp2)
i_sym8      = input.symbol("MRVL", "8. Symbol",           group=grp2)
