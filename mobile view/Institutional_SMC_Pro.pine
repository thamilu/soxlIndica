//@version=6
indicator(
     title            = "Institutional Smart Money & Adaptive Liquidity Model v4.0",
     shorttitle       = "SMC Pro v4",
     overlay          = true,
     max_bars_back    = 500,
     max_lines_count  = 500,
     max_labels_count = 500,
     max_boxes_count  = 200
     )

// ════════════════════════════════════════════════════════════════════════
// §1  INPUTS & CONFIGURATION
// ════════════════════════════════════════════════════════════════════════

// ─── Display Mode ───
grp0 = "⓪ Display & Experience"
i_displayMode = input.string("Expert", "Display Mode", group=grp0,
     options=["Beginner", "Intermediate", "Expert"],
     tooltip="Beginner: Clean chart — only actionable info.\nIntermediate: Adds key SMC levels.\nExpert: Full institutional analysis.")
i_showDash    = input.bool(true, "Show Dashboard HUD", group=grp0)
i_dashPos     = input.string("Top Right", "Dashboard Position", group=grp0,
     options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right",
              "Bottom Left","Bottom Center","Bottom Right"])
i_dashSize    = input.string("Tiny", "Dashboard Size", group=grp0,
     options=["Tiny", "Small", "Normal", "Large"])
i_dashExpand  = input.bool(true, "Expand Dashboard (Show All Rows)", group=grp0,
     tooltip="When OFF, only shows core action rows. When ON, shows all expert rows and hourly forecast.")
i_mobileView  = input.bool(false, "Mobile Friendly View", group=grp0,
     tooltip="When ON, renders every dashboard row (same content as desktop, including Expand Dashboard's full session/hourly forecast detail) at a narrower two-column width with left-aligned text, so it fits a phone screen without the table running off the edge.")
i_maxLabels   = input.int(40, "Max Chart Labels", group=grp0, minval=10, maxval=100)
i_chartMode   = input.string("Research", "Chart Layout Mode", group=grp0,
     options=["Minimal", "Trader", "Research"],
     tooltip="Minimal: Shows only entry, stop, targets.\nTrader: Adds Order Blocks and FVGs.\nResearch: Full diagnostics including volume profiles and historical pivot structures.")
i_rollWin     = input.int(20, "Rolling Evaluation Window", group=grp0, minval=10, maxval=200, step=10,
     tooltip="Size of the walk-forward evaluation window for signal performance mapping.")

// ─── Market Structure ───
grp1 = "① Market Structure & Multi-Timeframe"
i_swingLen = input.int(5, "Swing Lookback", group=grp1, minval=2, maxval=20)
i_htf1     = input.timeframe("1D",  "HTF 1 (Daily)",  group=grp1)
i_htf2     = input.timeframe("240", "HTF 2 (4H)",     group=grp1)
i_htf3     = input.timeframe("60",  "HTF 3 (1H)",     group=grp1)

// ─── SOXL Top Holdings Basket ───
